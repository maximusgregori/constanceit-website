---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Starfield from '../components/Starfield.astro';
import '../styles/global.css';

const { title, description } = Astro.props;

const fullTitle = title ? `${title} — Constance IT` : 'Constance IT — AI-First IT Services for SMBs';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{fullTitle}</title>
    <meta name="description" content={description}>

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL}>

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle}>
    <meta property="og:description" content={description}>
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/Website Favicon White.png">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&family=Space+Grotesk:wght@500;700&family=DM+Sans:wght@400;500&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet">
</head>
<body>
    <Starfield />
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content">
        <slot />
    </main>
    <Footer />
    <script src="../scripts/main.js"></script>
</body>
</html>

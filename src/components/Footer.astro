---
const currentYear = new Date().getFullYear();

const serviceLinks = [
  { label: 'AI & Automation', href: '/services/ai-workflow-automation/' },
  { label: 'Managed IT', href: '/services/managed-it/' },
  { label: 'Infrastructure', href: '/services/it-infrastructure/' },
];

const industryLinks = [
  { label: 'Healthcare', href: '/industries/healthcare/' },
  { label: 'Real Estate', href: '/industries/real-estate/' },
  { label: 'E-Commerce', href: '/industries/ecommerce/' },
  { label: 'Professional Services', href: '/industries/professional-services/' },
];

const companyLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Contact', href: '/contact/' },
];
---

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Brand Column -->
      <div class="footer-brand">
        <a href="/" class="site-logo" aria-label="Constance IT — Home">
          <img src="/images/logo-white.png" alt="Constance IT" width="140" height="28">
        </a>
        <p class="footer-tagline">AI-first IT services for small and medium businesses. One point of contact. Consistent results.</p>
      </div>

      <!-- Services Column -->
      <div class="footer-nav-group">
        <h4>Services</h4>
        <ul>
          {serviceLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Industries Column -->
      <div class="footer-nav-group">
        <h4>Industries</h4>
        <ul>
          {industryLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>
      </div>

      <!-- Company & Contact Column -->
      <div class="footer-nav-group">
        <h4>Company</h4>
        <ul>
          {companyLinks.map(link => (
            <li><a href={link.href}>{link.label}</a></li>
          ))}
        </ul>

        <div class="footer-contact" style="margin-top: var(--space-lg);">
          <h4>Contact</h4>
          <ul style="margin-top: var(--space-md);">
            <li class="footer-contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
              <a href="tel:+17373161313">(737) 316-1313</a>
            </li>
            <li class="footer-contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
              <a href="mailto:max@constanceit.com">max@constanceit.com</a>
            </li>
            <li class="footer-contact-item">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              Austin, Texas
            </li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>&copy; {currentYear} Constance IT, LLC. All rights reserved.</p>
    </div>
  </div>
</footer>

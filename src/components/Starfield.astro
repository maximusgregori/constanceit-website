---
/**
 * Starfield Constellation Canvas
 * Fixed position, full viewport, z-index -1.
 * Constellation groups: rigid units of 2–4 dots + lines that drift together.
 * Solo dots for additional density.
 * Respects prefers-reduced-motion (static render, no animation).
 */
---

<canvas id="starfield-canvas" aria-hidden="true"></canvas>

<style>
  #starfield-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -1;
    pointer-events: none;
  }
</style>

<script>
  (function () {
    'use strict';

    const canvas = document.getElementById('starfield-canvas');
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile = window.innerWidth < 768;

    // --- Configuration ---
    const GROUP_COUNT = isMobile ? 10 : 20;
    const SOLO_DOT_COUNT = isMobile ? 15 : 25;
    const MIN_DOTS_PER_GROUP = 2;
    const MAX_DOTS_PER_GROUP = 4;
    const MIN_SPEED = 0.05;
    const MAX_SPEED = 0.2;
    const DOT_MIN_RADIUS = 0.8;
    const DOT_MAX_RADIUS = 1.8;
    const DOT_MIN_OPACITY = 0.25;
    const DOT_MAX_OPACITY = 0.55;
    const LINE_OPACITY = 0.09;
    const LINE_WIDTH = 0.5;
    const GROUP_SPREAD = 80; // max px offset of dots within a group

    // Accent colors for twinkling
    const ACCENT_COLORS = [
      '#3793FF', // blue
      '#B5B2FF', // violet
      '#4ADE80', // emerald
      '#FF6B6B', // coral
      '#F59E0B', // amber
    ];
    const TWINKLE_INTERVAL_MIN = 2000; // ms
    const TWINKLE_INTERVAL_MAX = 4000; // ms
    const TWINKLE_FADE_DURATION = 1000; // ms

    let width, height;
    let constellationGroups = [];
    let soloDots = [];
    let animationId = null;

    // Twinkle state
    let twinkleTarget = null; // { type: 'group'|'solo', groupIdx, dotIdx, color, startTime, fadeStart }
    let nextTwinkleTime = 0;

    // --- Helpers ---
    function rand(min, max) {
      return Math.random() * (max - min) + min;
    }

    function randInt(min, max) {
      return Math.floor(rand(min, max + 1));
    }

    // --- Resize handler ---
    function resize() {
      const dpr = window.devicePixelRatio || 1;
      width = window.innerWidth;
      height = window.innerHeight;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      canvas.style.width = width + 'px';
      canvas.style.height = height + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    // --- Create constellation groups ---
    function createGroups() {
      constellationGroups = [];
      for (let i = 0; i < GROUP_COUNT; i++) {
        const dotCount = randInt(MIN_DOTS_PER_GROUP, MAX_DOTS_PER_GROUP);
        const dots = [];
        for (let d = 0; d < dotCount; d++) {
          dots.push({
            offsetX: rand(-GROUP_SPREAD, GROUP_SPREAD),
            offsetY: rand(-GROUP_SPREAD, GROUP_SPREAD),
            radius: rand(DOT_MIN_RADIUS, DOT_MAX_RADIUS),
            opacity: rand(DOT_MIN_OPACITY, DOT_MAX_OPACITY),
          });
        }

        // Build line connections between sequential dots + one extra random connection
        const lines = [];
        for (let l = 0; l < dotCount - 1; l++) {
          lines.push([l, l + 1]);
        }
        // Close the loop if 3+ dots, for a more constellation-like shape
        if (dotCount >= 3) {
          lines.push([dotCount - 1, 0]);
        }

        constellationGroups.push({
          x: rand(0, width),
          y: rand(0, height),
          dx: rand(-MAX_SPEED, MAX_SPEED) || MIN_SPEED,
          dy: rand(-MAX_SPEED, MAX_SPEED) || MIN_SPEED,
          dots: dots,
          lines: lines,
        });
      }
    }

    // --- Create solo dots ---
    function createSoloDots() {
      soloDots = [];
      for (let i = 0; i < SOLO_DOT_COUNT; i++) {
        soloDots.push({
          x: rand(0, width),
          y: rand(0, height),
          dx: rand(-MAX_SPEED, MAX_SPEED) || MIN_SPEED,
          dy: rand(-MAX_SPEED, MAX_SPEED) || MIN_SPEED,
          radius: rand(DOT_MIN_RADIUS, DOT_MAX_RADIUS),
          opacity: rand(DOT_MIN_OPACITY, DOT_MAX_OPACITY),
        });
      }
    }

    // --- Wrap around screen edges with buffer ---
    function wrap(val, max, buffer) {
      if (val < -buffer) return max + buffer;
      if (val > max + buffer) return -buffer;
      return val;
    }

    // --- Update positions ---
    function update() {
      const buffer = GROUP_SPREAD + 10;

      for (let i = 0; i < constellationGroups.length; i++) {
        const g = constellationGroups[i];
        g.x += g.dx;
        g.y += g.dy;
        g.x = wrap(g.x, width, buffer);
        g.y = wrap(g.y, height, buffer);
      }

      for (let i = 0; i < soloDots.length; i++) {
        const d = soloDots[i];
        d.x += d.dx;
        d.y += d.dy;
        d.x = wrap(d.x, width, 5);
        d.y = wrap(d.y, height, 5);
      }
    }

    // --- Twinkle helpers ---
    function pickTwinkleTarget(now) {
      // Randomly pick a solo dot or a group dot
      var allDots = [];
      for (var i = 0; i < soloDots.length; i++) {
        allDots.push({ type: 'solo', idx: i });
      }
      for (var gi = 0; gi < constellationGroups.length; gi++) {
        for (var di = 0; di < constellationGroups[gi].dots.length; di++) {
          allDots.push({ type: 'group', groupIdx: gi, dotIdx: di });
        }
      }
      var pick = allDots[Math.floor(Math.random() * allDots.length)];
      var color = ACCENT_COLORS[Math.floor(Math.random() * ACCENT_COLORS.length)];
      twinkleTarget = {
        type: pick.type,
        idx: pick.idx,
        groupIdx: pick.groupIdx,
        dotIdx: pick.dotIdx,
        color: color,
        startTime: now,
        fadeStart: now + 200, // brief bright phase, then fade back
      };
      nextTwinkleTime = now + rand(TWINKLE_INTERVAL_MIN, TWINKLE_INTERVAL_MAX);
    }

    function getTwinkleColor(now) {
      if (!twinkleTarget) return null;
      var elapsed = now - twinkleTarget.fadeStart;
      if (elapsed < 0) {
        // In bright phase
        return { color: twinkleTarget.color, alpha: 0.9, radius: 2.5 };
      }
      var progress = elapsed / TWINKLE_FADE_DURATION;
      if (progress >= 1) {
        twinkleTarget = null;
        return null;
      }
      var alpha = 0.9 * (1 - progress);
      var radiusBoost = 2.5 - 0.7 * progress;
      return { color: twinkleTarget.color, alpha: alpha, radius: radiusBoost };
    }

    // --- Draw ---
    function draw(now) {
      ctx.clearRect(0, 0, width, height);

      // Update twinkle state
      if (!prefersReducedMotion && now) {
        if (!twinkleTarget && now >= nextTwinkleTime) {
          pickTwinkleTarget(now);
        }
      }
      var twinkle = now ? getTwinkleColor(now) : null;

      // Draw constellation groups
      for (var i = 0; i < constellationGroups.length; i++) {
        var g = constellationGroups[i];

        // Draw lines
        ctx.strokeStyle = 'rgba(255, 255, 255, ' + LINE_OPACITY + ')';
        ctx.lineWidth = LINE_WIDTH;
        for (var l = 0; l < g.lines.length; l++) {
          var a = g.dots[g.lines[l][0]];
          var b = g.dots[g.lines[l][1]];
          ctx.beginPath();
          ctx.moveTo(g.x + a.offsetX, g.y + a.offsetY);
          ctx.lineTo(g.x + b.offsetX, g.y + b.offsetY);
          ctx.stroke();
        }

        // Draw dots
        for (var d = 0; d < g.dots.length; d++) {
          var dot = g.dots[d];
          var isTwinkling = twinkle && twinkleTarget && twinkleTarget.type === 'group' && twinkleTarget.groupIdx === i && twinkleTarget.dotIdx === d;
          var dx = g.x + dot.offsetX;
          var dy = g.y + dot.offsetY;

          if (isTwinkling) {
            // Draw glow
            ctx.beginPath();
            ctx.arc(dx, dy, twinkle.radius * 2.5, 0, Math.PI * 2);
            ctx.fillStyle = twinkle.color.replace(')', ', ' + twinkle.alpha * 0.3 + ')').replace('rgb', 'rgba').replace('#', '');
            // Use hex to rgba conversion
            ctx.fillStyle = hexToRgba(twinkle.color, twinkle.alpha * 0.3);
            ctx.fill();
            // Draw bright dot
            ctx.beginPath();
            ctx.arc(dx, dy, twinkle.radius, 0, Math.PI * 2);
            ctx.fillStyle = hexToRgba(twinkle.color, twinkle.alpha);
            ctx.fill();
          } else {
            ctx.beginPath();
            ctx.arc(dx, dy, dot.radius, 0, Math.PI * 2);
            ctx.fillStyle = 'rgba(255, 255, 255, ' + dot.opacity + ')';
            ctx.fill();
          }
        }
      }

      // Draw solo dots
      for (var i = 0; i < soloDots.length; i++) {
        var sd = soloDots[i];
        var isTwinkling = twinkle && twinkleTarget && twinkleTarget.type === 'solo' && twinkleTarget.idx === i;

        if (isTwinkling) {
          // Draw glow
          ctx.beginPath();
          ctx.arc(sd.x, sd.y, twinkle.radius * 2.5, 0, Math.PI * 2);
          ctx.fillStyle = hexToRgba(twinkle.color, twinkle.alpha * 0.3);
          ctx.fill();
          // Draw bright dot
          ctx.beginPath();
          ctx.arc(sd.x, sd.y, twinkle.radius, 0, Math.PI * 2);
          ctx.fillStyle = hexToRgba(twinkle.color, twinkle.alpha);
          ctx.fill();
        } else {
          ctx.beginPath();
          ctx.arc(sd.x, sd.y, sd.radius, 0, Math.PI * 2);
          ctx.fillStyle = 'rgba(255, 255, 255, ' + sd.opacity + ')';
          ctx.fill();
        }
      }
    }

    // --- Hex to rgba helper ---
    function hexToRgba(hex, alpha) {
      var r = parseInt(hex.slice(1, 3), 16);
      var g = parseInt(hex.slice(3, 5), 16);
      var b = parseInt(hex.slice(5, 7), 16);
      return 'rgba(' + r + ', ' + g + ', ' + b + ', ' + alpha + ')';
    }

    // --- Animation loop ---
    function animate(now) {
      update();
      draw(now);
      animationId = requestAnimationFrame(animate);
    }

    // --- Initialize ---
    function init() {
      resize();
      createGroups();
      createSoloDots();
      nextTwinkleTime = performance.now() + rand(TWINKLE_INTERVAL_MIN, TWINKLE_INTERVAL_MAX);

      if (prefersReducedMotion) {
        // Static render — draw once, no animation, no twinkling
        draw(0);
      } else {
        animate(performance.now());
      }
    }

    // --- Handle resize (debounced) ---
    let resizeTimeout;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(function () {
        resize();
        // Recreate if viewport changed significantly
        createGroups();
        createSoloDots();
        if (prefersReducedMotion) {
          draw();
        }
      }, 250);
    });

    // --- Start ---
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

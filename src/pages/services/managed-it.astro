---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Managed IT Services" description="Outsourced IT support you can trust. Helpdesk, monitoring, security, backup, cloud management. One point of contact. Proactive support.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet-main"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">Your IT department. Without the <span class="accent-violet glow-heavy-violet">overhead.</span></h1>
        <p class="hero__subtitle">Monitoring, help desk, security, and maintenance from a team that knows your business. One point of contact, proactive support, no runaround.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#services" class="btn btn--ghost">What's Included &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section mit-problem">
    <div class="container">
      <div class="mit-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Too many vendors. Too many <span class="accent-coral glow-medium-coral">phone trees.</span></h2>
        <p class="text-large text-secondary">When something breaks, you call someone — and they blame someone else.</p>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">VENDOR CHAOS</span>
          <p class="card__text">Internet provider, email provider, cloud hosting, antivirus vendor, backup vendor. You're stuck in the middle waiting for answers.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">OVERWHELMED IT</span>
          <p class="card__text">One IT person putting out fires. No time to plan ahead. When they leave, you lose everything.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">INVISIBLE THREATS</span>
          <p class="card__text">Patches not applied. Backups not tested. Threats not caught. You're hoping nothing breaks.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">NO ACCOUNTABILITY</span>
          <p class="card__text">Different technician every call. No one knows your setup. You start from scratch each time.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: Proactive vs. Reactive
       ════════════════════════════════════════ -->
  <section class="section mit-compare">
    <div class="container">
      <div class="mit-compare__header animate-on-scroll">
        <SectionBadge text="OUR APPROACH" variant="info" />
        <h2><span class="accent-violet glow-medium-violet">Proactive,</span> not reactive.<br class="heading-break" /> There's a difference.</h2>
      </div>

      <!-- Column Headers (desktop only) -->
      <div class="mit-compare__col-headers">
        <span class="mit-compare__col-label accent-coral glow-medium-coral">REACTIVE IT</span>
        <span class="mit-compare__col-label accent-emerald glow-medium-emerald">PROACTIVE IT</span>
      </div>

      <div class="mit-compare__rows stagger-children">
        <!-- Row 1: Detection -->
        <div class="mit-compare__row">
          <div class="card card--problem mit-compare__card">
            <span class="card__category accent-coral glow-medium-coral mit-compare__mobile-label">REACTIVE IT</span>
            <p class="card__text">Something breaks. Your team notices. They call IT. Downtime costs money.</p>
          </div>
          <div class="card card--solution mit-compare__card">
            <span class="card__category accent-emerald glow-medium-emerald mit-compare__mobile-label">PROACTIVE IT</span>
            <p class="card__text">We catch issues before they impact you. Your team barely knows we're there.</p>
          </div>
        </div>

        <!-- Row 2: Maintenance -->
        <div class="mit-compare__row">
          <div class="card card--problem mit-compare__card">
            <span class="card__category accent-coral glow-medium-coral mit-compare__mobile-label">REACTIVE IT</span>
            <p class="card__text">Patches applied when someone remembers. Vulnerabilities sit open for weeks.</p>
          </div>
          <div class="card card--solution mit-compare__card">
            <span class="card__category accent-emerald glow-medium-emerald mit-compare__mobile-label">PROACTIVE IT</span>
            <p class="card__text">Patches applied automatically on your schedule. Systems stay current without effort.</p>
          </div>
        </div>

        <!-- Row 3: Outcome -->
        <div class="mit-compare__row">
          <div class="card card--problem mit-compare__card">
            <span class="card__category accent-coral glow-medium-coral mit-compare__mobile-label">REACTIVE IT</span>
            <p class="card__text">Always playing catch-up. Nothing improves because you never get ahead.</p>
          </div>
          <div class="card card--solution mit-compare__card">
            <span class="card__category accent-emerald glow-medium-emerald mit-compare__mobile-label">PROACTIVE IT</span>
            <p class="card__text">Problems are rare. When they happen, we fix them fast. Your team focuses on growth.</p>
          </div>
        </div>
      </div>

      <!-- Stat -->
      <div class="mit-compare__stat animate-on-scroll">
        <span class="stat-number stat-number--violet">60–80%</span>
        <span class="mit-compare__stat-label">Downtime reduction with proactive IT</span>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What's Included
       ════════════════════════════════════════ -->
  <section class="section" id="services">
    <div class="container">
      <div class="mit-services__header animate-on-scroll">
        <SectionBadge text="SERVICES" variant="info" />
        <h2>Full-stack IT support. All in <span class="accent-violet glow-medium-violet">one place.</span></h2>
      </div>

      <div class="mit-services__grid stagger-children">
        <!-- Card 1: Helpdesk -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-5Zm0 0a9 9 0 1 1 18 0m0 0v5a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3Z"/><path d="M21 16v2a4 4 0 0 1-4 4h-5"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">HELPDESK</span>
          <h3 class="card__title">Helpdesk & User Support</h3>
          <p class="card__text">One point of contact for every issue. We own the problem until it's resolved. No transfers, no ticket black holes.</p>
        </div>

        <!-- Card 2: Monitoring -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">MONITORING</span>
          <h3 class="card__title">Continuous Monitoring & Alerts</h3>
          <p class="card__text">Around-the-clock monitoring for threats and system health. Endpoint protection and patch management handled proactively.</p>
        </div>

        <!-- Card 3: Patching -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="M12 8v4"/><path d="M12 16h.01"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">PATCHING</span>
          <h3 class="card__title">Patch Management</h3>
          <p class="card__text">Security patches applied automatically on your schedule. Your systems stay current without your team doing the legwork.</p>
        </div>

        <!-- Card 4: Cloud -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">CLOUD</span>
          <h3 class="card__title">Cloud & Infrastructure Support</h3>
          <p class="card__text">Microsoft 365, Google Workspace, AWS, Azure. We handle provisioning, configuration, and troubleshooting.</p>
        </div>

        <!-- Card 5: Security -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">SECURITY</span>
          <h3 class="card__title">Cybersecurity & Compliance</h3>
          <p class="card__text">Endpoint protection, firewalls, threat detection, and security training. Compliance handled for regulated industries.</p>
        </div>

        <!-- Card 6: Backup -->
        <div class="card card--service-it">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">BACKUP</span>
          <h3 class="card__title">Backup & Disaster Recovery</h3>
          <p class="card__text">Continuous backups with tested recovery plans. Ransomware, hardware failure, human error — covered.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How We Work
       ════════════════════════════════════════ -->
  <section class="section mit-process">
    <div class="container">
      <div class="mit-process__header animate-on-scroll">
        <SectionBadge text="THE PROCESS" variant="info" />
        <h2>Simple. <span class="accent-violet glow-medium-violet">Predictable.</span><br class="heading-break" /> You know what to expect.</h2>
      </div>

      <div class="mit-timeline stagger-children">
        <div class="mit-timeline__step">
          <div class="mit-timeline__node">
            <span class="mit-timeline__number accent-violet glow-medium-violet">01</span>
          </div>
          <div class="card mit-timeline__card">
            <h3 class="card__title">Assessment</h3>
            <p class="card__text">We understand your systems, what's critical, and what's broken. We ask about your goals — growth, compliance, security, cost control.</p>
          </div>
        </div>

        <div class="mit-timeline__step">
          <div class="mit-timeline__node">
            <span class="mit-timeline__number accent-violet glow-medium-violet">02</span>
          </div>
          <div class="card mit-timeline__card">
            <h3 class="card__title">Plan & Quote</h3>
            <p class="card__text">We propose a fixed-price plan. Monitoring, support, updates, security. You know what you pay and what you get.</p>
          </div>
        </div>

        <div class="mit-timeline__step">
          <div class="mit-timeline__node">
            <span class="mit-timeline__number accent-violet glow-medium-violet">03</span>
          </div>
          <div class="card mit-timeline__card">
            <h3 class="card__title">Onboarding</h3>
            <p class="card__text">We set up monitoring, deploy security, configure your infrastructure. Your team gets trained. Live in 1–2 weeks.</p>
          </div>
        </div>

        <div class="mit-timeline__step">
          <div class="mit-timeline__node">
            <span class="mit-timeline__number accent-violet glow-medium-violet">04</span>
          </div>
          <div class="card mit-timeline__card">
            <h3 class="card__title">Ongoing Support</h3>
            <p class="card__text">One point of contact. You call or email. We own it. Monthly reviews, quarterly strategy calls.</p>
          </div>
        </div>
      </div>

      <p class="mit-process__note accent-violet glow-medium-violet animate-on-scroll">One person. One number. Same answer every time.</p>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Who It's For
       ════════════════════════════════════════ -->
  <section class="section mit-who">
    <div class="container">
      <div class="mit-who__header animate-on-scroll">
        <SectionBadge text="RIGHT FOR" variant="info" />
        <h2>IT you can <span class="accent-violet glow-medium-violet">count on.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--feature mit-who__card">
          <span class="card__category accent-violet glow-medium-violet">GROWING COMPANIES</span>
          <p class="card__text">Too big for DIY IT. Too small for a full department. Managed IT costs less than hiring an IT director — with enterprise-grade support.</p>
        </div>
        <div class="card card--feature mit-who__card">
          <span class="card__category accent-violet glow-medium-violet">NO IT PERSON</span>
          <p class="card__text">You've been limping along with contractors or no plan. We replace that role — lower cost, more consistent, less risk.</p>
        </div>
        <div class="card card--feature mit-who__card">
          <span class="card__category accent-violet glow-medium-violet">ONE IT PERSON</span>
          <p class="card__text">Your IT person is overwhelmed and putting out fires. We handle routine work. They focus on strategy.</p>
        </div>
        <div class="card card--feature mit-who__card">
          <span class="card__category accent-violet glow-medium-violet">COMPLIANCE-HEAVY</span>
          <p class="card__text">HIPAA, SOX, GDPR requirements. We handle compliance documentation and monitoring. Audits are clean.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Pricing
       ════════════════════════════════════════ -->
  <section class="section mit-pricing">
    <div class="container">
      <div class="mit-pricing__inner animate-on-scroll">
        <SectionBadge text="PRICING" variant="info" />
        <h2>Transparent pricing. No <span class="accent-violet glow-medium-violet">surprises.</span></h2>
        <p class="text-large text-secondary">Plans typically run $500–2,000/month depending on size, complexity, and service level. Helpdesk, monitoring, patching, cloud management, and basic security included.</p>
        <a href="/contact/" class="btn btn--ghost" style="margin-top: var(--space-lg);">Get in Touch for a Quote &rarr;</a>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: FAQ
       ════════════════════════════════════════ -->
  <section class="section mit-faq">
    <div class="container">
      <div class="mit-faq__header animate-on-scroll">
        <SectionBadge text="FAQ" variant="info" />
        <h2>Questions about <span class="accent-violet glow-medium-violet">managed IT?</span></h2>
      </div>

      <div class="faq-list animate-on-scroll">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Will this replace our IT person?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Depends. If you have someone, we augment them — they do strategy, we handle routine. If you don't, we replace that role entirely.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do I have to sign a long-term contract?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">No. Month-to-month agreements. If we're not delivering, you're not stuck.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What's included vs. extra?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Helpdesk, monitoring, patching, cloud management, basic security, and backup are standard. Infrastructure projects quoted separately.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How quickly do you respond?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Critical issues get immediate attention. Routine requests acknowledged within the hour.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do we own our data?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Yes. It's yours. We help you transfer it if you leave. No lock-in.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How do you handle security?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Endpoint protection, firewalls, threat monitoring, and user training. Advanced security is an add-on.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 9: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section mit-cta" id="contact-form">
    <div class="mit-cta__glow"></div>
    <div class="container">
      <div class="mit-cta__inner animate-on-scroll">
        <h2 class="mit-cta__headline">Let's talk about your <span class="accent-violet glow-medium-violet">IT.</span></h2>
        <p class="mit-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="managed-it" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Managed IT — Scoped Styles (Phase 8b)
     ────────────────────────────────────── */

  /* Accent text utilities */
  .accent-violet { color: var(--accent-violet); }
  .accent-coral { color: var(--accent-coral); }
  .accent-emerald { color: var(--accent-emerald); }
  .accent-blue { color: var(--accent-blue); }
  .accent-amber { color: var(--accent-amber); }

  /* Hero ambient glows */
  .hero__glow--violet-main {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: The Problem ── */
  .mit-problem__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .mit-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 3: Proactive vs. Reactive ── */
  .mit-compare__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .mit-compare__header h2 {
    margin-top: var(--space-md);
  }

  .mit-compare__col-headers {
    display: none;
  }

  .mit-compare__col-label {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .mit-compare__rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .mit-compare__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .mit-compare__card {
    padding: var(--space-lg);
  }

  .mit-compare__mobile-label {
    display: block;
  }

  .mit-compare__stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding: var(--space-xl) var(--space-lg);
    text-align: center;
  }

  .mit-compare__stat-label {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* ── Section 4: What's Included ── */
  .mit-services__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .mit-services__header h2 {
    margin-top: var(--space-md);
  }

  .mit-services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .mit-services__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }


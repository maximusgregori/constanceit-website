---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout title="IT Infrastructure Buildouts" description="Cabling, network design, office buildouts, hardware deployment. Physical IT work done right by Cisco-certified technicians. Texas-wide infrastructure services for SMBs.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">IT Infrastructure</span>
        <h1 class="hero__title">We show up and build it right.</h1>
        <p class="hero__subtitle">When you're building a new office, upgrading your network, or setting up infrastructure from scratch — you need people who show up, do the work, and get it done. We handle cabling, hardware deployment, server setup, network design, and office buildouts. Physical IT work done the right way, the first time.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Request a Quote</a>
          <a href="#services" class="btn btn--ghost">What We Build</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="infra-problem animate-on-scroll">
        <span class="section-label">The Problem</span>
        <h2>Bad infrastructure compounds over time.</h2>
        <p class="text-large">Cut corners on infrastructure now. You pay 10x more fixing it later. Bad cabling, poor design, messy installs create technical debt that takes months to untangle.</p>
        <p class="text-large">Do it right the first time — plan it, spec it, install it carefully. It takes expertise and attention to detail. It pays for itself in avoided downtime, easier upgrades, and a productive team.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: What We Build
       ════════════════════════════════════════ -->
  <section class="section" id="services">
    <div class="container">
      <div class="infra-services__header animate-on-scroll">
        <span class="section-label">Services</span>
        <h2>Physical IT work done right.</h2>
      </div>

      <div class="infra-services__grid stagger-children">
        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2H4Z"/><path d="M14 9a2 2 0 0 0 2-2V5a2 2 0 0 0-2-2"/><path d="M4 15a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2"/><path d="M4 21a2 2 0 0 1-2-2v-2a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2"/><path d="M14 21a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2"/></svg>
          </div>
          <h3 class="card__title">Structured Cabling & Cable Management</h3>
          <p class="card__text">Cat6/Cat6a runs, proper labeling, clean management throughout your space. Built to last and easy to maintain when change is needed.</p>
        </div>

        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
          </div>
          <h3 class="card__title">Network Closet & Server Room Setup</h3>
          <p class="card__text">Rack installation, cable management, switch and firewall mounting, and power configuration. Built clean from the start so future maintenance is straightforward.</p>
        </div>

        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <h3 class="card__title">New Office Buildouts</h3>
          <p class="card__text">From cabling and network hardware to workstations, phones, and access control. Your new office is IT-ready on opening day.</p>
        </div>

        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="10" x="4" y="2" rx="2"/><path d="M2 12h20"/><rect width="16" height="10" x="4" y="12" rx="2"/></svg>
          </div>
          <h3 class="card__title">Hardware Procurement & Deployment</h3>
          <p class="card__text">We spec and deploy workstations, servers, switches, and access points. Setup, configuration, and user onboarding included. Your team gets equipment that works on day one.</p>
        </div>

        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg>
          </div>
          <h3 class="card__title">Network Design & Implementation</h3>
          <p class="card__text">Managed switches with redundancy. Wireless access points placed for coverage. Firewalls configured for security. Your network is fast, reliable, and secure.</p>
        </div>

        <div class="card infra-service-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          </div>
          <h3 class="card__title">Low-Voltage Wiring & Infrastructure</h3>
          <p class="card__text">Power management, grounding, HVAC integration, cable routing, and backup power. Infrastructure built to last.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: How We Work
       ════════════════════════════════════════ -->
  <section class="section section--alt infra-process">
    <div class="container">
      <div class="infra-process__header animate-on-scroll">
        <span class="section-label">The Process</span>
        <h2>Plan it. Spec it. Build it. Document it.</h2>
      </div>

      <div class="timeline animate-on-scroll" style="margin-top: var(--space-xl);">
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Step 01</span>
          <h3 class="timeline__step-title">Assessment & Planning</h3>
          <p class="timeline__step-text">We assess your space, needs, and growth plans. We create a detailed plan: network design, cabling routes, equipment list, timeline, cost. You approve before we buy anything.</p>
        </div>
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Step 02</span>
          <h3 class="timeline__step-title">Procurement & Staging</h3>
          <p class="timeline__step-text">We source and test equipment. We pre-configure what we can. This reduces on-site time and minimizes your downtime.</p>
        </div>
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Step 03</span>
          <h3 class="timeline__step-title">Installation & Build</h3>
          <p class="timeline__step-text">We show up with a crew and build it. Cabling run, hardware mounted, configurations deployed, testing done. Hands-on work done fast and right.</p>
        </div>
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Step 04</span>
          <h3 class="timeline__step-title">Documentation & Handoff</h3>
          <p class="timeline__step-text">Complete documentation: network diagrams, hardware lists, configurations, warranty info, maintenance schedules. Your team knows exactly what you have and how it works.</p>
        </div>
      </div>

      <p class="infra-process__note animate-on-scroll"><strong>Timeline:</strong> Typically 2-8 weeks depending on scope.</p>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Why Do It Right
       ════════════════════════════════════════ -->
  <section class="section infra-why">
    <div class="container">
      <div class="infra-why__header animate-on-scroll">
        <span class="section-label">Why It Matters</span>
        <h2>Bad infrastructure is expensive. Good infrastructure is an investment.</h2>
      </div>

      <div class="grid grid--2 stagger-children" style="margin-top: var(--space-xl);">
        <div class="card infra-why__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </div>
          <h3 class="card__title">Future-Proof</h3>
          <p class="card__text">Properly designed infrastructure scales with growth. Upgrades are easy. No ripping and replacing every 18 months.</p>
        </div>

        <div class="card infra-why__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="card__title">Fewer Outages</h3>
          <p class="card__text">Redundancy and reliability built in. Outages are rare. Your team stays productive.</p>
        </div>

        <div class="card infra-why__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="card__title">Easier Maintenance</h3>
          <p class="card__text">Labeled, organized, documented cabling means fast maintenance. A mess means everything takes 3x longer and costs 3x more.</p>
        </div>

        <div class="card infra-why__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <h3 class="card__title">Lower Total Cost of Ownership</h3>
          <p class="card__text">Upfront cost is higher when done right. Over 5 years, it's cheaper because you avoid emergency fixes and downtime.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Project Examples
       ════════════════════════════════════════ -->
  <section class="section section--alt bg-dots infra-examples">
    <div class="container">
      <div class="infra-examples__header animate-on-scroll">
        <span class="section-label">Recent Work</span>
        <h2>Examples of infrastructure we've built.</h2>
      </div>

      <div class="infra-examples__list stagger-children">
        <div class="infra-example">
          <div class="infra-example__header">
            <span class="infra-example__number">01</span>
            <h3 class="infra-example__title">New Office Buildout</h3>
          </div>
          <div class="infra-example__body">
            <p class="infra-example__situation"><strong>Situation:</strong> Texas-based marketing firm opening a second office with 25 employees.</p>
            <p class="infra-example__work"><strong>What We Did:</strong> Designed network topology. Installed Cat6a cabling throughout. Built network closet with managed switches and PoE for phones and access points. Set up 25 workstations, phones, printers. Deployed WiFi access points for coverage.</p>
            <p class="infra-example__result">Office was IT-ready on opening day. Zero network issues in first 6 months.</p>
          </div>
        </div>

        <div class="infra-example">
          <div class="infra-example__header">
            <span class="infra-example__number">02</span>
            <h3 class="infra-example__title">Server Room Upgrade</h3>
          </div>
          <div class="infra-example__body">
            <p class="infra-example__situation"><strong>Situation:</strong> Professional services firm had aging server room with poor cable management and cooling issues.</p>
            <p class="infra-example__work"><strong>What We Did:</strong> Designed new layout. Installed proper racking, power distribution, cooling. Ran new cabling for redundancy. Migrated services with zero downtime.</p>
            <p class="infra-example__result">Servers run cooler, future upgrades are easier, documentation is clear.</p>
          </div>
        </div>

        <div class="infra-example">
          <div class="infra-example__header">
            <span class="infra-example__number">03</span>
            <h3 class="infra-example__title">Network Redesign</h3>
          </div>
          <div class="infra-example__body">
            <p class="infra-example__situation"><strong>Situation:</strong> Real estate company had slow WiFi, connectivity issues, and security gaps.</p>
            <p class="infra-example__work"><strong>What We Did:</strong> Designed new network with proper segmentation. Replaced aging switches with managed equipment. Added access points for coverage. Deployed firewall and endpoint protection.</p>
            <p class="infra-example__result">Network is fast and reliable. Security is enterprise-grade. Staff productivity improved.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: Team & Service Area
       ════════════════════════════════════════ -->
  <section class="section infra-team">
    <div class="container">
      <div class="split infra-team__layout">
        <div class="infra-team__content animate-on-scroll">
          <span class="section-label">Our Team</span>
          <h2>Certified technicians. Hands-on work. Across Texas.</h2>
          <p class="text-large">Our infrastructure team is made up of Cisco-certified technicians with hands-on experience across every type of environment — small offices, medical facilities, warehouses, retail spaces, and multi-story commercial buildings. They've run cable through drop ceilings and concrete walls alike.</p>
          <p class="text-large text-secondary">When you hire us, you're getting experienced professionals on your premises doing the physical work. Not subcontractors we found last week.</p>
        </div>
        <div class="infra-team__area animate-on-scroll">
          <div class="infra-team__area-card">
            <span class="infra-team__area-badge">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              Service Area
            </span>
            <h3>Austin HQ, Texas-wide service.</h3>
            <p>Dallas, Houston, San Antonio, and everywhere in between — we travel to you. Infrastructure is on-site work. We don't do it remotely. We show up, we build it, and we make sure it works before we leave.</p>
          </div>
          <div class="infra-team__cert-badge">
            <span class="text-mono">Cisco Certified</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 8: Equipment & Standards
       ════════════════════════════════════════ -->
  <section class="section section--alt infra-specs">
    <div class="container">
      <div class="infra-specs__inner animate-on-scroll">
        <span class="section-label">What We Spec</span>
        <h2>Enterprise-grade equipment. Real standards.</h2>
        <p class="text-large text-secondary">We don't use consumer-grade hardware for business infrastructure. We spec:</p>

        <ul class="infra-specs__list">
          <li><strong>Cabling:</strong> Cat6a or higher, properly rated and tested</li>
          <li><strong>Network Equipment:</strong> Managed switches, enterprise firewalls, professional-grade access points</li>
          <li><strong>Servers:</strong> Industry-standard builds with redundancy and backup power</li>
          <li><strong>Workstations:</strong> Quality hardware with proper warranties and support</li>
        </ul>

        <p class="text-large text-secondary">We follow industry standards: TIA/EIA 568, NFPA 70 (NEC), and Cisco best practices for network design, security, and reliability. Our technicians hold current Cisco certifications and bring that expertise to every project.</p>
        <p class="text-large text-secondary">We don't spec the cheapest option. We spec the right option. The cost is fair, the equipment lasts, and maintenance is straightforward.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 9: FAQ
       ════════════════════════════════════════ -->
  <section class="section infra-faq">
    <div class="container">
      <div class="infra-faq__header animate-on-scroll">
        <h2>Questions about infrastructure projects?</h2>
      </div>

      <div class="faq-list animate-on-scroll">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How long does a typical project take?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">It depends on scope. Small offices (25 people): 2-4 weeks. Network upgrades: 4-8 weeks. Full buildouts: 8+ weeks. We give you a timeline during planning.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if we want to keep using our existing hardware?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We can work with it if it's compatible and meets standards. We'll assess what can stay and what needs upgrading.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do you handle ongoing maintenance?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We build it. Someone maintains it. That's usually a managed IT provider — can be us or another team.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if we need to expand later?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Good design accounts for growth. Adding workstations, cabling, bandwidth — all easy if it's done right the first time. If it's a mess, everything's hard.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do you do emergency repairs on existing infrastructure?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Our focus is building new infrastructure. For emergency repairs, contact our managed IT team.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What's your warranty on work you do?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">1 year on all installation work against defects. Equipment carries manufacturer warranties (3-5 years typically). We document everything.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 10: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Ready to plan your infrastructure project?"
    source="infrastructure"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     IT Infrastructure — scoped styles
     ────────────────────────────────────── */

  /* Problem section */
  .infra-problem {
    max-width: 800px;
    margin-inline: auto;
  }

  .infra-problem h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .infra-problem p {
    color: var(--text-secondary);
  }

  .infra-problem p + p {
    margin-top: var(--space-md);
  }

  /* Services */
  .infra-services__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .infra-services__header h2 {
    margin-top: var(--space-sm);
  }

  .infra-services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .infra-service-card {
    display: flex;
    flex-direction: column;
  }

  /* Process */
  .infra-process__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .infra-process__header h2 {
    margin-top: var(--space-sm);
  }

  .infra-process__note {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent-primary-hover);
    margin-top: var(--space-xl);
    padding-left: var(--space-xl);
  }

  /* Why section */
  .infra-why__header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;

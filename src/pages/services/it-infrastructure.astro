---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="IT Infrastructure Buildouts" description="Cabling, network design, office buildouts, hardware deployment. Physical IT work done right by Cisco-certified technicians. Texas-wide infrastructure services.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--amber"></div>
    <div class="hero__glow hero__glow--violet"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">We show up and <span class="accent-violet glow-heavy-violet">build it right.</span></h1>
        <p class="hero__subtitle">Cabling, hardware deployment, server setup, network design, and office buildouts. Physical IT work done the right way, the first time.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--amber">Request a Quote</a>
          <a href="#services" class="btn btn--ghost">What We Build &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section infra-problem">
    <div class="container">
      <div class="infra-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Bad infrastructure <span class="accent-coral glow-medium-coral">compounds</span> over time.</h2>
        <p class="text-large text-secondary">Cut corners now — pay 10x more fixing it later.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">TECHNICAL DEBT</span>
          <p class="card__text">Bad cabling, poor design, messy installs. It takes months to untangle and costs a fortune.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DOWNTIME</span>
          <p class="card__text">No redundancy means one failure takes the whole office offline. Your team sits idle.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">GROWTH BLOCKED</span>
          <p class="card__text">Can't add workstations, upgrade bandwidth, or expand — because the foundation wasn't built for it.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: What We Build
       ════════════════════════════════════════ -->
  <section class="section" id="services">
    <div class="container">
      <div class="infra-services__header animate-on-scroll">
        <SectionBadge text="SERVICES" variant="feature" />
        <h2>Physical IT work done <span class="accent-blue glow-medium-blue">right.</span></h2>
      </div>

      <div class="infra-services__grid stagger-children">
        <!-- Card 1: Cabling -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a1 1 0 0 1-1-1v-1a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1"/><path d="M19 15V6.5a1 1 0 0 0-7 0v11a1 1 0 0 1-7 0V9"/><path d="M21 21v-2h-4"/><path d="M3 5h4V3"/><path d="M7 5a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">CABLING</span>
          <h3 class="card__title">Structured Cabling & Cable Management</h3>
          <p class="card__text">Cat6/Cat6a runs, proper labeling, clean management. Built to last and easy to maintain.</p>
        </div>

        <!-- Card 2: Server Rooms -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SERVER ROOMS</span>
          <h3 class="card__title">Network Closet & Server Room Setup</h3>
          <p class="card__text">Rack installation, cable management, switch and firewall mounting, power configuration. Clean from the start.</p>
        </div>

        <!-- Card 3: Buildouts -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">BUILDOUTS</span>
          <h3 class="card__title">New Office Buildouts</h3>
          <p class="card__text">From cabling to workstations, phones, and access control. Your new office is IT-ready on opening day.</p>
        </div>

        <!-- Card 4: Hardware -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 16V7a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v9m16 0H4m16 0 1.28 2.55a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45L4 16"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">HARDWARE</span>
          <h3 class="card__title">Hardware Procurement & Deployment</h3>
          <p class="card__text">We spec and deploy workstations, servers, switches, and access points. Setup, configuration, and onboarding included.</p>
        </div>

        <!-- Card 5: Network -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" x2="12.01" y1="20" y2="20"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">NETWORK</span>
          <h3 class="card__title">Network Design & Implementation</h3>
          <p class="card__text">Managed switches with redundancy. Access points placed for coverage. Firewalls configured for security.</p>
        </div>

        <!-- Card 6: Low-Voltage -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LOW-VOLTAGE</span>
          <h3 class="card__title">Low-Voltage Wiring & Infrastructure</h3>
          <p class="card__text">Power management, grounding, HVAC integration, cable routing, and backup power. Built to last.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: How We Work
       ════════════════════════════════════════ -->
  <section class="section infra-process">
    <div class="container">
      <div class="infra-process__header animate-on-scroll">
        <SectionBadge text="THE PROCESS" variant="solution" />
        <h2>Plan it. Spec it. Build it. <span class="accent-emerald glow-medium-emerald">Document it.</span></h2>
      </div>

      <div class="infra-timeline stagger-children">
        <div class="infra-timeline__step">
          <div class="infra-timeline__node">
            <span class="infra-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution infra-timeline__card">
            <h3 class="card__title">Assessment & Planning</h3>
            <p class="card__text">We assess your space, needs, and growth plans. Detailed plan with network design, cabling routes, equipment list, timeline, and cost.</p>
            <span class="infra-timeline__badge">1–2 weeks</span>
          </div>
        </div>

        <div class="infra-timeline__step">
          <div class="infra-timeline__node">
            <span class="infra-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution infra-timeline__card">
            <h3 class="card__title">Procurement & Staging</h3>
            <p class="card__text">We source and test equipment. Pre-configure what we can. This reduces on-site time and minimizes your downtime.</p>
            <span class="infra-timeline__badge">1–2 weeks</span>
          </div>
        </div>

        <div class="infra-timeline__step">
          <div class="infra-timeline__node">
            <span class="infra-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution infra-timeline__card">
            <h3 class="card__title">Installation & Build</h3>
            <p class="card__text">We show up with a crew and build it. Cabling run, hardware mounted, configurations deployed, testing done.</p>
            <span class="infra-timeline__badge">1–4 weeks</span>
          </div>
        </div>

        <div class="infra-timeline__step">
          <div class="infra-timeline__node">
            <span class="infra-timeline__number accent-emerald glow-medium-emerald">04</span>
          </div>
          <div class="card card--solution infra-timeline__card">
            <h3 class="card__title">Documentation & Handoff</h3>
            <p class="card__text">Network diagrams, hardware lists, configurations, warranty info, maintenance schedules. Your team knows exactly what you have.</p>
            <span class="infra-timeline__badge">Final week</span>
          </div>
        </div>
      </div>

      <p class="infra-process__note accent-emerald glow-medium-emerald animate-on-scroll">Typically 2–8 weeks depending on scope.</p>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: Why Do It Right
       ════════════════════════════════════════ -->
  <section class="section infra-why">
    <div class="container">
      <div class="infra-why__header animate-on-scroll">
        <SectionBadge text="WHY IT MATTERS" variant="info" />
        <h2>Good infrastructure is an <span class="accent-violet glow-medium-violet">investment.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--feature infra-why__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">FUTURE-PROOF</span>
          <h3 class="card__title">Scales With Growth</h3>
          <p class="card__text">Properly designed infrastructure scales with growth. Upgrades are easy. No ripping and replacing every 18 months.</p>
        </div>

        <div class="card card--feature infra-why__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">FEWER OUTAGES</span>
          <h3 class="card__title">Built-In Reliability</h3>
          <p class="card__text">Redundancy and reliability built in. Outages are rare. Your team stays productive.</p>
        </div>

        <div class="card card--feature infra-why__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">EASIER MAINTENANCE</span>
          <h3 class="card__title">Clean & Documented</h3>
          <p class="card__text">Labeled, organized, documented cabling means fast maintenance. A mess means everything takes 3x longer.</p>
        </div>

        <div class="card card--feature infra-why__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LOWER TCO</span>
          <h3 class="card__title">Saves Money Long-Term</h3>
          <p class="card__text">Higher upfront cost. Over 5 years, cheaper — because you avoid emergency fixes, downtime, and rip-and-replace.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Project Examples
       ════════════════════════════════════════ -->
  <section class="section infra-examples">
    <div class="container">
      <div class="infra-examples__header animate-on-scroll">
        <SectionBadge text="RECENT WORK" variant="info" />
        <h2>Infrastructure we've <span class="accent-violet glow-medium-violet">built.</span></h2>
      </div>

      <div class="infra-examples__grid stagger-children">
        <!-- Project 1: New Office Buildout -->
        <div class="card infra-project-card">
          <span class="card__category accent-violet glow-medium-violet">NEW OFFICE BUILDOUT</span>
          <p class="infra-project__client text-secondary">Texas-based marketing firm, 25 employees</p>
          <p class="card__text">Network topology design. Cat6a cabling throughout. Network closet with managed switches and PoE. 25 workstations, phones, printers. WiFi access points.</p>
          <div class="infra-project__metric">
            <span class="stat-number stat-number--emerald infra-project__stat">0 network issues</span>
            <span class="infra-project__metric-label">first 6 months</span>
          </div>
          <p class="infra-project__result">Office was IT-ready on opening day.</p>
        </div>

        <!-- Project 2: Server Room Upgrade -->
        <div class="card infra-project-card">
          <span class="card__category accent-violet glow-medium-violet">SERVER ROOM UPGRADE</span>
          <p class="infra-project__client text-secondary">Professional services firm</p>
          <p class="card__text">New layout design. Proper racking, power distribution, cooling. New cabling for redundancy. Zero-downtime migration.</p>
          <div class="infra-project__metric">
            <span class="stat-number stat-number--emerald infra-project__stat">0 downtime</span>
            <span class="infra-project__metric-label">during migration</span>
          </div>
          <p class="infra-project__result">Servers run cooler. Future upgrades are straightforward.</p>
        </div>

        <!-- Project 3: Network Redesign -->
        <div class="card infra-project-card">
          <span class="card__category accent-violet glow-medium-violet">NETWORK REDESIGN</span>
          <p class="infra-project__client text-secondary">Real estate company</p>
          <p class="card__text">Network segmentation. Managed switches. Access points for full coverage. Firewall and endpoint protection.</p>
          <div class="infra-project__metric">
            <span class="stat-number stat-number--emerald infra-project__stat">Enterprise-grade</span>
            <span class="infra-project__metric-label">security and speed</span>
          </div>
          <p class="infra-project__result">Fast, reliable network. Staff productivity improved immediately.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Our Team & Service Area
       ════════════════════════════════════════ -->
  <section class="section infra-team">
    <div class="container">
      <div class="infra-team__header animate-on-scroll">
        <SectionBadge text="OUR TEAM" variant="info" />
        <h2>Cisco-certified technicians. Across <span class="accent-violet glow-medium-violet">Texas.</span></h2>
      </div>

      <div class="infra-team__split stagger-children">
        <div class="card card--feature infra-team__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <h3 class="card__title">Experienced Professionals</h3>
          <p class="card__text">Our infrastructure team is Cisco-certified with hands-on experience in every environment — offices, medical facilities, warehouses, retail, multi-story commercial. When you hire us, you get experienced professionals on your premises. Not subcontractors we found last week.</p>
          <span class="infra-team__cert accent-blue glow-subtle-blue">Cisco Certified</span>
        </div>

        <div class="card card--feature infra-team__card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
          </div>
          <h3 class="card__title">Austin HQ, Texas-Wide Service</h3>
          <p class="card__text">Headquartered in Austin. We serve businesses across Texas — Dallas, Houston, San Antonio, and everywhere in between. Infrastructure is on-site work. We show up, build it, and make sure it works before we leave.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: Equipment & Standards
       ════════════════════════════════════════ -->
  <section class="section infra-specs">
    <div class="container">
      <div class="infra-specs__header animate-on-scroll">
        <SectionBadge text="WHAT WE SPEC" variant="feature" />
        <h2>Enterprise-grade equipment. Real <span class="accent-blue glow-medium-blue">standards.</span></h2>
        <p class="text-large text-secondary">We don't use consumer-grade hardware for business infrastructure.</p>
      </div>

      <div class="grid grid--2 infra-specs__grid stagger-children">
        <div class="card infra-spec-card">
          <span class="card__category accent-blue glow-medium-blue">CABLING</span>
          <p class="card__text">Cat6a or higher, properly rated and tested.</p>
        </div>
        <div class="card infra-spec-card">
          <span class="card__category accent-blue glow-medium-blue">NETWORK</span>
          <p class="card__text">Managed switches, enterprise firewalls, professional-grade access points.</p>
        </div>
        <div class="card infra-spec-card">
          <span class="card__category accent-blue glow-medium-blue">SERVERS</span>
          <p class="card__text">Industry-standard builds with redundancy and backup power.</p>
        </div>
        <div class="card infra-spec-card">
          <span class="card__category accent-blue glow-medium-blue">STANDARDS</span>
          <p class="card__text">TIA/EIA 568, NFPA 70 (NEC), Cisco best practices for design, security, and reliability.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 9: FAQ
       ════════════════════════════════════════ -->
  <section class="section infra-faq">
    <div class="container">
      <div class="infra-faq__header animate-on-scroll">
        <SectionBadge text="FAQ" variant="feature" />
        <h2>Questions about <span class="accent-blue glow-medium-blue">infrastructure?</span></h2>
      </div>

      <div class="faq-list animate-on-scroll">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How long does a typical project take?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Small offices (25 people): 2–4 weeks. Network upgrades: 4–8 weeks. Full buildouts: 8+ weeks. We give a timeline during planning.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Can we keep our existing hardware?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">If it's compatible and meets standards, yes. We assess what stays and what needs upgrading.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do you handle ongoing maintenance?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We build it. Maintenance is usually a managed IT provider — can be us or another team.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if we need to expand later?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Good design accounts for growth. Adding workstations and bandwidth is easy if the foundation is right.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">

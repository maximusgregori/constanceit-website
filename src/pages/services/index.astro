---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Services" description="AI workflow automation, managed IT services, and IT infrastructure. We identify what's costing you time, implement solutions, and support them ongoing.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet-left"></div>
    <div class="hero__glow hero__glow--blue-right"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">One team. Three services. <span class="accent-blue glow-heavy-blue">Everything</span> your business needs.</h1>
        <p class="hero__subtitle">Automate manual work. Outsource your IT support. Build infrastructure from the ground up. Identify where you're stuck, automate what slows you down, support what keeps you running.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get in Touch &rarr;</a>
          <a href="#services" class="btn btn--ghost">Explore Our Services &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Three Services
       ════════════════════════════════════════ -->
  <section class="section" id="services">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="OUR SERVICES" variant="feature" />
        <h2>Three services. One <span class="accent-blue glow-medium-blue">philosophy.</span></h2>
      </div>

      <div class="svc-three-cards stagger-children">
        <!-- AI & Workflow Automation -->
        <div class="card card--service-ai svc-service-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2 .74 2.22a2 2 0 0 0 1.04 1.04L17 6l-2.22.74a2 2 0 0 0-1.04 1.04L13 10l-.74-2.22a2 2 0 0 0-1.04-1.04L9 6l2.22-.74A2 2 0 0 0 12.26 4.22z"/><path d="M5 3v4"/><path d="M3 5h4"/><path d="m18 13 .74 2.22a2 2 0 0 0 1.04 1.04L22 17l-2.22.74a2 2 0 0 0-1.04 1.04L18 21l-.74-2.22a2 2 0 0 0-1.04-1.04L14 17l2.22-.74a2 2 0 0 0 1.04-1.04z"/><path d="M9 13 7.74 17.22a2 2 0 0 1-1.04 1.04L4.5 19"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">AI & WORKFLOW AUTOMATION</span>
          <p class="card__text">We build AI agents that handle repetitive work: scheduling, follow-ups, document processing, data entry. In 90 days, you'll have what used to take 2–3 extra employees.</p>
          <div class="svc-card-stat">
            <span class="svc-card-stat__value accent-blue glow-medium-blue">90 days</span>
            <span class="svc-card-stat__label">to measurable results</span>
          </div>
          <a href="/services/ai-workflow-automation/" class="card__link">
            Learn About Automation
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Managed IT -->
        <div class="card card--service-it svc-service-card">
          <div class="card__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <span class="card__category accent-violet glow-medium-violet">MANAGED IT</span>
          <p class="card__text">One person who knows your systems and your business. Helpdesk, monitoring, security, backup, cloud infrastructure. Proactive support that prevents problems.</p>
          <div class="svc-card-stat">
            <span class="svc-card-stat__value accent-violet glow-medium-violet">60–80%</span>
            <span class="svc-card-stat__label">downtime reduction</span>
          </div>
          <a href="/services/managed-it/" class="card__link">
            Learn About Managed IT
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- IT Infrastructure -->
        <div class="card card--service-infra svc-service-card">
          <div class="card__icon icon-glow-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
          </div>
          <span class="card__category accent-amber glow-medium-amber">IT INFRASTRUCTURE</span>
          <p class="card__text">Cabling, network design, hardware deployment, server room setup, and office buildouts. Physical IT work that's planned, executed, and documented.</p>
          <div class="svc-card-stat">
            <span class="svc-card-stat__value accent-amber glow-medium-amber">Texas-wide</span>
            <span class="svc-card-stat__label">Cisco-certified</span>
          </div>
          <a href="/services/it-infrastructure/" class="card__link">
            Learn About Infrastructure
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: How We Work — Identify → Automate → Support
       ════════════════════════════════════════ -->
  <section class="section svc-model">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="OUR MODEL" variant="feature" />
        <h2>One approach.<br class="heading-break" /> Applied to <span class="accent-blue glow-medium-blue">everything</span> we do.</h2>
        <p class="text-large text-secondary">Identify the real costs. Automate what you can. Support it ongoing.</p>
      </div>

      <div class="svc-phases stagger-children">
        <!-- Phase 1: Identify -->
        <div class="svc-phase">
          <div class="svc-phase__node svc-phase__node--blue">
            <span class="svc-phase__number accent-blue glow-medium-blue">01</span>
          </div>
          <div class="card card--feature svc-phase__card">
            <h3 class="card__title">Identify</h3>
            <p class="card__text">We audit your workflows, interview your team, and map manual processes. We find where time and money leak.</p>
          </div>
        </div>

        <!-- Connector -->
        <div class="svc-phase__connector" aria-hidden="true"></div>

        <!-- Phase 2: Automate -->
        <div class="svc-phase">
          <div class="svc-phase__node svc-phase__node--blue">
            <span class="svc-phase__number accent-blue glow-medium-blue">02</span>
          </div>
          <div class="card card--feature svc-phase__card">
            <h3 class="card__title">Automate (or Build)</h3>
            <p class="card__text">We build AI agents, deploy infrastructure, or install systems. We do the work and make sure it works before handoff.</p>
          </div>
        </div>

        <!-- Connector -->
        <div class="svc-phase__connector" aria-hidden="true"></div>

        <!-- Phase 3: Support -->
        <div class="svc-phase">
          <div class="svc-phase__node svc-phase__node--blue">
            <span class="svc-phase__number accent-blue glow-medium-blue">03</span>
          </div>
          <div class="card card--feature svc-phase__card">
            <h3 class="card__title">Support</h3>
            <p class="card__text">We monitor, adjust, and optimize. We stay engaged so your solutions keep working as your business grows.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: Service Comparison
       ════════════════════════════════════════ -->
  <section class="section svc-compare">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="QUICK COMPARISON" variant="feature" />
        <h2>Which service is <span class="accent-blue glow-medium-blue">right</span> for you?</h2>
      </div>

      <div class="svc-compare__cards stagger-children">
        <!-- AI Automation -->
        <div class="card card--service-ai svc-compare__card">
          <div class="svc-compare__card-header svc-compare__card-header--blue">
            <span class="svc-compare__card-title accent-blue glow-medium-blue">AI Automation</span>
          </div>
          <div class="svc-compare__rows">
            <div class="svc-compare__row">
              <span class="svc-compare__label">BEST FOR</span>
              <span class="svc-compare__value">Repetitive manual work, process efficiency</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">TIMELINE</span>
              <span class="svc-compare__value">90 days to measurable results</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">PRICING</span>
              <span class="svc-compare__value">Monthly ($200–500+)</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">SUPPORT</span>
              <span class="svc-compare__value">Continuous monitoring & optimization</span>
            </div>
          </div>
          <a href="/services/ai-workflow-automation/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Managed IT -->
        <div class="card card--service-it svc-compare__card">
          <div class="svc-compare__card-header svc-compare__card-header--violet">
            <span class="svc-compare__card-title accent-violet glow-medium-violet">Managed IT</span>
          </div>
          <div class="svc-compare__rows">
            <div class="svc-compare__row">
              <span class="svc-compare__label">BEST FOR</span>
              <span class="svc-compare__value">Ongoing IT support, helpdesk, monitoring</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">TIMELINE</span>
              <span class="svc-compare__value">Ongoing (no end date)</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">PRICING</span>
              <span class="svc-compare__value">Monthly ($500–2,000)</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">SUPPORT</span>
              <span class="svc-compare__value">Proactive 24/7 monitoring + helpdesk</span>
            </div>
          </div>
          <a href="/services/managed-it/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Infrastructure -->
        <div class="card card--service-infra svc-compare__card">
          <div class="svc-compare__card-header svc-compare__card-header--amber">
            <span class="svc-compare__card-title accent-amber glow-medium-amber">Infrastructure</span>
          </div>
          <div class="svc-compare__rows">
            <div class="svc-compare__row">
              <span class="svc-compare__label">BEST FOR</span>
              <span class="svc-compare__value">New builds, upgrades, office buildouts</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">TIMELINE</span>
              <span class="svc-compare__value">2–8 weeks depending on scope</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">PRICING</span>
              <span class="svc-compare__value">Project-based quote</span>
            </div>
            <div class="svc-compare__row">
              <span class="svc-compare__label">SUPPORT</span>
              <span class="svc-compare__value">Post-deployment documentation</span>
            </div>
          </div>
          <a href="/services/it-infrastructure/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: Who We Serve
       ════════════════════════════════════════ -->
  <section class="section svc-industries">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="INDUSTRIES" variant="feature" />
        <h2>We work with growing <span class="accent-blue glow-medium-blue">SMBs</span> across industries.</h2>
        <p class="text-large text-secondary">Our approach works for any SMB with repetitive work, IT needs, or infrastructure projects.</p>
      </div>

      <div class="svc-industry-grid stagger-children">
        <a href="/industries/healthcare/" class="card svc-industry-card">
          <div class="svc-industry-card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M11 2a2 2 0 0 0-2 2v5H4a2 2 0 0 0-2 2v2c0 1.1.9 2 2 2h5v5c0 1.1.9 2 2 2h2a2 2 0 0 0 2-2v-5h5a2 2 0 0 0 2-2v-2a2 2 0 0 0-2-2h-5V4a2 2 0 0 0-2-2h-2z"/></svg>
          </div>
          <div>
            <h3 class="svc-industry-card__title">Healthcare</h3>
            <p class="svc-industry-card__desc">MSOs, ASCs, clinics, and outpatient facilities.</p>
          </div>
          <svg class="svc-industry-card__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>

        <a href="/industries/real-estate/" class="card svc-industry-card">
          <div class="svc-industry-card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>
          </div>
          <div>
            <h3 class="svc-industry-card__title">Real Estate</h3>
            <p class="svc-industry-card__desc">Property management, brokerage, and investment firms.</p>
          </div>
          <svg class="svc-industry-card__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>

        <a href="/industries/ecommerce/" class="card svc-industry-card">
          <div class="svc-industry-card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          </div>
          <div>
            <h3 class="svc-industry-card__title">E-Commerce</h3>
            <p class="svc-industry-card__desc">Online stores, multichannel retail, and DTC brands.</p>
          </div>
          <svg class="svc-industry-card__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>

        <a href="/industries/professional-services/" class="card svc-industry-card">
          <div class="svc-industry-card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div>
            <h3 class="svc-industry-card__title">Professional Services</h3>
            <p class="svc-industry-card__desc">Contractors, trades, legal, and accounting firms.</p>
          </div>
          <svg class="svc-industry-card__arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Why Constance IT
       ════════════════════════════════════════ -->
  <section class="section svc-why">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="WHY US" variant="feature" />
        <h2>Built <span class="accent-blue glow-medium-blue">different.</span> On purpose.</h2>
      </div>

      <!-- Bento-style grid: 2 wide on top, 2 on bottom -->
      <div class="svc-why__bento stagger-children">
        <div class="card svc-why__card">
          <div class="svc-why__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
          </div>
          <h3 class="svc-why__title">One Point of Contact</h3>
          <p class="svc-why__text">One person who knows your business, your team, your history. No queues. No transfers.</p>
        </div>

        <div class="card svc-why__card">
          <div class="svc-why__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
          </div>
          <h3 class="svc-why__title">AI-First, Not AI-Only</h3>
          <p class="svc-why__text">AI is our primary tool. If a simpler solution fits better, we'll tell you.</p>
        </div>

        <div class="card svc-why__card">
          <div class="svc-why__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="svc-why__title">We Implement, Then Stay</h3>
          <p class="svc-why__text">We build, monitor, adjust, and optimize. We don't hand you a deck and disappear.</p>
        </div>

        <div class="card svc-why__card">
          <div class="svc-why__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <h3 class="svc-why__title">Built for SMBs</h3>
          <p class="svc-why__text">Teams of 5–200. Our pricing, process, and communication are designed for companies like yours.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Getting Started
       ════════════════════════════════════════ -->
  <section class="section svc-start">
    <div class="container">
      <div class="svc-section-header animate-on-scroll">
        <SectionBadge text="NEXT STEPS" variant="feature" />
        <h2>Let's figure out what you <span class="accent-blue glow-medium-blue">need.</span></h2>
      </div>

      <div class="svc-steps stagger-children">
        <!-- Step 1 -->
        <div class="svc-step">
          <div class="svc-step__node">
            <span class="svc-step__number accent-blue glow-medium-blue">01</span>
          </div>
          <div class="card card--feature svc-step__card">
            <h3 class="card__title">Talk to Us</h3>
            <p class="card__text">Tell us about your challenge. We'll ask questions and listen.</p>
          </div>
        </div>


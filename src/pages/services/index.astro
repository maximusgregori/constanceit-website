---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout title="Services" description="AI workflow automation, managed IT services, and IT infrastructure. We identify what's costing you time, implement solutions, and support them ongoing.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">Our Services</span>
        <h1 class="hero__title">One team. Three service areas. Everything your business needs.</h1>
        <p class="hero__subtitle">Whether you need to automate manual work, outsource your IT support, or build infrastructure from the ground up — we do it all. Identify where your business is stuck. Automate what slows you down. Support what keeps you running. That's our model.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get in Touch</a>
          <a href="#services" class="btn btn--ghost">Explore Our Services</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: The Three Service Areas
       ════════════════════════════════════════ -->
  <section class="section section--alt" id="services">
    <div class="container">
      <div class="services-header animate-on-scroll">
        <span class="section-label">Our Services</span>
        <h2>Three services. One philosophy: identify the problem, implement the solution, support it ongoing.</h2>
      </div>

      <div class="services-cards stagger-children">
        <!-- AI & Workflow Automation -->
        <div class="card services-card">
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          </div>
          <h3 class="card__title">AI & Workflow Automation</h3>
          <p class="card__text">We build AI agents that handle repetitive work: scheduling, follow-ups, document processing, data entry. In 90 days, you'll have what used to take 2-3 extra employees.</p>
          <div class="services-card__stats">
            <div class="services-card__stat">
              <span class="services-card__stat-value">73%</span>
              <span class="services-card__stat-label">of SMBs saw measurable productivity gains within 90 days</span>
            </div>
            <div class="services-card__stat">
              <span class="services-card__stat-value">$200-500</span>
              <span class="services-card__stat-label">/month in AI automation = 2-3 FTE equivalent</span>
            </div>
          </div>
          <a href="/services/ai-workflow-automation/" class="card__link">
            Learn About Automation
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Managed IT -->
        <div class="card services-card">
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="card__title">Managed IT</h3>
          <p class="card__text">You get one person who knows your systems, your business, and your history. We handle helpdesk, monitoring, security, backup, and cloud infrastructure. Proactive support that prevents problems instead of just fixing them after they break.</p>
          <ul class="services-card__benefits">
            <li>Proactive monitoring reduces downtime by 60-80%</li>
            <li>Fixed pricing, no surprises</li>
            <li>One point of contact (no ticket queues)</li>
          </ul>
          <a href="/services/managed-it/" class="card__link">
            Learn About Managed IT
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- IT Infrastructure -->
        <div class="card services-card">
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
          </div>
          <h3 class="card__title">IT Infrastructure</h3>
          <p class="card__text">We handle cabling, network design, hardware deployment, server room setup, and office buildouts. Physical IT work that's planned, executed, and documented. Infrastructure that scales with your business and lasts.</p>
          <ul class="services-card__benefits">
            <li>Structured cabling and cable management</li>
            <li>Network closets and server room builds</li>
            <li>New office buildouts</li>
            <li>Hardware deployment and configuration</li>
          </ul>
          <a href="/services/it-infrastructure/" class="card__link">
            Learn About Infrastructure
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: How We Work — Identify → Automate → Support
       ════════════════════════════════════════ -->
  <section class="section services-model">
    <div class="container">
      <div class="services-model__header animate-on-scroll">
        <span class="section-label">Our Model</span>
        <h2>One approach. Applied to everything we do.</h2>
        <p class="text-large text-secondary">Identify the real costs. Automate what you can. Support it ongoing.</p>
      </div>

      <div class="grid grid--3 stagger-children" style="margin-top: var(--space-xl);">
        <div class="card services-phase-card">
          <span class="services-phase-card__number">01</span>
          <h3 class="card__title">Identify</h3>
          <p class="card__text">We audit your workflows, interview your team, and map manual processes. We find where time and money leak. We identify quick wins and bigger opportunities.</p>
        </div>
        <div class="card services-phase-card">
          <span class="services-phase-card__number">02</span>
          <h3 class="card__title">Automate (or Build)</h3>
          <p class="card__text">We build AI agents, deploy infrastructure, or install systems. We do the work and make sure it works before we hand it over.</p>
        </div>
        <div class="card services-phase-card">
          <span class="services-phase-card__number">03</span>
          <h3 class="card__title">Support</h3>
          <p class="card__text">Automation and IT aren't "set it and forget it." We monitor, adjust, and optimize. We stay engaged so your solutions keep working as your business grows.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: Who We Serve
       ════════════════════════════════════════ -->
  <section class="section section--alt services-audience">
    <div class="container">
      <div class="services-audience__inner animate-on-scroll">
        <span class="section-label">Right For</span>
        <h2>We work with growing SMBs (5-200 people) across industries.</h2>
        <p class="text-large text-secondary">We work with healthcare, real estate, e-commerce, and professional services. But our approach works for any SMB with repetitive work, IT needs, or infrastructure projects.</p>
        <div class="services-audience__links">
          <a href="/industries/healthcare/" class="link link--arrow">
            Healthcare
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/industries/real-estate/" class="link link--arrow">
            Real Estate
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/industries/ecommerce/" class="link link--arrow">
            E-Commerce
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href="/industries/professional-services/" class="link link--arrow">
            Professional Services
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Why Choose Constance IT
       ════════════════════════════════════════ -->
  <section class="section services-why">
    <div class="container">
      <div class="services-why__header animate-on-scroll">
        <span class="section-label">Why Constance IT</span>
        <h2>Built different. On purpose.</h2>
      </div>

      <div class="services-why__grid stagger-children">
        <div class="services-why__feature">
          <div class="services-why__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
          </div>
          <div>
            <h3 class="services-why__title">One Point of Contact</h3>
            <p class="services-why__text">You'll work with one person who knows your systems, your business, and your history. No call centers. No ticket queues. No starting over with a different person every time.</p>
          </div>
        </div>

        <div class="services-why__feature">
          <div class="services-why__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
          </div>
          <div>
            <h3 class="services-why__title">AI-First, But Not AI-Only</h3>
            <p class="services-why__text">AI is our primary tool, but we use what works. If a simpler solution fits better, we'll tell you. We're not here to sell you AI — we're here to save you time and money.</p>
          </div>
        </div>

        <div class="services-why__feature">
          <div class="services-why__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><line x1="12" x2="12" y1="22" y2="8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/></svg>
          </div>
          <div>
            <h3 class="services-why__title">We Implement, Then Stay</h3>
            <p class="services-why__text">We're not consultants who hand you a deck and disappear. We build the solutions. We monitor them. We adjust and optimize. We stay engaged so your results keep improving.</p>
          </div>
        </div>

        <div class="services-why__feature">
          <div class="services-why__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
          </div>
          <div>
            <h3 class="services-why__title">Built for SMBs</h3>
            <p class="services-why__text">We work with teams of 5-200 people. Our pricing, our process, and our communication are designed for companies like yours — not enterprise committees or large corporations.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Service Comparison
       ════════════════════════════════════════ -->
  <section class="section section--alt services-compare bg-dots">
    <div class="container">
      <div class="services-compare__header animate-on-scroll">
        <span class="section-label">Quick Comparison</span>
        <h2>Which service is right for you?</h2>
      </div>

      <!-- Desktop table -->
      <div class="services-compare__table-wrap animate-on-scroll">
        <table class="services-compare__table">
          <thead>
            <tr>
              <th></th>
              <th>AI Automation</th>
              <th>Managed IT</th>
              <th>Infrastructure</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="services-compare__label">Best For</td>
              <td>Repetitive manual work, process efficiency</td>
              <td>Ongoing IT support, helpdesk, monitoring</td>
              <td>Building new or upgrading existing systems</td>
            </tr>
            <tr>
              <td class="services-compare__label">Timeline</td>
              <td>90 days to measurable results</td>
              <td>Ongoing (no end date)</td>
              <td>2-8 weeks depending on scope</td>
            </tr>
            <tr>
              <td class="services-compare__label">Pricing</td>
              <td>Monthly ($200-500+)</td>
              <td>Monthly ($500-2,000)</td>
              <td>Project-based quote</td>
            </tr>
            <tr>
              <td class="services-compare__label">Support</td>
              <td>Continuous monitoring & optimization</td>
              <td>Proactive 24/7 monitoring + helpdesk</td>
              <td>Post-deployment documentation</td>
            </tr>
            <tr>
              <td class="services-compare__label">Who Should Use</td>
              <td>Sales, admin, document-heavy teams</td>
              <td>Any SMB with IT infrastructure</td>
              <td>Growing companies, new offices, upgrades</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Mobile cards (shown instead of table on small screens) -->
      <div class="services-compare__mobile stagger-children">
        <div class="card services-compare__mobile-card">
          <h3 class="card__title">AI & Workflow Automation</h3>
          <p class="card__text">For teams drowning in repetitive work. Typically takes 90 days and costs $200-500/month.</p>
          <a href="/services/ai-workflow-automation/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="card services-compare__mobile-card">
          <h3 class="card__title">Managed IT</h3>
          <p class="card__text">Your outsourced IT department. Ongoing, covers helpdesk and monitoring, $500-2,000/month depending on complexity.</p>
          <a href="/services/managed-it/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="card services-compare__mobile-card">
          <h3 class="card__title">IT Infrastructure</h3>
          <p class="card__text">For building new, upgrading existing, or opening new locations. Project-based, 2-8 weeks, quoted separately.</p>
          <a href="/services/it-infrastructure/" class="card__link">
            Learn more
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: Getting Started
       ════════════════════════════════════════ -->
  <section class="section services-start">
    <div class="container">
      <div class="services-start__header animate-on-scroll">
        <span class="section-label">Next Steps</span>
        <h2>Let's figure out what you need.</h2>
      </div>

      <div class="grid grid--3 stagger-children" style="margin-top: var(--space-xl);">
        <div class="card services-phase-card">
          <span class="services-phase-card__number">01</span>
          <h3 class="card__title">Talk to Us</h3>
          <p class="card__text">Tell us about your challenge — whether it's repetitive work, IT support gaps, or an infrastructure project. We'll ask questions and listen.</p>
          <a href="/contact/" class="card__link">
            Get in Touch
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="card services-phase-card">
          <span class="services-phase-card__number">02</span>
          <h3 class="card__title">We Audit</h3>
          <p class="card__text">We spend time understanding your situation. For automation, we do a workflow audit. For IT, we assess your setup. For infrastructure, we plan the project.</p>
        </div>
        <div class="card services-phase-card">
          <span class="services-phase-card__number">03</span>
          <h3 class="card__title">We Plan & Quote</h3>
          <p class="card__text">We outline what we can do, how long it takes, and what it costs. No surprises. You decide if it makes sense.</p>
          <a href="/contact/" class="card__link">
            Get in Touch
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 8: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Ready to solve a problem or build something new?"
    source="services"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Services Overview — scoped styles
     ────────────────────────────────────── */

  /* Services header */
  .services-header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .services-header h2 {
    margin-top: var(--space-sm);
  }

  /* Service cards — stacked on mobile, big cards layout on desktop */
  .services-cards {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .services-card {
    display: flex;
    flex-direction: column;
  }

  .services-card .card__text {
    margin-bottom: var(--space-md);
  }

  .services-card__stats {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding: var(--space-md);
    background-color: rgba(26, 118, 188, 0.06);
    border-radius: var(--radius-md);
  }

  .services-card__stat {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    align-items: baseline;
  }

  .services-card__stat-value {
    font-family: var(--font-mono);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--accent-primary-hover);
  }

  .services-card__stat-label {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .services-card__benefits {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
    padding: 0;
  }

  .services-card__benefits li {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    padding-left: var(--space-lg);
    position: relative;
  }

  .services-card__benefits li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--accent-primary);
    opacity: 0.6;
  }

  .services-card .card__link {
    margin-top: auto;
  }

  /* Model section */
  .services-model__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .services-model__header h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .services-model__header p {
    margin-inline: auto;
  }

  /* Phase cards */
  .services-phase-card {
    display: flex;
    flex-direction: column;
  }

  .services-phase-card__number {
    font-family: var(--font-mono);
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent-primary);
    line-height: 1;
    margin-bottom: var(--space-md);
    opacity: 0.3;
  }

  /* Audience section */
  .services-audience__inner {
    text-align: center;
    max-width: 800px;
    margin-inline: auto;
  }

  .services-audience__inner h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .services-audience__inner p {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .services-audience__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md) var(--space-lg);
  }

  /* Why section */
  .services-why__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .services-why__header h2 {
    margin-top: var(--space-sm);
  }

  .services-why__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .services-why__feature {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .services-why__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background-color: rgba(26, 118, 188, 0.1);
    color: var(--accent-primary-hover);
  }

  .services-why__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;

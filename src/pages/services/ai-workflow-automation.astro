---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="AI & Workflow Automation" description="Stop doing repetitive work. We build AI agents that automate scheduling, follow-ups, document processing, and data entry. Measurable results in 90 days.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">Stop doing work your <span class="accent-violet glow-heavy-violet">tools</span> should handle.</h1>
        <p class="hero__subtitle">Your team spends hours every week on manual tasks that are boring, repetitive, and expensive. We build AI agents that handle them — and it keeps working after we're done.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get Your Free Audit</a>
          <a href="#what-we-build" class="btn btn--ghost">What We Automate &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Stats Strip
       ════════════════════════════════════════ -->
  <section class="section ai-stats">
    <div class="container">
      <div class="ai-stats__grid animate-on-scroll">
        <div class="ai-stats__item">
          <span class="stat-number stat-number--violet">90 days</span>
          <span class="ai-stats__label">To measurable results</span>
        </div>
        <div class="ai-stats__item">
          <span class="stat-number stat-number--emerald">10–15 hrs</span>
          <span class="ai-stats__label">Saved per week</span>
        </div>
        <div class="ai-stats__item">
          <span class="stat-number stat-number--blue">$200–500/mo</span>
          <span class="ai-stats__label">Typical investment</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Problem
       ════════════════════════════════════════ -->
  <section class="section ai-problem">
    <div class="container">
      <div class="ai-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Your team is stuck in a loop of <span class="accent-coral glow-medium-coral">repetitive work.</span></h2>
        <p class="text-large text-secondary">You hire smart people to do smart work — then ask them to spend 5–10 hours a week on busywork.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">TIME DRAIN</span>
          <p class="card__text">Scheduling, data entry, follow-ups. The same tasks, every day, by hand.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">FALLING BEHIND</span>
          <p class="card__text">Teams with AI agents are doing the work of teams 25% larger. Most SMBs haven't built this yet.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">EXPERTISE GAP</span>
          <p class="card__text">It takes real expertise to set up and integrate AI agents. That's where we come in.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What We Build
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-build">
    <div class="container">
      <div class="ai-build__header animate-on-scroll">
        <SectionBadge text="WHAT WE BUILD" variant="feature" />
        <h2>AI agents that handle the <span class="accent-blue glow-medium-blue">repetitive work.</span></h2>
      </div>

      <div class="ai-build__grid stagger-children">
        <!-- Card 1: Lead Management -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LEAD MANAGEMENT</span>
          <h3 class="card__title">Lead Capture & Follow-Up Agents</h3>
          <p class="card__text">Leads are logged, categorized, and followed up automatically. Your sales team focuses on closing, not chasing.</p>
        </div>

        <!-- Card 2: Scheduling -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SCHEDULING</span>
          <h3 class="card__title">Appointment Scheduling Agents</h3>
          <p class="card__text">Customers book themselves. The agent handles confirmations, reminders, and rescheduling. Your calendar stays full and accurate.</p>
        </div>

        <!-- Card 3: Documents -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">DOCUMENTS</span>
          <h3 class="card__title">Document & Invoice Processing</h3>
          <p class="card__text">Documents are read, categorized, extracted, and filed automatically. Manual data entry drops to near zero.</p>
        </div>

        <!-- Card 4: Outreach -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">OUTREACH</span>
          <h3 class="card__title">Automated Customer Outreach</h3>
          <p class="card__text">Personalized follow-ups, reminders, and campaigns sent at the right time. Your team writes the templates once. The agent handles the rest.</p>
        </div>

        <!-- Card 5: Reporting -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REPORTING</span>
          <h3 class="card__title">Data Entry & Reporting Automation</h3>
          <p class="card__text">Data flows between systems automatically. Reports compile and send on schedule. Your database stays clean without human effort.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How We Work
       ════════════════════════════════════════ -->
  <section class="section ai-process">
    <div class="container">
      <div class="ai-process__header animate-on-scroll">
        <SectionBadge text="HOW WE WORK" variant="solution" />
        <h2>Phased approach. <span class="accent-emerald glow-medium-emerald">Proven</span> results.</h2>
        <p class="text-large text-secondary">We don't try to automate everything at once. We move fast, but smart.</p>
      </div>

      <div class="ai-timeline stagger-children">
        <div class="ai-timeline__step">
          <div class="ai-timeline__node">
            <span class="ai-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution ai-timeline__card">
            <span class="ai-timeline__badge">1–2 weeks</span>
            <h3 class="card__title">Audit & Design</h3>
            <p class="card__text">We watch your team work and map where time disappears. We identify quick wins and design the workflows.</p>
          </div>
        </div>

        <div class="ai-timeline__step">
          <div class="ai-timeline__node">
            <span class="ai-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution ai-timeline__card">
            <span class="ai-timeline__badge">4–6 weeks</span>
            <h3 class="card__title">Build & Test</h3>
            <p class="card__text">We build agents configured for your tools. We test thoroughly, train your team, and refine based on feedback.</p>
          </div>
        </div>

        <div class="ai-timeline__step">
          <div class="ai-timeline__node">
            <span class="ai-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution ai-timeline__card">
            <span class="ai-timeline__badge">Ongoing</span>
            <h3 class="card__title">Launch & Support</h3>
            <p class="card__text">We launch with monitoring in place. We catch issues before they break. We measure impact and optimize.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: The Technology
       ════════════════════════════════════════ -->
  <section class="section ai-tech">
    <div class="container">
      <div class="ai-tech__header animate-on-scroll">
        <SectionBadge text="TECHNOLOGY" variant="feature" />
        <h2>Built on the latest in <span class="accent-blue glow-medium-blue">agentic AI.</span></h2>
      </div>

      <div class="ai-tech__split animate-on-scroll">
        <div class="ai-tech__text">
          <p class="text-large">Agentic AI doesn't answer questions — it takes actions. Books appointments. Sends emails. Processes documents. Runs continuously and handles edge cases.</p>
        </div>
        <div class="ai-tech__aside">
          <p class="text-large text-secondary">We use proven platforms and AI models configured for your workflows. The important part isn't the technology name — it's the outcome.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Who It's For
       ════════════════════════════════════════ -->
  <section class="section ai-who">
    <div class="container">
      <div class="ai-who__header animate-on-scroll">
        <SectionBadge text="WHO BENEFITS" variant="feature" />
        <h2>If you have repetitive work, you're a <span class="accent-blue glow-medium-blue">fit.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--feature">
          <span class="card__category accent-blue glow-medium-blue">SALES & SERVICE</span>
          <p class="card__text">High volume of leads and follow-ups. 20+ hours/week on admin instead of selling. Agent handles outreach and scheduling — your team sells.</p>
        </div>
        <div class="card card--feature">
          <span class="card__category accent-blue glow-medium-blue">PROFESSIONAL SERVICES</span>
          <p class="card__text">Trades, contractors, agencies. Juggling scheduling, dispatch, invoicing. Agent coordinates everything — owner stops doing admin.</p>
        </div>
        <div class="card card--feature">
          <span class="card__category accent-blue glow-medium-blue">HEALTHCARE</span>
          <p class="card__text">Patient communication, appointment reminders, insurance verification. Agent reduces errors and frees staff for higher-value work.</p>
        </div>
        <div class="card card--feature">
          <span class="card__category accent-blue glow-medium-blue">E-COMMERCE</span>
          <p class="card__text">Customer inquiries, order confirmations, inventory alerts. Agent handles communication at scale — satisfaction goes up, returns go down.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: Real Expectations (Comparison)
       ════════════════════════════════════════ -->
  <section class="section ai-expect">
    <div class="container">
      <div class="ai-expect__header animate-on-scroll">
        <SectionBadge text="WHAT TO EXPECT" variant="info" />
        <h2>No magic. Just <span class="accent-violet glow-medium-violet">math.</span></h2>
      </div>

      <div class="ai-expect__columns">
        <div class="ai-expect__col">
          <span class="ai-expect__col-header accent-emerald glow-medium-emerald">WHAT WE DELIVER</span>
        </div>
        <div class="ai-expect__col">
          <span class="ai-expect__col-header accent-amber glow-medium-amber">WHAT WE DON'T PROMISE</span>
        </div>
      </div>

      <div class="ai-expect__rows stagger-children">
        <div class="ai-expect__row">
          <div class="card card--solution ai-expect__card">
            <p class="card__text">Your team gets back 10–15 hours per week. That's 500+ hours per year.</p>
          </div>
          <div class="card card--amber ai-expect__card">
            <p class="card__text">Overnight transformation. Real results take 90 days.</p>
          </div>
        </div>

        <div class="ai-expect__row">
          <div class="card card--solution ai-expect__card">
            <p class="card__text">Document accuracy at 95%+. Machines don't have off days.</p>
          </div>
          <div class="card card--amber ai-expect__card">
            <p class="card__text">Zero errors ever. Edge cases happen — we monitor and fix within 24 hours.</p>
          </div>
        </div>

        <div class="ai-expect__row">
          <div class="card card--solution ai-expect__card">
            <p class="card__text">Handle volume growth without hiring. Automation scales with you.</p>
          </div>
          <div class="card card--amber ai-expect__card">
            <p class="card__text">Replacing your team. AI handles tasks, not judgment calls.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 9: FAQ
       ════════════════════════════════════════ -->
  <section class="section ai-faq">
    <div class="container">
      <div class="ai-faq__header animate-on-scroll">
        <SectionBadge text="FAQ" variant="feature" />
        <h2>Questions? We've <span class="accent-blue glow-medium-blue">heard</span> them.</h2>
      </div>

      <div class="faq-list animate-on-scroll">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How long does it take?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Audit (1–2 weeks) → Build (4–6 weeks) → Live (ongoing). Measurable results in 90 days.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Will AI replace my team?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">No. It replaces repetitive tasks. Your team does strategy, relationships, and judgment calls instead of data entry.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if it breaks?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We monitor continuously and fix issues within 24 hours. You're not on your own.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if we don't like it?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We modify or disable workflows easily. Most teams see enough benefit that they never want to go back.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How much does it cost?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Simple automations: $200–500/month. Bigger projects cost more. Fixed quotes after the audit. No surprises.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do we have to change our tools?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">No. We integrate with what you already use.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 10: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section ai-cta" id="contact-form">
    <div class="ai-cta__glow"></div>
    <div class="container">
      <div class="ai-cta__inner animate-on-scroll">
        <h2 class="ai-cta__headline">Let's find where <span class="accent-blue glow-medium-blue">automation</span> saves you time.</h2>
        <p class="ai-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="ai-automation" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     AI & Workflow Automation — Scoped Styles
     ────────────────────────────────────── */

  /* Accent text utilities */
  .accent-violet { color: var(--accent-violet); }
  .accent-coral { color: var(--accent-coral); }
  .accent-emerald { color: var(--accent-emerald); }
  .accent-blue { color: var(--accent-blue); }
  .accent-amber { color: var(--accent-amber); }

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: Stats Strip ── */
  .ai-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-xl) 0;
  }

  .ai-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ai-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ── Section 3: The Problem ── */
  .ai-problem__header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ai-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 4: What We Build ── */
  .ai-build__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ai-build__header h2 {
    margin-top: var(--space-md);
  }

  .ai-build__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ai-build__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .ai-build__grid .card__title {
    margin-top: var(--space-sm);
  }

  /* ── Section 5: How We Work (Timeline) ── */
  .ai-process__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ai-process__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .ai-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 700px;
    margin-inline: auto;
    position: relative;
  }

  /* Vertical connecting line */
  .ai-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-emerald), rgba(74, 222, 128, 0.15));
    border-radius: 1px;
  }

  .ai-timeline__step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
  }

  .ai-timeline__node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    border: 2px solid var(--accent-emerald);
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 12px var(--accent-emerald-glow);
  }

  .ai-timeline__number {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }

  .ai-timeline__card {
    flex-grow: 1;
  }

  .ai-timeline__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    background: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 3px 12px;
    margin-bottom: var(--space-sm);
  }

  /* ── Section 6: Technology (Split) ── */
  .ai-tech__header {
    text-align: center;

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout title="AI & Workflow Automation" description="Stop doing repetitive work. We build AI agents that automate scheduling, follow-ups, document processing, and data entry. Measure results in 90 days.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">AI & Workflow Automation</span>
        <h1 class="hero__title">Stop doing work your tools should handle.</h1>
        <p class="hero__subtitle">Your team spends hours every week on manual tasks that are boring, repetitive, and expensive. We build AI agents that automate those tasks — scheduling, follow-ups, document processing, data entry. In 90 days, you'll have what used to take 2-3 extra employees. And it keeps working after we're done.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get Your Free Audit</a>
          <a href="#what-we-build" class="btn btn--ghost">What We Automate</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="ai-problem animate-on-scroll">
        <span class="section-label">The Problem</span>
        <h2>Your team is stuck in a loop of repetitive work.</h2>
        <p class="text-large">You hire smart people to do smart work. Then you ask them to spend 5-10 hours a week on busywork: scheduling, data entry, follow-ups. The real solution is AI agents — not one-off automations, but actual work done automatically.</p>
        <p class="text-large">Most SMBs haven't built this yet. But teams with AI agents are doing the work of teams that are 25% larger. It takes expertise to set up and integrate. That's where we come in.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-build">
    <div class="container">
      <div class="ai-automate__header animate-on-scroll">
        <span class="section-label">What We Build</span>
        <h2>AI agents that handle the repetitive work.</h2>
      </div>

      <div class="ai-automate__grid stagger-children">
        <div class="card ai-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          </div>
          <h3 class="card__title">Lead Capture & Follow-Up Agents</h3>
          <p class="card__text">Leads are logged, categorized, and followed up automatically. Nothing falls through the cracks. Your sales team focuses on closing, not following up.</p>
        </div>

        <div class="card ai-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <h3 class="card__title">Appointment Scheduling Agents</h3>
          <p class="card__text">Customers book themselves. The agent handles scheduling, confirmations, reminders, and rescheduling. Your calendar is always full and always accurate.</p>
        </div>

        <div class="card ai-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <h3 class="card__title">Document & Invoice Processing</h3>
          <p class="card__text">Documents are read by AI, categorized, extracted, and filed automatically. Manual data entry drops to near zero. Everything is organized and searchable.</p>
        </div>

        <div class="card ai-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </div>
          <h3 class="card__title">Automated Customer Outreach</h3>
          <p class="card__text">Personalized follow-ups, reminders, and campaigns are sent automatically at the right time to the right person. Your team writes the templates once. The agent handles the rest.</p>
        </div>

        <div class="card ai-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
          </div>
          <h3 class="card__title">Data Entry & Reporting Automation</h3>
          <p class="card__text">Data flows from one system to another automatically. Forms are filled, reports are compiled and sent on schedule. Your database stays clean without human effort.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: How We Build It
       ════════════════════════════════════════ -->
  <section class="section section--alt ai-process">
    <div class="container">
      <div class="ai-process__header animate-on-scroll">
        <span class="section-label">How We Work</span>
        <h2>Phased approach. Proven results.</h2>
        <p class="text-large text-secondary">We don't try to automate everything at once. We move fast, but smart.</p>
      </div>

      <div class="timeline animate-on-scroll" style="margin-top: var(--space-xl);">
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Phase 01 — 1-2 Weeks</span>
          <h3 class="timeline__step-title">Audit & Design</h3>
          <p class="timeline__step-text">We watch your team work and map where time disappears. We identify quick wins and design the workflows in detail.</p>
        </div>
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Phase 02 — 4-6 Weeks</span>
          <h3 class="timeline__step-title">Build & Test</h3>
          <p class="timeline__step-text">We build agents configured for your tools. We test thoroughly, train your team, and refine based on feedback.</p>
        </div>
        <div class="timeline__step">
          <div class="timeline__marker"></div>
          <span class="timeline__step-label">Phase 03 — Ongoing</span>
          <h3 class="timeline__step-title">Launch & Support</h3>
          <p class="timeline__step-text">We launch with monitoring in place. We catch issues before they break. We measure impact and optimize based on real-world performance.</p>
        </div>
      </div>

      <p class="ai-process__timeline-note animate-on-scroll"><strong>Total timeline:</strong> 90 days to measurable results.</p>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: The Technology
       ════════════════════════════════════════ -->
  <section class="section ai-tech">
    <div class="container">
      <div class="split ai-tech__layout">
        <div class="ai-tech__visual animate-on-scroll">
          <div class="ai-tech__stat-block">
            <span class="ai-tech__stat-number" data-count-to="73" data-count-suffix="%">0%</span>
            <span class="ai-tech__stat-label">of SMBs that deployed AI agents in 2025 saw measurable productivity gains within 90 days</span>
          </div>
          <div class="ai-tech__stat-block">
            <span class="ai-tech__stat-number">$200-500</span>
            <span class="ai-tech__stat-label">/month in AI automation = 2-3 FTE equivalent output</span>
          </div>
        </div>
        <div class="ai-tech__content animate-on-scroll">
          <span class="section-label">Technology</span>
          <h2>Built on the latest in agentic AI.</h2>
          <p class="text-large">Agentic AI is the shift happening now. It doesn't answer questions — it takes actions. Books appointments. Sends emails. Processes documents. Runs continuously, learns from patterns, handles edge cases.</p>
          <p class="text-large text-secondary">We use proven platforms and AI models configured for your workflows. The important part isn't the technology name. It's the outcome: manual work disappears, your team gets back 10-15 hours a week, your business scales without hiring.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Who It's For
       ════════════════════════════════════════ -->
  <section class="section section--alt bg-dots ai-who">
    <div class="container">
      <div class="ai-who__header animate-on-scroll">
        <span class="section-label">Who Benefits Most</span>
        <h2>If you have repetitive work, you're a fit.</h2>
      </div>

      <div class="grid grid--2 stagger-children" style="margin-top: var(--space-xl);">
        <div class="card ai-who__card">
          <h3 class="card__title">Sales & Service Teams</h3>
          <p class="card__text">High volume of leads, clients, or service requests. Lots of follow-up and coordination work. Spending 20+ hours per week on admin instead of selling.</p>
          <p class="ai-who__benefit">Agent handles outreach, scheduling, follow-ups. Sales team sells. Revenue per employee goes up.</p>
        </div>

        <div class="card ai-who__card">
          <h3 class="card__title">Professional Services</h3>
          <p class="card__text">Trades, contractors, freelancers, agencies. Juggling scheduling, dispatch, invoicing, client communication. Can't justify hiring an office manager.</p>
          <p class="ai-who__benefit">Agent coordinates everything. Owner stops doing admin. Business scales without hiring.</p>
        </div>

        <div class="card ai-who__card">
          <h3 class="card__title">Healthcare & Admin-Heavy</h3>
          <p class="card__text">Patient/client communication, appointment reminders, insurance verification. High volume of repetitive documentation and filing.</p>
          <p class="ai-who__benefit">Agent reduces errors, improves patient experience, frees staff for higher-value work.</p>
        </div>

        <div class="card ai-who__card">
          <h3 class="card__title">E-Commerce & Fulfillment</h3>
          <p class="card__text">Customer inquiries, order confirmations, tracking updates. Inventory alerts and reorder automation. Personalized marketing.</p>
          <p class="ai-who__benefit">Agent handles customer communication at scale. Customer satisfaction goes up. Return rate goes down.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: Real Expectations
       ════════════════════════════════════════ -->
  <section class="section ai-expectations">
    <div class="container">
      <div class="ai-expectations__inner animate-on-scroll">
        <span class="section-label">What to Expect</span>
        <h2>No magic. Just math.</h2>
        <p class="text-large text-secondary">Automation works. Here's what you can actually expect:</p>

        <div class="ai-expectations__list">
          <div class="ai-expectations__item">
            <h3>Time Savings</h3>
            <p>Your team gets back 10-15 hours per week. That's 500+ hours per year.</p>
          </div>
          <div class="ai-expectations__item">
            <h3>Accuracy</h3>
            <p>Machines don't have off days. Document accuracy goes to 95%+. Errors drop to near zero.</p>
          </div>
          <div class="ai-expectations__item">
            <h3>Scale Without Hiring</h3>
            <p>Automation handles volume growth instead of hiring.</p>
          </div>
          <div class="ai-expectations__item">
            <h3>Mistakes Happen</h3>
            <p>Edge cases break workflows. We monitor and fix within 24 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 8: FAQ
       ════════════════════════════════════════ -->
  <section class="section section--alt ai-faq">
    <div class="container">
      <div class="ai-faq__header animate-on-scroll">
        <h2>Questions? We've heard them.</h2>
      </div>

      <div class="faq-list animate-on-scroll">
        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How long does it take?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Audit (1-2 weeks) → Build (4-6 weeks) → Live (ongoing). Measurable results in 90 days.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Will AI replace my team?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">It replaces repetitive tasks, not people. Your team does more interesting work — strategy, relationships, judgment calls instead of data entry.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if it breaks?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We monitor continuously and fix issues within 24 hours. You're not on your own.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            What if we don't like it?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">We modify or disable workflows easily. Most teams see enough benefit that they never want to go back.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            How much does it cost?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">Simple automations run $200-500/month. Bigger projects cost more. We give fixed quotes after the audit. No surprises.</div>
          </div>
        </div>

        <div class="faq-item">
          <button class="faq-question" aria-expanded="false">
            Do we change our tools?
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <div class="faq-answer">
            <div class="faq-answer__inner">No. We integrate with what you already use. We're not asking you to learn new platforms.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 9: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Let's find where automation saves you time."
    source="ai-automation"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     AI & Workflow Automation — scoped styles
     ────────────────────────────────────── */

  /* Problem section */
  .ai-problem {
    max-width: 800px;
    margin-inline: auto;
  }

  .ai-problem h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .ai-problem p {
    color: var(--text-secondary);
  }

  .ai-problem p + p {
    margin-top: var(--space-md);
  }

  /* Automate section */
  .ai-automate__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ai-automate__header h2 {
    margin-top: var(--space-sm);
  }

  .ai-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ai-automate__card .card__icon {
    margin-bottom: var(--space-md);
  }

  /* Process section */
  .ai-process__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .ai-process__header h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ai-process__header p {
    margin-inline: auto;
  }

  .ai-process__timeline-note {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    color: var(--accent-primary-hover);
    margin-top: var(--space-xl);
    padding-left: var(--space-xl);
  }

  /* Technology section */
  .ai-tech__layout {
    align-items: start;
  }

  .ai-tech__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .ai-tech__stat-block {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .ai-tech__stat-number {
    display: block;
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent-primary-hover);
    line-height: 1.1;
    margin-bottom: var(--space-sm);
  }

  .ai-tech__stat-label {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .ai-tech__content h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .ai-tech__content p + p {
    margin-top: var(--space-md);
  }

  /* Who it's for section */
  .ai-who__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .ai-who__header h2 {
    margin-top: var(--space-sm);
  }

  .ai-who__card .card__text {
    margin-bottom: var(--space-md);
  }

  .ai-who__benefit {
    font-size: 0.9375rem;
    color: var(--accent-primary-hover);
    font-weight: 500;
    padding-top: var(--space-md);
    border-top: 1px solid var(--border-subtle);
  }

  /* Expectations section */
  .ai-expectations__inner {
    max-width: 800px;
    margin-inline: auto;
  }

  .ai-expectations__inner h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ai-expectations__inner > p {
    margin-bottom: var(--space-xl);
  }

  .ai-expectations__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ai-expectations__item {
    padding-left: var(--space-lg);
    border-left: 3px solid var(--accent-primary);
  }

  .ai-expectations__item h3 {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .ai-expectations__item p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* FAQ section */
  .ai-faq__header {
    max-width: 800px;
    margin-bottom: var(--space-xl);
  }

  /* Responsive */
  @media (min-width: 768px) {
    .ai-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-expectations__list {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-tech__stat-number {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .ai-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-automate__grid > :last-child {
      grid-column: span 1;
    }

    .ai-tech__layout {
      gap: var(--space-3xl);
    }
  }
</style>

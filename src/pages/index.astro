---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionBadge from '../components/SectionBadge.astro';
import SectionDivider from '../components/SectionDivider.astro';
import CTASection from '../components/CTASection.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="AI-First IT Services for SMBs" description="Constance IT provides AI-first IT services for small and medium businesses in healthcare, real estate, e-commerce, and professional services. Based in Austin, TX.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">Your <span class="accent-violet glow-heavy-violet">AI team.</span> One point of contact.</h1>
        <p class="hero__subtitle">Constance IT helps small and medium businesses automate the repetitive work that's costing them time, money, and growth. We identify what to fix, build the automation, and stay with you after.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get a Free Assessment</a>
          <a href="/services/" class="btn btn--ghost">See How We Work &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section hp-problem">
    <div class="container">
      <div class="hp-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Your team is buried in <span class="accent-coral glow-medium-coral">manual work.</span></h2>
        <p class="text-large text-secondary">Every day, your staff loses hours to tasks that software should handle.</p>
      </div>

      <div class="grid grid--2 stagger-children hp-problem__grid">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">FOLLOW-UPS</span>
          <p class="card__text">Leads slip because reminders don't go out on time. Opportunities die in the inbox.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DATA ENTRY</span>
          <p class="card__text">The same information typed into three different systems. Every time.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">REPORTING</span>
          <p class="card__text">Hours spent building reports that should take seconds.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">IT SUPPORT</span>
          <p class="card__text">Different technician every call. No one knows your setup. You start from scratch each time.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: What Changes (Comparison Block)
       ════════════════════════════════════════ -->
  <section class="section hp-comparison">
    <div class="container">
      <div class="hp-comparison__header animate-on-scroll">
        <SectionBadge text="WHAT CHANGES" variant="info" />
        <h2>The <span class="accent-violet glow-medium-violet">difference</span> is night and day.</h2>
      </div>

      <div class="hp-comparison__columns">
        <div class="hp-comparison__col">
          <span class="hp-comparison__col-header accent-coral glow-medium-coral">WITHOUT US</span>
        </div>
        <div class="hp-comparison__col">
          <span class="hp-comparison__col-header accent-emerald glow-medium-emerald">WITH CONSTANCE IT</span>
        </div>
      </div>

      <div class="hp-comparison__rows stagger-children">
        <!-- Row 1: Support -->
        <div class="hp-comparison__row">
          <div class="card card--problem hp-comparison__card">
            <span class="card__category accent-coral glow-medium-coral">SUPPORT</span>
            <p class="card__text">Different person every call. No context. No accountability.</p>
          </div>
          <div class="card card--solution hp-comparison__card">
            <span class="card__category accent-emerald glow-medium-emerald">SUPPORT</span>
            <p class="card__text">One point of contact. Same person. Always.</p>
          </div>
        </div>

        <!-- Row 2: Pricing -->
        <div class="hp-comparison__row">
          <div class="card card--problem hp-comparison__card">
            <span class="card__category accent-coral glow-medium-coral">PRICING</span>
            <p class="card__text">Long contracts, hidden fees, surprise invoices.</p>
          </div>
          <div class="card card--solution hp-comparison__card">
            <span class="card__category accent-emerald glow-medium-emerald">PRICING</span>
            <p class="card__text">Month-to-month. Fixed price. No surprises.</p>
          </div>
        </div>

        <!-- Row 3: Timeline -->
        <div class="hp-comparison__row">
          <div class="card card--problem hp-comparison__card">
            <span class="card__category accent-coral glow-medium-coral">TIMELINE</span>
            <p class="card__text">Big promises, slow delivery, months of "onboarding."</p>
          </div>
          <div class="card card--solution hp-comparison__card">
            <span class="card__category accent-emerald glow-medium-emerald">TIMELINE</span>
            <p class="card__text"><span class="accent-emerald glow-subtle-emerald">90 days</span> to measurable results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: How We Work (Services Overview)
       ════════════════════════════════════════ -->
  <section class="section hp-services">
    <div class="container">
      <div class="hp-services__header animate-on-scroll">
        <SectionBadge text="HOW WE WORK" variant="solution" />
        <h2><span class="accent-emerald glow-medium-emerald">Identify.</span> Automate. Support.</h2>
        <p class="text-large text-secondary">All three services work together to keep your business running and growing.</p>
      </div>

      <div class="grid grid--3 stagger-children hp-services__grid">
        <!-- AI & Workflow Automation -->
        <div class="card card--service-ai hp-service-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 4.5a2.5 2.5 0 0 0-4.96-.46 2.5 2.5 0 0 0-1.98 3 2.5 2.5 0 0 0-1.32 4.24 3 3 0 0 0 .34 5.58 2.5 2.5 0 0 0 2.96 3.08A2.5 2.5 0 0 0 9.5 22c1.21 0 2.5-.74 2.5-2.5m0-15a2.5 2.5 0 0 1 4.96-.46 2.5 2.5 0 0 1 1.98 3 2.5 2.5 0 0 1 1.32 4.24 3 3 0 0 1-.34 5.58 2.5 2.5 0 0 1-2.96 3.08A2.5 2.5 0 0 1 14.5 22c-1.21 0-2.5-.74-2.5-2.5m0-15V2"/><path d="M8.5 8.5h7v7h-7z"/><path d="m8.5 12H12v3.5"/><path d="M12 8.5V12h3.5"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">AI & WORKFLOW AUTOMATION</span>
          <p class="card__text">We build custom automations that handle the repetitive work eating your time. Document processing, lead follow-up, data entry, scheduling.</p>
          <a href="/services/ai-workflow-automation/" class="card__link accent-blue glow-subtle-blue">
            Explore AI Automation
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Managed IT -->
        <div class="card card--service-it hp-service-card">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <span class="card__category accent-emerald glow-medium-emerald">MANAGED IT</span>
          <p class="card__text">Proactive monitoring, security, backups, and support for your entire IT environment. We handle the day-to-day so your team focuses on what matters.</p>
          <a href="/services/managed-it/" class="card__link accent-emerald glow-subtle-emerald">
            Explore Managed IT
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- IT Infrastructure -->
        <div class="card card--service-infra hp-service-card">
          <div class="card__icon icon-glow-amber">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="16" y="16" width="6" height="6" rx="1"/><rect x="2" y="16" width="6" height="6" rx="1"/><rect x="9" y="2" width="6" height="6" rx="1"/><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3"/><path d="M12 12V8"/></svg>
          </div>
          <span class="card__category accent-amber glow-medium-amber">IT INFRASTRUCTURE</span>
          <p class="card__text">Cabling, network closet builds, office buildouts, and hardware deployment. Cisco-certified technicians, on-site across Texas.</p>
          <a href="/services/it-infrastructure/" class="card__link accent-amber glow-subtle-amber">
            Explore Infrastructure
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <div class="hp-services__link animate-on-scroll">
        <a href="/services/" class="link link--arrow accent-blue glow-subtle-blue">
          See all our services
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: Industries We Serve
       ════════════════════════════════════════ -->
  <section class="section hp-industries">
    <div class="container">
      <div class="hp-industries__header animate-on-scroll">
        <SectionBadge text="INDUSTRIES WE SERVE" variant="feature" />
        <h2>AI automation built for <span class="accent-blue glow-medium-blue">your industry.</span></h2>
        <p class="text-large text-secondary">We don't do generic. Every automation starts with the specific challenges your industry faces.</p>
      </div>

      <div class="grid grid--2 stagger-children hp-industries__grid">
        <!-- Healthcare -->
        <a href="/industries/healthcare/" class="card card--feature hp-industry-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><circle cx="20" cy="10" r="2"/></svg>
          </div>
          <h3 class="card__title">Healthcare</h3>
          <p class="card__text">Managed IT and AI automation for outpatient providers &mdash; MSOs, ASCs, OBLs, and clinics.</p>
          <span class="card__link accent-blue" aria-hidden="true">
            Explore Healthcare
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- Real Estate -->
        <a href="/industries/real-estate/" class="card card--feature hp-industry-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <h3 class="card__title">Real Estate</h3>
          <p class="card__text">Automate property management, client outreach, documentation, and CRM workflows.</p>
          <span class="card__link accent-blue" aria-hidden="true">
            Explore Real Estate
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- E-Commerce -->
        <a href="/industries/ecommerce/" class="card card--feature hp-industry-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          </div>
          <h3 class="card__title">E-Commerce</h3>
          <p class="card__text">Streamline inventory, customer service, personalized marketing, and order management.</p>
          <span class="card__link accent-blue" aria-hidden="true">
            Explore E-Commerce
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- Professional Services -->
        <a href="/industries/professional-services/" class="card card--feature hp-industry-card">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="card__title">Professional Services</h3>
          <p class="card__text">Scheduling, dispatching, invoicing, lead gen, and review management for trades and service businesses.</p>
          <span class="card__link accent-blue" aria-hidden="true">
            Explore Professional Services
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Why Constance IT
       ════════════════════════════════════════ -->
  <section class="section hp-why">
    <div class="container">
      <div class="hp-why__header animate-on-scroll">
        <SectionBadge text="WHY US" variant="info" />
        <h2>Built <span class="accent-violet glow-medium-violet">different.</span> On purpose.</h2>
      </div>

      <div class="hp-why__grid stagger-children">
        <div class="hp-why__feature">
          <div class="hp-why__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
          </div>
          <div>
            <h3 class="hp-why__title">One Point of Contact</h3>
            <p class="hp-why__text">You work with one person who knows your systems, your industry, and your history. No call centers. No ticket queues.</p>
          </div>
        </div>

        <div class="hp-why__feature">
          <div class="hp-why__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
          </div>
          <div>
            <h3 class="hp-why__title">AI-First, Not AI-Only</h3>
            <p class="hp-why__text">AI is our primary tool, not our entire identity. If a simpler solution fits better, we'll tell you.</p>
          </div>
        </div>

        <div class="hp-why__feature">
          <div class="hp-why__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <div>
            <h3 class="hp-why__title">We Stay</h3>
            <p class="hp-why__text">Implementation is half the job. We provide ongoing support and adjustments so your automations keep working as your business grows.</p>
          </div>
        </div>

        <div class="hp-why__feature">
          <div class="hp-why__icon icon-glow-violet">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <div>
            <h3 class="hp-why__title">SMB-Focused</h3>
            <p class="hp-why__text">We work with businesses of 5 to 200 people. Our pricing, process, and communication style are designed for teams like yours.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Technologies We Work With
       ════════════════════════════════════════ -->
  <section class="section hp-tech">
    <div class="container">
      <div class="hp-tech__inner animate-on-scroll">
        <SectionBadge text="TECHNOLOGIES" variant="feature" />
        <div class="hp-tech__badges">
          <span class="tech-badge">Claude</span>
          <span class="tech-badge">GPT</span>
          <span class="tech-badge">Google AI</span>
          <span class="tech-badge">OpenClaw</span>
          <span class="tech-badge">Make</span>
          <span class="tech-badge">Zapier</span>
          <span class="tech-badge">n8n</span>
          <span class="tech-badge">Microsoft 365</span>
          <span class="tech-badge">Google Workspace</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: Final CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section hp-cta">
    <div class="hp-cta__glow"></div>
    <div class="container">
      <div class="hp-cta__inner animate-on-scroll">
        <h2 class="hp-cta__headline">Ready to stop doing the work your <span class="accent-blue glow-medium-blue">tools</span> should handle?</h2>
        <p class="hp-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="homepage" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Homepage — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glow — multi-color */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* Accent text utility classes (scoped for specificity) */
  .accent-violet {
    color: var(--accent-violet);
  }
  .accent-coral {
    color: var(--accent-coral);
  }
  .accent-emerald {
    color: var(--accent-emerald);
  }
  .accent-blue {
    color: var(--accent-blue);
  }
  .accent-amber {
    color: var(--accent-amber);
  }

  /* ── Section 2: Problem ── */
  .hp-problem__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hp-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .hp-problem__grid {
    margin-top: var(--space-lg);
  }

  /* ── Section 3: Comparison ── */
  .hp-comparison__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hp-comparison__header h2 {
    margin-top: var(--space-md);
  }

  .hp-comparison__columns {
    display: none;

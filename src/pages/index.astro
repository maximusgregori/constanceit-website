---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout title="AI-First IT Services for SMBs" description="Constance IT provides AI-first IT services for small and medium businesses in healthcare, real estate, e-commerce, and professional services. Based in Austin, TX.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">AI-First IT Services</span>
        <h1 class="hero__title">Your AI team. One point of contact.</h1>
        <p class="hero__subtitle">Constance IT helps small and medium businesses automate the repetitive work that's costing them time, money, and growth. We identify what to fix, implement the automation, and stay with you after.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get a Free Assessment</a>
          <a href="/services/" class="btn btn--ghost">See How We Work →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: Problem Statement
       ════════════════════════════════════════ -->
  <section class="section section--alt homepage-problem">
    <div class="container">
      <div class="homepage-problem__inner animate-on-scroll">
        <span class="section-label">The Problem</span>
        <h2>Your team is drowning in tasks that software should handle.</h2>
        <p class="text-large">Every day, your staff spends hours on follow-ups that don't get sent, data that gets entered twice, leads that slip through the cracks, and invoices that sit in a queue.</p>
        <p class="text-large">You need someone who understands your business, identifies what's actually costing you time, builds the automation, and stays to make sure it works.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: Services Overview — How We Work
       ════════════════════════════════════════ -->
  <section class="section homepage-services">
    <div class="container">
      <div class="homepage-services__header animate-on-scroll">
        <span class="section-label">How We Work</span>
        <h2>Identify. Automate. Support.</h2>
      </div>

      <div class="grid grid--3 stagger-children" style="margin-top: var(--space-xl);">
        <!-- AI & Workflow Automation -->
        <div class="card homepage-service-card">
          <span class="homepage-service-card__step">01</span>
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          </div>
          <h3 class="card__title">AI & Workflow Automation</h3>
          <p class="card__text">We build custom AI-powered automations that handle the repetitive work eating your time: document processing, lead follow-up, data entry, scheduling. Tailored to your industry and your existing tools.</p>
          <a href="/services/ai-workflow-automation/" class="card__link">
            Explore AI & Automation
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- Managed IT -->
        <div class="card homepage-service-card">
          <span class="homepage-service-card__step">02</span>
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <h3 class="card__title">Managed IT</h3>
          <p class="card__text">Proactive monitoring, security, backups, and support for your entire IT environment. We handle the day-to-day so your team can focus on what matters.</p>
          <a href="/services/managed-it/" class="card__link">
            Explore Managed IT
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>

        <!-- IT Infrastructure -->
        <div class="card homepage-service-card">
          <span class="homepage-service-card__step">03</span>
          <div class="card__icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
          </div>
          <h3 class="card__title">IT Infrastructure</h3>
          <p class="card__text">Cabling, network closet builds, office buildouts, and hardware deployment. Cisco-certified technicians, on-site across Texas.</p>
          <a href="/services/it-infrastructure/" class="card__link">
            Explore Infrastructure
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>

      <p class="homepage-services__philosophy animate-on-scroll">All three services work together. Automate the repetitive work with AI. Keep everything running with managed IT. Build the physical infrastructure to support it all.</p>

      <div class="homepage-services__link animate-on-scroll">
        <a href="/services/" class="link link--arrow">
          See all our services
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: Industry Verticals
       ════════════════════════════════════════ -->
  <section class="section section--alt homepage-industries bg-dots">
    <div class="container">
      <div class="homepage-industries__header animate-on-scroll">
        <span class="section-label">Industries We Serve</span>
        <h2>AI automation built for your industry.</h2>
        <p class="text-large text-secondary">We don't do generic. Every automation we build starts with the specific challenges your industry faces — then we solve them.</p>
      </div>

      <div class="grid grid--2 stagger-children" style="margin-top: var(--space-xl);">
        <!-- Healthcare -->
        <a href="/industries/healthcare/" class="card homepage-industry-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6 6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3"/><path d="M8 15v1a6 6 0 0 0 6 6 6 6 0 0 0 6-6v-4"/><path d="M22 10 A2 2 0 0 1 20 12 A2 2 0 0 1 18 10 A2 2 0 0 1 22 10"/></svg>
          </div>
          <h3 class="card__title">Healthcare</h3>
          <p class="card__text">Managed IT and AI automation for outpatient providers — MSOs, ASCs, OBLs, and clinics.</p>
          <span class="card__link" aria-hidden="true">
            Explore Healthcare
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- Real Estate -->
        <a href="/industries/real-estate/" class="card homepage-industry-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22V4a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v18Z"/><path d="M6 12H4a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"/><path d="M18 9h2a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-2"/><path d="M10 6h4"/><path d="M10 10h4"/><path d="M10 14h4"/><path d="M10 18h4"/></svg>
          </div>
          <h3 class="card__title">Real Estate</h3>
          <p class="card__text">Automate property management, client outreach, documentation, and CRM workflows for real estate teams.</p>
          <span class="card__link" aria-hidden="true">
            Explore Real Estate
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- E-Commerce -->
        <a href="/industries/ecommerce/" class="card homepage-industry-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          </div>
          <h3 class="card__title">E-Commerce</h3>
          <p class="card__text">Streamline inventory, customer service, personalized marketing, and order management with AI.</p>
          <span class="card__link" aria-hidden="true">
            Explore E-Commerce
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>

        <!-- Professional Services -->
        <a href="/industries/professional-services/" class="card homepage-industry-card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <h3 class="card__title">Professional Services</h3>
          <p class="card__text">Scheduling, dispatching, invoicing, lead gen, and review management for trades and service businesses.</p>
          <span class="card__link" aria-hidden="true">
            Explore Professional Services
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Why Constance IT
       ════════════════════════════════════════ -->
  <section class="section homepage-why">
    <div class="container">
      <div class="split homepage-why__layout">
        <!-- Left: heading -->
        <div class="homepage-why__heading animate-on-scroll">
          <span class="section-label">Why Constance IT</span>
          <h2>Built different. On purpose.</h2>
        </div>

        <!-- Right: feature blocks -->
        <div class="homepage-why__features stagger-children">
          <div class="homepage-feature">
            <div class="homepage-feature__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
            </div>
            <div>
              <h3 class="homepage-feature__title">One Point of Contact</h3>
              <p class="homepage-feature__text">You'll work with one person who knows your systems, your industry, and your history. No call centers. No ticket queues. No starting from scratch every time.</p>
            </div>
          </div>

          <div class="homepage-feature">
            <div class="homepage-feature__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/></svg>
            </div>
            <div>
              <h3 class="homepage-feature__title">AI-First, Not AI-Only</h3>
              <p class="homepage-feature__text">AI is our primary tool, not our entire identity. If a simpler solution fits better, we'll tell you. We're not here to sell you AI — we're here to save you time.</p>
            </div>
          </div>

          <div class="homepage-feature">
            <div class="homepage-feature__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="5" r="3"/><line x1="12" x2="12" y1="22" y2="8"/><path d="M5 12H2a10 10 0 0 0 20 0h-3"/></svg>
            </div>
            <div>
              <h3 class="homepage-feature__title">We Stay</h3>
              <p class="homepage-feature__text">Implementation is half the job. We provide ongoing support, monitoring, and adjustments so your automations keep working as your business grows.</p>
            </div>
          </div>

          <div class="homepage-feature">
            <div class="homepage-feature__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </div>
            <div>
              <h3 class="homepage-feature__title">SMB-Focused</h3>
              <p class="homepage-feature__text">We work with businesses of 5 to 200 people. Our pricing, our process, and our communication style are designed for teams like yours — not enterprise committees.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Technologies & Tools
       ════════════════════════════════════════ -->
  <section class="section section--alt homepage-tech">
    <div class="container">
      <div class="homepage-tech__inner animate-on-scroll">
        <span class="section-label" style="text-align: center;">Technologies We Work With</span>
        <div class="homepage-tech__badges">
          <span class="tech-badge">Claude</span>
          <span class="tech-badge">GPT</span>
          <span class="tech-badge">Google AI</span>
          <span class="tech-badge">OpenClaw</span>
          <span class="tech-badge">Make</span>
          <span class="tech-badge">Zapier</span>
          <span class="tech-badge">n8n</span>
          <span class="tech-badge">Microsoft 365</span>
          <span class="tech-badge">Google Workspace</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: Final CTA
       ════════════════════════════════════════ -->
  <CTASection source="homepage" />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Homepage-specific scoped styles
     ────────────────────────────────────── */

  /* Problem Statement */
  .homepage-problem__inner {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .homepage-problem__inner h2 {
    margin-bottom: var(--space-lg);
  }

  .homepage-problem__inner p {
    margin-inline: auto;
    color: var(--text-secondary);
  }

  .homepage-problem__inner p + p {
    margin-top: var(--space-md);
  }

  /* Services section */
  .homepage-services__header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
  }

  .homepage-services__header h2 {
    margin-top: var(--space-sm);
  }

  .homepage-service-card {
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .homepage-service-card__step {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 400;
    color: var(--accent-primary);
    letter-spacing: 0.04em;
    margin-bottom: var(--space-md);
    opacity: 0.6;
  }

  .homepage-service-card .card__text {
    flex-grow: 1;
  }

  .homepage-services__philosophy {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-top: var(--space-xl);
    color: var(--text-secondary);
    font-style: italic;
  }

  .homepage-services__link {
    text-align: center;
    margin-top: var(--space-lg);
  }

  /* Industries section */
  .homepage-industries__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .homepage-industries__header h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .homepage-industries__header p {
    margin-inline: auto;
  }

  .homepage-industry-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    cursor: pointer;
  }

  .homepage-industry-card .card__text {
    flex-grow: 1;
  }

  /* Why Constance IT — split layout */
  .homepage-why__heading h2 {
    margin-top: var(--space-sm);
  }

  .homepage-why__features {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .homepage-feature {
    display: flex;
    gap: var(--space-md);
    align-items: flex-start;
  }

  .homepage-feature__icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background-color: rgba(26, 118, 188, 0.1);
    color: var(--accent-primary-hover);
  }

  .homepage-feature__title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .homepage-feature__text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Technologies badges */
  .homepage-tech__inner {
    text-align: center;
  }

  .homepage-tech__badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
  }

  .tech-badge {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--text-secondary);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 8px 20px;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .tech-badge:hover {
    color: var(--text-primary);
    border-color: var(--border-accent);
  }

  /* Responsive adjustments */
  @media (min-width: 768px) {
    .homepage-feature__icon {
      width: 48px;
      height: 48px;
    }

    .homepage-feature {
      gap: var(--space-lg);
    }

    .homepage-feature__title {
      font-size: 1.25rem;
    }
  }

  @media (min-width: 1024px) {
    .homepage-why__layout {
      gap: var(--space-3xl);
    }

    .homepage-why__heading {
      position: sticky;
      top: calc(var(--header-height) + var(--space-xl));
      align-self: start;
    }
  }
</style>

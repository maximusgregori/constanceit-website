---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout title="Healthcare IT & AI Services" description="AI automation for outpatient clinics, ASCs, and MSOs. Automate scheduling, prior auth, credentialing, referrals, billing — so your team can focus on patients.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">Healthcare</span>
        <h1 class="hero__title">Your outpatient clinic is running itself short on staff. Let automation do the rest.</h1>
        <p class="hero__subtitle">Patient scheduling, prior authorization follow-ups, referral tracking, credentialing workflows, and billing claim management — all the things your team manually handles right now. Constance IT automates them so your staff can focus on actual patient care.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">How We Help Healthcare</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="hc-problem animate-on-scroll">
        <span class="section-label">The Problem</span>
        <h2>Your staff is drowning in administrative work. Patients are waiting longer. Revenue is slipping.</h2>
        <p class="text-large">Every day, your team spends hours on follow-ups that don't get sent: prior authorizations that need checking, referrals that slip through cracks, credentialing paperwork that sits in a queue, patient calls that get returned late, and billing claims that don't get submitted on time.</p>
        <p class="text-large">You can't hire faster than the work accumulates. And even when you do, new staff takes months to get up to speed on your EHR, your insurance workflows, your compliance requirements.</p>
        <p class="text-large">Meanwhile, patients see delays. Revenue slips. Staff gets burned out from doing work that a computer should be doing.</p>
        <p class="text-large">You don't need more hiring. You need the right automation.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="hc-automate__header animate-on-scroll">
        <span class="section-label">What We Automate</span>
        <h2>The workflows your team does every single day.</h2>
      </div>

      <div class="hc-automate__grid stagger-children">
        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
          </div>
          <h3 class="card__title">AI-Powered Clinical Documentation</h3>
          <p class="card__text">AI listens to patient visits and automatically generates structured notes, saving clinicians 13+ hours per week on documentation alone. Works with common EHRs. Eliminates the post-visit documentation grind so clinicians see more patients and staff focus on actual care delivery.</p>
        </div>

        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <h3 class="card__title">Prior Authorization Automation</h3>
          <p class="card__text">Automated status checks on submitted authorizations. Flags denials, expirations, and missing information. Sends follow-up requests to payers automatically. Aligns with CMS Interoperability and Prior Authorization Final Rule requirements. Notifies staff when a prior auth clears so the patient can be scheduled immediately.</p>
        </div>

        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
          </div>
          <h3 class="card__title">Revenue Cycle Automation</h3>
          <p class="card__text">AI chains documentation, coding, claims, and follow-up in one seamless workflow. Pulls patient history pre-visit, captures notes during, submits claims after, and tracks status automatically. Reduces administrative overhead and improves collection rates.</p>
        </div>

        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <h3 class="card__title">Automated Patient Communication</h3>
          <p class="card__text">30-40% of routine patient FAQs handled by AI voice agents. Appointment reminders, follow-up confirmations, and basic questions answered automatically 24/7. Surfaces open appointment slots to staff. Reduces front-office workload.</p>
        </div>

        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9 15l2 2 4-4"/></svg>
          </div>
          <h3 class="card__title">Credentialing & Compliance</h3>
          <p class="card__text">Tracks credentialing documents by provider and status. Alerts staff when documents are expiring. Pulls required documents automatically. Maintains audit trails for HIPAA and state licensing requirements. Administrative automation can save staff up to 47% of their time on routine duties.</p>
        </div>

        <div class="card hc-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <h3 class="card__title">Referral Tracking & Routing</h3>
          <p class="card__text">Incoming referrals are automatically parsed, categorized by provider, and routed to the correct department. Tracks referral status end-to-end. Automatically sends receipt confirmations and follow-ups.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: How It Works
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="hc-process animate-on-scroll">
        <span class="section-label">How It Works</span>
        <h2>Same process. Built for healthcare.</h2>
        <p class="text-large">We start by auditing your current workflows: how scheduling happens, how prior auth requests are tracked, where referrals go, how credentialing documents are managed. We map out the steps, the bottlenecks, and the time sinks.</p>
        <p class="text-large">Then we build automations — custom workflows that handle the routine parts, integrated with your EHR and billing system. Your staff sees a cleaner interface, fewer manual steps, and less room for error.</p>
        <p class="text-large">After implementation, we stay. We monitor performance, fix issues, and adjust workflows as your practice grows or your payer mix changes. You have one point of contact who understands healthcare operations and your specific setup.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Results
       ════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="hc-results__header animate-on-scroll">
        <span class="section-label">Results</span>
        <h2>What actually changes.</h2>
      </div>

      <div class="hc-results__grid stagger-children">
        <div class="card hc-results__card">
          <h3 class="card__title">Reduce Documentation Burden</h3>
          <p class="card__text">Clinicians spend 13+ hours per week on documentation. AI-powered ambient documentation cuts this dramatically, freeing time for patient care and reducing clinician burnout.</p>
        </div>

        <div class="card hc-results__card">
          <h3 class="card__title">Staff Handle 47% More Work</h3>
          <p class="card__text">AI automation can save administrators up to 47% of their time on routine duties. Scheduling, prior auth checks, referral routing, and credentialing happen automatically. Staff focuses on exception handling and patient service.</p>
        </div>

        <div class="card hc-results__card">
          <h3 class="card__title">Revenue Cycle Improves</h3>
          <p class="card__text">End-to-end automation from documentation through claims follow-up means claims don't slip through. Collection rates improve, and cash flow stabilizes because follow-ups happen automatically.</p>
        </div>

        <div class="card hc-results__card">
          <h3 class="card__title">Your Team Stops Burning Out</h3>
          <p class="card__text">Administrative costs still account for 25-30% of total US healthcare spend and drive staff turnover. When repetitive work gets automated, morale improves, turnover drops, and you keep experienced people longer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Why Constance IT for Healthcare
       ════════════════════════════════════════ -->
  <section class="section section--alt bg-dots">
    <div class="container">
      <div class="hc-why animate-on-scroll">
        <span class="section-label">Why Constance IT for Healthcare</span>
        <h2>We know your world.</h2>
        <p class="text-large">Constance IT has been working with healthcare providers since day one. We understand MSO operations, ASC workflows, clinic billing cycles, and the compliance requirements that make healthcare different. We've built automations that integrate with the EHRs and billing systems you're already using. And we stay — one consistent contact who understands your practice, your challenges, and your growth.</p>

        <div class="hc-why__callouts">
          <div class="hc-why__callout">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
            <div>
              <strong>Compliance-First</strong>
              <p>Every automation we build respects HIPAA, state licensing requirements, and CMS interoperability rules.</p>
            </div>
          </div>
          <div class="hc-why__callout">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
            <div>
              <strong>Multi-Service Approach</strong>
              <p>Beyond AI automation, we offer managed IT support and IT infrastructure to healthcare practices.</p>
            </div>
          </div>
          <div class="hc-why__callout">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14"/><path d="M2 20h20"/><path d="M14 12v.01"/></svg>
            <div>
              <strong>Healthcare-Specific Solutions</strong>
              <p>Visit <a href="https://health.constanceit.com" class="link">health.constanceit.com</a> for healthcare-specific staffing, managed IT, and specialized support.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Ready to get your team's time back?"
    subtext="Whether you want a quick assessment of where your biggest bottlenecks are, or you're ready to plan a full automation project, we can help. Let's talk about what matters to your practice."
    source="healthcare"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Healthcare — scoped styles
     ────────────────────────────────────── */

  /* Problem section */
  .hc-problem {
    max-width: 800px;
    margin-inline: auto;
  }

  .hc-problem h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hc-problem p {
    color: var(--text-secondary);
  }

  .hc-problem p + p {
    margin-top: var(--space-md);
  }

  /* Automate section */
  .hc-automate__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-automate__header h2 {
    margin-top: var(--space-sm);
  }

  .hc-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .hc-automate__card .card__icon {
    margin-bottom: var(--space-md);
  }

  /* Process section */
  .hc-process {
    max-width: 800px;
    margin-inline: auto;
  }

  .hc-process h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hc-process p {
    color: var(--text-secondary);
  }

  .hc-process p + p {
    margin-top: var(--space-md);
  }

  /* Results section */
  .hc-results__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-results__header h2 {
    margin-top: var(--space-sm);
  }

  .hc-results__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .hc-results__card .card__text {
    margin-top: var(--space-sm);
  }

  /* Why section */
  .hc-why {
    max-width: 800px;
    margin-inline: auto;
  }

  .hc-why h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .hc-why > .text-large {
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  .hc-why__callouts {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .hc-why__callout {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .hc-why__callout svg {
    flex-shrink: 0;
    color: var(--accent-primary);
    margin-top: 2px;
  }

  .hc-why__callout strong {
    display: block;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: var(--space-xs);
  }

  .hc-why__callout p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .hc-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .hc-results__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .hc-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

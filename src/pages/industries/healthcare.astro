---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Healthcare IT & AI Services" description="AI automation for outpatient clinics, ASCs, and MSOs. Automate scheduling, prior auth, credentialing, referrals, billing — so your team can focus on patients.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">Your clinic is running short on staff. Let <span class="accent-violet glow-heavy-violet">automation</span> do the rest.</h1>
        <p class="hero__subtitle">Scheduling, prior auth, referral tracking, credentialing, and billing claim management — automated. Your staff focuses on actual patient care.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">How We Help Healthcare &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Stats Strip
       ════════════════════════════════════════ -->
  <section class="section hc-stats">
    <div class="container">
      <div class="hc-stats__grid animate-on-scroll">
        <div class="hc-stats__item">
          <span class="stat-number stat-number--emerald">13+ hrs/week</span>
          <span class="hc-stats__label">Saved on documentation per clinician</span>
        </div>
        <div class="hc-stats__item">
          <span class="stat-number stat-number--violet">40%</span>
          <span class="hc-stats__label">Faster prior auth resolution</span>
        </div>
        <div class="hc-stats__item">
          <span class="stat-number stat-number--blue">95%+</span>
          <span class="hc-stats__label">Claims accuracy</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Problem
       ════════════════════════════════════════ -->
  <section class="section hc-problem">
    <div class="container">
      <div class="hc-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Your staff is drowning in <span class="accent-coral glow-medium-coral">administrative work.</span></h2>
        <p class="text-large text-secondary">Patients are waiting longer. Revenue is slipping. Staff is burning out.</p>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">FOLLOW-UPS</span>
          <p class="card__text">Prior authorizations need checking. Referrals slip through cracks. Credentialing paperwork sits in a queue.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">HIRING GAP</span>
          <p class="card__text">You can't hire faster than the work accumulates. New staff takes months to learn your EHR and compliance requirements.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DOCUMENTATION</span>
          <p class="card__text">Clinicians spend 2+ hours after every shift on notes. Post-visit documentation grind reduces throughput and causes burnout.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">REVENUE LEAKAGE</span>
          <p class="card__text">Claims don't get submitted on time. Denials aren't resubmitted. Cash flow suffers because follow-ups don't happen.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="hc-automate__header animate-on-scroll">
        <SectionBadge text="WHAT WE AUTOMATE" variant="feature" />
        <h2>The workflows your team does <span class="accent-blue glow-medium-blue">every single day.</span></h2>
      </div>

      <div class="hc-automate__grid stagger-children">
        <!-- Card 1: Documentation -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">DOCUMENTATION</span>
          <h3 class="card__title">AI-Powered Clinical Documentation</h3>
          <p class="card__text">AI listens to patient visits and generates structured notes automatically. Works with common EHRs. Eliminates the post-visit documentation grind.</p>
        </div>

        <!-- Card 2: Prior Auth -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">PRIOR AUTH</span>
          <h3 class="card__title">Prior Authorization Automation</h3>
          <p class="card__text">Automated status checks on submitted authorizations. Flags denials, expirations, and missing info. CMS Final Rule compliant.</p>
        </div>

        <!-- Card 3: Revenue Cycle -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REVENUE CYCLE</span>
          <h3 class="card__title">Revenue Cycle Automation</h3>
          <p class="card__text">AI chains documentation → coding → claims → follow-up in one workflow. Pulls history pre-visit, captures notes during, submits claims after.</p>
        </div>

        <!-- Card 4: Scheduling -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SCHEDULING</span>
          <h3 class="card__title">Automated Patient Communication</h3>
          <p class="card__text">30–40% of routine patient FAQs handled by AI voice agents. Appointment reminders, follow-up confirmations, and basic questions answered 24/7.</p>
        </div>

        <!-- Card 5: Credentialing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M9 15l2 2 4-4"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">CREDENTIALING</span>
          <h3 class="card__title">Credentialing & Compliance Tracking</h3>
          <p class="card__text">Tracks documents by provider and status. Alerts when expiring. Maintains audit trails for HIPAA and state licensing.</p>
        </div>

        <!-- Card 6: Referrals -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REFERRALS</span>
          <h3 class="card__title">Referral Tracking & Routing</h3>
          <p class="card__text">Incoming referrals parsed, categorized, and routed to the correct department automatically. End-to-end status tracking.</p>
        </div>
      </div>

      <!-- Use case links -->
      <div class="hc-automate__links animate-on-scroll">
        <p class="text-secondary">Explore specific workflows:</p>
        <div class="hc-automate__link-grid">
          <a href="/use-cases/healthcare-revenue-cycle/" class="hc-automate__link accent-blue glow-subtle-blue">Revenue Cycle Automation &rarr;</a>
          <a href="/use-cases/healthcare-prior-authorization/" class="hc-automate__link accent-blue glow-subtle-blue">Prior Authorization Management &rarr;</a>
          <a href="/use-cases/healthcare-clinical-documentation/" class="hc-automate__link accent-blue glow-subtle-blue">Clinical Documentation AI &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How It Works
       ════════════════════════════════════════ -->
  <section class="section hc-process">
    <div class="container">
      <div class="hc-process__header animate-on-scroll">
        <SectionBadge text="HOW IT WORKS" variant="solution" />
        <h2>Same process. Built for <span class="accent-emerald glow-medium-emerald">healthcare.</span></h2>
      </div>

      <div class="hc-timeline stagger-children">
        <div class="hc-timeline__step">
          <div class="hc-timeline__node">
            <span class="hc-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution hc-timeline__card">
            <h3 class="card__title">Audit</h3>
            <p class="card__text">We map how scheduling happens, how prior auth is tracked, where referrals go, how credentialing is managed. We find the bottlenecks.</p>
          </div>
        </div>

        <div class="hc-timeline__step">
          <div class="hc-timeline__node">
            <span class="hc-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution hc-timeline__card">
            <h3 class="card__title">Build</h3>
            <p class="card__text">Custom workflows integrated with your EHR and billing system. Fewer manual steps, less room for error.</p>
          </div>
        </div>

        <div class="hc-timeline__step">
          <div class="hc-timeline__node">
            <span class="hc-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution hc-timeline__card">
            <h3 class="card__title">Support</h3>
            <p class="card__text">We stay. Monitor performance, fix issues, adjust workflows as your practice grows or payer mix changes. One point of contact.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Results
       ════════════════════════════════════════ -->
  <section class="section hc-results">
    <div class="container">
      <div class="hc-results__header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="info" />
        <h2>What actually <span class="accent-violet glow-medium-violet">changes.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">CLINICIAN TIME</span>
          <p class="card__text">Clinicians get 13+ hours per week back. AI documentation cuts the post-visit grind. More patients seen, less burnout.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">ADMIN EFFICIENCY</span>
          <p class="card__text">Staff handles up to 47% more work. Scheduling, prior auth, referral routing, and credentialing happen automatically.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">REVENUE</span>
          <p class="card__text">End-to-end automation means claims don't slip through. Collection rates improve. Cash flow stabilizes.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">RETENTION</span>
          <p class="card__text">When repetitive work gets automated, morale improves, turnover drops, and you keep experienced people longer.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: Why Constance IT for Healthcare
       ════════════════════════════════════════ -->
  <section class="section hc-why">
    <div class="container">
      <div class="hc-why__header animate-on-scroll">
        <SectionBadge text="WHY US" variant="info" />
        <h2>We know your <span class="accent-violet glow-medium-violet">world.</span></h2>
      </div>

      <div class="hc-why__content animate-on-scroll">
        <p class="text-large text-secondary">Constance IT has been working with healthcare providers since day one. We understand MSO operations, ASC workflows, clinic billing cycles, and the compliance requirements that make healthcare different.</p>
        <p class="text-large text-secondary">We build automations that integrate with your EHR and billing systems. One consistent contact who understands your practice, your challenges, and your growth.</p>
      </div>

      <div class="hc-why__callouts stagger-children">
        <div class="card card--feature hc-why__callout">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 20V6a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v14"/><path d="M2 20h20"/><path d="M14 12v.01"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">HEALTHCARE SOLUTIONS</span>
          <p class="card__text">Visit <a href="https://health.constanceit.com" class="link">health.constanceit.com</a> for healthcare-specific staffing and support.</p>
        </div>
        <div class="card card--feature hc-why__callout">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="M7 7h10"/><path d="M7 12h10"/><path d="M7 17h10"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">MULTI-SERVICE</span>
          <p class="card__text">Beyond AI automation, we offer managed IT and IT infrastructure.</p>
        </div>
        <div class="card card--feature hc-why__callout">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">COMPLIANCE-FIRST</span>
          <p class="card__text">HIPAA, state licensing, CMS interoperability — every automation respects your requirements.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section hc-cta" id="contact-form">
    <div class="hc-cta__glow"></div>
    <div class="container">
      <div class="hc-cta__inner animate-on-scroll">
        <h2 class="hc-cta__headline">Ready to get your team's <span class="accent-blue glow-medium-blue">time</span> back?</h2>
        <p class="hc-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="healthcare" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Healthcare Vertical — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: Stats Strip ── */
  .hc-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-xl) 0;
  }

  .hc-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .hc-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ── Section 3: The Problem ── */
  .hc-problem__header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 4: What We Automate ── */
  .hc-automate__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-automate__header h2 {
    margin-top: var(--space-md);
  }

  .hc-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .hc-automate__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .hc-automate__grid .card__title {
    margin-top: var(--space-sm);
  }

  /* Use case links */
  .hc-automate__links {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .hc-automate__links p {
    margin-bottom: var(--space-md);
    font-size: 0.9375rem;
  }

  .hc-automate__link-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }

  .hc-automate__link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .hc-automate__link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ── Section 5: How It Works (Timeline) ── */
  .hc-process__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-process__header h2 {
    margin-top: var(--space-md);
  }

  .hc-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 700px;
    margin-inline: auto;
    position: relative;
  }

  /* Vertical connecting line */
  .hc-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-emerald), rgba(74, 222, 128, 0.15));
    border-radius: 1px;
  }

  .hc-timeline__step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
  }

  .hc-timeline__node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    border: 2px solid var(--accent-emerald);
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 12px var(--accent-emerald-glow);
  }

  .hc-timeline__number {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }

  .hc-timeline__card {
    flex-grow: 1;
  }

  /* ── Section 6: Results ── */
  .hc-results__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-results__header h2 {
    margin-top: var(--space-md);
  }

  /* ── Section 7: Why Us ── */
  .hc-why__header {
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-lg);
  }

  .hc-why__header h2 {
    margin-top: var(--space-md);
  }

  .hc-why__content {
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .hc-why__content p + p {
    margin-top: var(--space-md);
  }

  .hc-why__callouts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .hc-why__callout .card__icon {
    width: 24px;
    height: 24px;
    margin-bottom: var(--space-sm);
  }

  /* ── Section 8: CTA ── */
  .hc-cta {
    position: relative;
    overflow: hidden;
  }

  .hc-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hc-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .hc-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .hc-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);

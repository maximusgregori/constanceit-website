---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="E-Commerce IT & AI Services" description="AI automation for SMB e-commerce and DTC brands. Automate inventory, customer service, marketing, orders, returns, and reviews so you can focus on growth.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">Your inventory is out of sync. Customer service is killing your <span class="accent-violet glow-heavy-violet">margins.</span></h1>
        <p class="hero__subtitle">Inventory sync, customer service, personalized marketing, order management, returns, and reviews — automated. Compete on what matters: your product and your customers.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">How We Help E-Commerce &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Stats Strip
       ════════════════════════════════════════ -->
  <section class="section ec-stats">
    <div class="container">
      <div class="ec-stats__grid animate-on-scroll">
        <div class="ec-stats__item">
          <span class="stat-number stat-number--emerald">0</span>
          <span class="ec-stats__label">Oversells with synced inventory</span>
        </div>
        <div class="ec-stats__item">
          <span class="stat-number stat-number--emerald">24/7</span>
          <span class="ec-stats__label">Automated customer responses</span>
        </div>
        <div class="ec-stats__item">
          <span class="stat-number stat-number--emerald">3x</span>
          <span class="ec-stats__label">More reviews collected</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Problem
       ════════════════════════════════════════ -->
  <section class="section ec-problem">
    <div class="container">
      <div class="ec-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>You're doing the <span class="accent-coral glow-medium-coral">busywork</span> that big platforms automated years ago.</h2>
        <p class="text-large text-secondary">The margins are thin. Your time is expensive. You can't hire people to send reminder emails and track down reviews.</p>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">INVENTORY</span>
          <p class="card__text">Channels out of sync. Oversells happen. Someone buys on your site while you're listing on Amazon.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">CUSTOMER SERVICE</span>
          <p class="card__text">Every inquiry is a separate email conversation. Each one eats 10 minutes of your time.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">MARKETING</span>
          <p class="card__text">Batch-and-blast email because personalizing at scale would take forever. Generic messages, low engagement.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">SOCIAL PROOF</span>
          <p class="card__text">Nobody's collecting reviews. Your social proof stays weak. Competitors with more reviews get the clicks.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="ec-automate__header animate-on-scroll">
        <SectionBadge text="WHAT WE AUTOMATE" variant="feature" />
        <h2>The work you're doing in your <span class="accent-blue glow-medium-blue">sleep.</span></h2>
      </div>

      <div class="ec-automate__grid stagger-children">
        <!-- Card 1: Inventory -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" x2="12" y1="22" y2="12"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">INVENTORY</span>
          <h3 class="card__title">AI Inventory Agents</h3>
          <p class="card__text">Real-time inventory sync across website, Amazon, Shopify, marketplaces. AI forecasts demand and auto-reorders. Overselling eliminated.</p>
        </div>

        <!-- Card 2: Support -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SUPPORT</span>
          <h3 class="card__title">Autonomous Customer Service Agents</h3>
          <p class="card__text">AI handles inquiries end-to-end: answers questions, processes returns, tracks orders. Complex issues escalated. 24/7 responses.</p>
        </div>

        <!-- Card 3: Orders -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">ORDERS</span>
          <h3 class="card__title">Autonomous Order Processing</h3>
          <p class="card__text">Orders move from checkout to fulfillment with zero human touch. Proactive shipping notifications. Fewer "where's my order" emails.</p>
        </div>

        <!-- Card 4: Marketing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/><path d="M5 3v4"/><path d="M19 17v4"/><path d="M3 5h4"/><path d="M17 19h4"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">MARKETING</span>
          <h3 class="card__title">AI Marketing Personalization</h3>
          <p class="card__text">Personalized email and SMS based on behavior, purchase history, browsing patterns. Abandoned cart recovery, re-engagement campaigns — all automated.</p>
        </div>

        <!-- Card 5: Reviews -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REVIEWS</span>
          <h3 class="card__title">Automated Review Collection</h3>
          <p class="card__text">Requests reviews after delivery at the right time. Posts to Google and major platforms automatically. Social proof builds without manual work.</p>
        </div>

        <!-- Card 6: Sales -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><line x1="19" x2="19" y1="8" y2="14"/><line x1="22" x2="16" y1="11" y2="11"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SALES</span>
          <h3 class="card__title">Sales & Lead Agents</h3>
          <p class="card__text">For B2B e-commerce: AI qualifies inbound leads, answers sales questions, routes hot prospects. No lead falls through.</p>
        </div>
      </div>

      <!-- Use case links -->
      <div class="ec-automate__links animate-on-scroll" style="text-align: center; width: 100%;">
        <p class="text-secondary" style="text-align: center;">Explore specific workflows:</p>
        <div class="ec-automate__link-grid" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;">
          <a href="/use-cases/ecommerce-inventory-sync/" class="ec-automate__link accent-blue glow-subtle-blue">Inventory Sync Automation &rarr;</a>
          <a href="/use-cases/ecommerce-customer-service/" class="ec-automate__link accent-blue glow-subtle-blue">Customer Service Automation &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How It Works
       ════════════════════════════════════════ -->
  <section class="section ec-process">
    <div class="container">
      <div class="ec-process__header animate-on-scroll">
        <SectionBadge text="HOW IT WORKS" variant="solution" />
        <h2>Fast. Built for your <span class="accent-emerald glow-medium-emerald">stack.</span></h2>
      </div>

      <div class="ec-timeline stagger-children">
        <div class="ec-timeline__step">
          <div class="ec-timeline__node">
            <span class="ec-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution ec-timeline__card">
            <h3 class="card__title">Audit</h3>
            <p class="card__text">We find the biggest time sinks in your inventory, customer service, marketing, and order pipeline. Quickest wins first.</p>
          </div>
        </div>

        <div class="ec-timeline__step">
          <div class="ec-timeline__node">
            <span class="ec-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution ec-timeline__card">
            <h3 class="card__title">Build</h3>
            <p class="card__text">Automations integrate with your existing tools — e-commerce platform, payment processor, email, shipping carrier. No rip-and-replace.</p>
          </div>
        </div>

        <div class="ec-timeline__step">
          <div class="ec-timeline__node">
            <span class="ec-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution ec-timeline__card">
            <h3 class="card__title">Support</h3>
            <p class="card__text">We monitor and adjust. New opportunities — seasonal campaigns, new channels — we automate those too. One contact who stays.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Results
       ════════════════════════════════════════ -->
  <section class="section ec-results">
    <div class="container">
      <div class="ec-results__header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="solution" />
        <h2>Breathing room. And better <span class="accent-emerald glow-medium-emerald">numbers.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">TIME SAVED</span>
          <p class="card__text">Manual inventory checks, email triage, marketing setup, returns processing — all automatic. 8–12 hours per week back.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">HAPPIER CUSTOMERS</span>
          <p class="card__text">Timely tracking. Fast responses. Personalized recommendations. Happy customers buy more and refer friends.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">HIGHER LTV</span>
          <p class="card__text">Personalized marketing captures repeat purchases. Abandoned carts recovered. Reviews build social proof. Each customer worth more.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">SMOOTH OPS</span>
          <p class="card__text">Inventory never out of sync. Returns processed without drama. Less firefighting, more growing.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section ec-cta" id="contact-form">
    <div class="ec-cta__glow"></div>
    <div class="container">
      <div class="ec-cta__inner animate-on-scroll">
        <h2 class="ec-cta__headline">Ready to work on your business instead of <span class="accent-blue glow-medium-blue">in it?</span></h2>
        <p class="ec-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="ecommerce" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     E-Commerce Vertical — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: Stats Strip ── */
  .ec-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-xl) 0;
  }

  .ec-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ec-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ── Section 3: The Problem ── */
  .ec-problem__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ec-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 4: What We Automate ── */
  .ec-automate__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ec-automate__header h2 {
    margin-top: var(--space-md);
  }

  .ec-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ec-automate__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .ec-automate__grid .card__title {
    margin-top: var(--space-sm);
  }

  /* Use case links */
  .ec-automate__links {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .ec-automate__links p {
    margin-bottom: var(--space-md);
    font-size: 0.9375rem;
  }

  .ec-automate__link-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
    justify-content: center;
  }

  .ec-automate__link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ec-automate__link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ── Section 5: How It Works (Timeline) ── */
  .ec-process__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ec-process__header h2 {
    margin-top: var(--space-md);
  }

  .ec-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 900px;
    margin-inline: auto;
    position: relative;
  }

  /* Vertical connecting line */
  .ec-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-emerald), rgba(74, 222, 128, 0.15));
    border-radius: 1px;
  }

  .ec-timeline__step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
  }

  .ec-timeline__node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    border: 2px solid var(--accent-emerald);
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 12px var(--accent-emerald-glow);
  }

  .ec-timeline__number {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }

  .ec-timeline__card {
    flex-grow: 1;
  }

  /* ── Section 6: Results ── */
  .ec-results__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ec-results__header h2 {
    margin-top: var(--space-md);
  }

  /* ── Section 7: CTA ── */
  .ec-cta {
    position: relative;
    overflow: hidden;
  }

  .ec-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .ec-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
  }

  .ec-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .ec-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .ec-stats__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ec-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ec-automate__link-grid {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-lg);
    }

    .ec-cta__headline {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .ec-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ec-cta__headline {
      font-size: 2.5rem;
    }
  }
</style>

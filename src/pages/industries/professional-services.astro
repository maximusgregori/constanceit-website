---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTASection from '../../components/CTASection.astro';
---

<BaseLayout title="Professional Services IT & AI" description="AI automation for trades, contractors, and service businesses. Automate scheduling, dispatch, invoicing, lead follow-up, reviews, and estimates. Save 10-15 hours per week.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <span class="section-label">Professional Services</span>
        <h1 class="hero__title">You're doing it all. Admin, sales, scheduling, dispatch, billing. It's killing your business.</h1>
        <p class="hero__subtitle">You're great at your trade. You're not great at running a business — because nobody gave you 30 hours a week to learn. Constance IT automates the stuff that's eating your time: appointment scheduling, dispatch, invoicing, lead follow-up, review requests, and estimate generation.</p>
        <div class="hero__actions">
          <a href="/contact/" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">How We Help Service Businesses</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="ps-problem animate-on-scroll">
        <span class="section-label">The Problem</span>
        <h2>You're drowning in scheduling calls, paperwork, and follow-ups. Nobody's calling you back.</h2>
        <p class="text-large">You spend hours every week on the phone scheduling appointments. Customers call to reschedule and you're not available. Jobs get dispatched via phone call or text — and sometimes the wrong person shows up. Invoices get written manually. Customers don't pay on time because there's no reminder system. Leads come in but don't get followed up with because you were too busy working. Reviews trickle in slowly because you're not asking.</p>
        <p class="text-large">Meanwhile, your crew is sitting in the truck waiting for the next job. Time is bleeding everywhere. You're working 60-hour weeks and somehow still behind on billing.</p>
        <p class="text-large">You can't afford to hire an office manager. You can't afford not to. So instead you do both — the job and the paperwork — and it's crushing you.</p>
        <p class="text-large">The trades are facing a staffing crisis. You need to do more with fewer people, and that means the right automation. Not the flashy kind. The practical kind that saves you 10-15 hours a week.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="ps-automate__header animate-on-scroll">
        <span class="section-label">What We Automate</span>
        <h2>The grunt work that's keeping you from selling and growing.</h2>
      </div>

      <div class="ps-automate__grid stagger-children">
        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <h3 class="card__title">Online Booking & Smart Dispatch</h3>
          <p class="card__text">Customers book appointments 24/7 on your site or via text. AI automatically assigns jobs to the right crew based on location, skills, and availability. Route optimization minimizes drive time and gas costs. No-show rates drop with automatic reminders.</p>
        </div>

        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <h3 class="card__title">Autonomous Lead Management</h3>
          <p class="card__text">Leads from Google, website, ads, phone calls, and referrals are automatically logged and tracked. AI chatbots handle initial questions and qualify leads automatically. Your team talks only to hot, ready-to-book leads.</p>
        </div>

        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="1" y2="3"/><line x1="12" x2="12" y1="21" y2="23"/><line x1="4.22" x2="5.64" y1="4.22" y2="5.64"/><line x1="18.36" x2="19.78" y1="18.36" y2="19.78"/><line x1="1" x2="3" y1="12" y2="12"/><line x1="21" x2="23" y1="12" y2="12"/><line x1="4.22" x2="5.64" y1="19.78" y2="18.36"/><line x1="18.36" x2="19.78" y1="5.64" y2="4.22"/></svg>
          </div>
          <h3 class="card__title">Invoice Automation & Online Payments</h3>
          <p class="card__text">Invoices are generated automatically after each job and sent to customers immediately. Payment reminders go out on a schedule. Online payment options mean customers pay faster. You're not chasing unpaid invoices — they're paid because the system manages collections.</p>
        </div>

        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <h3 class="card__title">Automated Review Requests</h3>
          <p class="card__text">After completing a job, customers automatically get a request for a review on Google, Yelp, or other platforms. Reviews post automatically. More reviews mean more calls coming in. Strong online reputation drives customer acquisition.</p>
        </div>

        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><line x1="12" x2="12" y1="12" y2="18"/><line x1="9" x2="15" y1="15" y2="15"/></svg>
          </div>
          <h3 class="card__title">Automated Estimates & Quotes</h3>
          <p class="card__text">Common jobs have pre-built estimate templates with your pricing baked in. Fill in a few details, and a professional estimate is generated, branded, and sent to the customer automatically. Faster quotes mean faster conversions and higher close rates.</p>
        </div>

        <div class="card ps-automate__card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="18" y1="20" y2="10"/><line x1="12" x2="12" y1="20" y2="4"/><line x1="6" x2="6" y1="20" y2="14"/></svg>
          </div>
          <h3 class="card__title">AI-Powered Revenue Engine</h3>
          <p class="card__text">Marketing automation drives qualified leads. AI sales agents book those leads. Dispatch routes jobs efficiently. Invoices and collections happen automatically. Financial reporting runs without manual data entry. The entire pipeline, coordinated.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: How It Works
       ════════════════════════════════════════ -->
  <section class="section section--alt">
    <div class="container">
      <div class="ps-process animate-on-scroll">
        <span class="section-label">How It Works</span>
        <h2>Simple. Practical. Built for your business.</h2>
        <p class="text-large">We start by watching your business for a week: how calls come in, how you schedule, how you dispatch, how you invoice, how you follow up. We find the obvious stuff that's eating your time and the hidden stuff that's costing you money — missed jobs, unpaid invoices, leads that die.</p>
        <p class="text-large">Then we build automations that integrate with your existing tools — your phone, your email, your accounting software. We're not asking you to learn a new system. We're automating the repetitive work inside the systems you're already using.</p>
        <p class="text-large">After we go live, we stay. We check in monthly. If something isn't working, we fix it. If you grow, we scale it. You have one person to call when you need something. No helpdesk. No waiting.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Results
       ════════════════════════════════════════ -->
  <section class="section">
    <div class="container">
      <div class="ps-results__header animate-on-scroll">
        <span class="section-label">Results</span>
        <h2>Your life gets easier. Your business grows.</h2>
      </div>

      <div class="ps-results__grid stagger-children">
        <div class="card ps-results__card">
          <h3 class="card__title">Back to the Actual Work</h3>
          <p class="card__text">Scheduling calls, typing invoices, chasing unpaid bills, following up with prospects, asking for reviews — all automated. That's 10-15 hours every week you're not spending on admin. You work your trade or you grow the business. Your choice.</p>
        </div>

        <div class="card ps-results__card">
          <h3 class="card__title">No More Forgotten Leads</h3>
          <p class="card__text">Every lead gets a follow-up. Every appointment gets a reminder. Crew gets routed efficiently. Nothing falls through because you forgot. Consistency means predictable revenue.</p>
        </div>

        <div class="card ps-results__card">
          <h3 class="card__title">Cash Flow Improves</h3>
          <p class="card__text">Invoices go out immediately after the job. Payment reminders happen automatically. Customers pay faster because they're reminded and can pay online. You're not waiting 30 days for money.</p>
        </div>

        <div class="card ps-results__card">
          <h3 class="card__title">Margins Stop Getting Eaten</h3>
          <p class="card__text">Route optimization means less gas and driver time wasted. Fewer no-shows means you're not driving to empty appointments. Faster invoicing means money in the bank sooner. Your profit margin gets better because the waste gets eliminated.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: The Reality
       ════════════════════════════════════════ -->
  <section class="section section--alt bg-dots">
    <div class="container">
      <div class="ps-reality animate-on-scroll">
        <span class="section-label">The Reality</span>
        <h2>The trades are adopting AI. Faster than you think.</h2>

        <div class="ps-reality__callouts">
          <div class="ps-reality__callout">
            <div class="ps-reality__callout-stat">
              <span class="ps-reality__callout-number">54%</span>
              <span class="ps-reality__callout-context">of contractors</span>
            </div>
            <p>are willing to invest in AI in the next 1-3 years. 74% cite increased efficiency and productivity as the biggest benefit. HVAC, plumbing, and electrical contractors are early adopters.</p>
          </div>

          <div class="ps-reality__callout">
            <div class="ps-reality__callout-stat">
              <span class="ps-reality__callout-number">41%</span>
              <span class="ps-reality__callout-context">of workforce</span>
            </div>
            <p>in construction and skilled trades is expected to retire by 2031. The people left standing will have to do more with less. That means smarter systems, not more hiring.</p>
          </div>
        </div>

        <p class="text-large ps-reality__followup">Constance IT doesn't sell you cutting-edge AI. We sell you the 10-15 hours per week you get back. That's real money. That's breathing room. That's the difference between burning out and scaling.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 7: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Ready to get your life back?"
    subtext="Let's talk about what's taking the most time right now. Whether that's scheduling, dispatch, invoicing, or lead follow-up, there's automation that'll save you hours every week. No massive project. No learning curve. Just practical automation that works with your business."
    source="professional-services"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Professional Services — scoped styles
     ────────────────────────────────────── */

  /* Problem section */
  .ps-problem {
    max-width: 800px;
    margin-inline: auto;
  }

  .ps-problem h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .ps-problem p {
    color: var(--text-secondary);
  }

  .ps-problem p + p {
    margin-top: var(--space-md);
  }

  /* Automate section */
  .ps-automate__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-automate__header h2 {
    margin-top: var(--space-sm);
  }

  .ps-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ps-automate__card .card__icon {
    margin-bottom: var(--space-md);
  }

  /* Process section */
  .ps-process {
    max-width: 800px;
    margin-inline: auto;
  }

  .ps-process h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-lg);
  }

  .ps-process p {
    color: var(--text-secondary);
  }

  .ps-process p + p {
    margin-top: var(--space-md);
  }

  /* Results section */
  .ps-results__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-results__header h2 {
    margin-top: var(--space-sm);
  }

  .ps-results__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ps-results__card .card__text {
    margin-top: var(--space-sm);
  }

  /* Reality section */
  .ps-reality {
    max-width: 900px;
    margin-inline: auto;
  }

  .ps-reality h2 {
    margin-top: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .ps-reality__callouts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-xl);
  }

  .ps-reality__callout {
    padding: var(--space-lg);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
  }

  .ps-reality__callout-stat {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .ps-reality__callout-number {
    font-family: var(--font-mono);
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--accent-primary-hover);
    line-height: 1;
  }

  .ps-reality__callout-context {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--text-secondary);
    letter-spacing: 0.02em;
  }

  .ps-reality__callout p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
    max-width: 100%;
  }

  .ps-reality__followup {
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (min-width: 768px) {
    .ps-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ps-results__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ps-reality__callouts {
      grid-template-columns: repeat(2, 1fr);
    }

    .ps-reality__callout-number {
      font-size: 3rem;
    }
  }

  @media (min-width: 1024px) {
    .ps-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>

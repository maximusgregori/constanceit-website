---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Professional Services IT & AI" description="AI automation for trades, contractors, and service businesses. Automate scheduling, dispatch, invoicing, lead follow-up, reviews, and estimates so you can focus on your trade.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">You're doing it all. Admin, sales, scheduling, dispatch, billing. It's killing your <span class="accent-violet glow-heavy-violet">margins.</span></h1>
        <p class="hero__subtitle">Scheduling, dispatch, invoicing, lead follow-up, review requests, and estimates — automated. So you can do what you do best and actually make money doing it.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">How We Help Service Businesses &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Stats Strip
       ════════════════════════════════════════ -->
  <section class="section ps-stats">
    <div class="container">
      <div class="ps-stats__grid animate-on-scroll">
        <div class="ps-stats__item">
          <span class="stat-number stat-number--emerald">60%</span>
          <span class="ps-stats__label">Less time on admin</span>
        </div>
        <div class="ps-stats__item">
          <span class="stat-number stat-number--violet">2x</span>
          <span class="ps-stats__label">Faster invoice collection</span>
        </div>
        <div class="ps-stats__item">
          <span class="stat-number stat-number--blue">5 min</span>
          <span class="ps-stats__label">Average lead response time</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Problem
       ════════════════════════════════════════ -->
  <section class="section ps-problem">
    <div class="container">
      <div class="ps-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>You're drowning in <span class="accent-coral glow-medium-coral">busywork</span> that has nothing to do with your trade.</h2>
        <p class="text-large text-secondary">You're working 60-hour weeks and somehow still behind on billing. You can't afford an office manager. You can't afford not to have one.</p>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">SCHEDULING</span>
          <p class="card__text">Hours on the phone booking appointments. Customers call to reschedule and you're not available. No-shows cost you money.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DISPATCH</span>
          <p class="card__text">Jobs dispatched via text or phone call. Wrong person shows up. Crew sits in the truck waiting for the next job.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">INVOICING</span>
          <p class="card__text">Invoices written manually, sent days late. Customers don't pay on time because there's no reminder system. Cash flow suffers.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">LEADS</span>
          <p class="card__text">Leads come in but don't get followed up because you were too busy working. By the time you call back, they've hired someone else.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="ps-automate__header animate-on-scroll">
        <SectionBadge text="WHAT WE AUTOMATE" variant="feature" />
        <h2>The grunt work that's keeping you from selling and <span class="accent-blue glow-medium-blue">growing.</span></h2>
      </div>

      <div class="ps-automate__grid stagger-children">
        <!-- Card 1: Scheduling -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">SCHEDULING</span>
          <h3 class="card__title">Online Booking & Smart Dispatch</h3>
          <p class="card__text">Customers book 24/7 on your site or via text. AI assigns jobs to the right crew based on location, skills, and availability. No-show rates drop with automatic reminders.</p>
        </div>

        <!-- Card 2: Leads -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LEADS</span>
          <h3 class="card__title">Autonomous Lead Management</h3>
          <p class="card__text">Leads from Google, website, ads, and referrals automatically logged and tracked. AI qualifies leads and routes hot prospects. Your team talks only to ready-to-book customers.</p>
        </div>

        <!-- Card 3: Invoicing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">INVOICING</span>
          <h3 class="card__title">Invoice Automation & Online Payments</h3>
          <p class="card__text">Invoices generated after each job and sent immediately. Payment reminders on a schedule. Online payment options mean customers pay faster.</p>
        </div>

        <!-- Card 4: Reviews -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REVIEWS</span>
          <h3 class="card__title">Automated Review Requests</h3>
          <p class="card__text">Customers get a review request after every completed job. Reviews post to Google and Yelp automatically. More reviews mean more calls.</p>
        </div>

        <!-- Card 5: Estimates -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><line x1="12" x2="12" y1="12" y2="18"/><line x1="9" x2="15" y1="15" y2="15"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">ESTIMATES</span>
          <h3 class="card__title">Automated Estimates & Quotes</h3>
          <p class="card__text">Pre-built estimate templates with your pricing. Fill in a few details, professional quote sent automatically. Faster quotes mean faster conversions.</p>
        </div>

        <!-- Card 6: Revenue -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">REVENUE</span>
          <h3 class="card__title">AI-Powered Revenue Engine</h3>
          <p class="card__text">Marketing drives leads. AI books those leads. Dispatch routes jobs. Invoices and collections happen automatically. The entire pipeline — coordinated without manual work.</p>
        </div>
      </div>

      <!-- Use case links -->
      <div class="ps-automate__links animate-on-scroll">
        <p class="text-secondary">Explore specific workflows:</p>
        <div class="ps-automate__link-grid">
          <a href="/use-cases/professional-services-lead-response/" class="ps-automate__link accent-blue glow-subtle-blue">Lead Response & Booking &rarr;</a>
          <a href="/use-cases/professional-services-dispatch-management/" class="ps-automate__link accent-blue glow-subtle-blue">Dispatch & Job Management &rarr;</a>
          <a href="/use-cases/professional-services-invoicing/" class="ps-automate__link accent-blue glow-subtle-blue">Invoicing & Payment Collection &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How It Works
       ════════════════════════════════════════ -->
  <section class="section ps-process">
    <div class="container">
      <div class="ps-process__header animate-on-scroll">
        <SectionBadge text="HOW IT WORKS" variant="solution" />
        <h2>Simple. Practical. Built for your <span class="accent-emerald glow-medium-emerald">business.</span></h2>
      </div>

      <div class="ps-timeline stagger-children">
        <div class="ps-timeline__step">
          <div class="ps-timeline__node">
            <span class="ps-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution ps-timeline__card">
            <h3 class="card__title">Watch</h3>
            <p class="card__text">We spend a week observing how calls come in, how you schedule, how you dispatch, how you invoice. We find where time and money are leaking.</p>
          </div>
        </div>

        <div class="ps-timeline__step">
          <div class="ps-timeline__node">
            <span class="ps-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution ps-timeline__card">
            <h3 class="card__title">Build</h3>
            <p class="card__text">Automations integrate with your existing tools — your phone, your email, your accounting software. No new systems to learn. No rip-and-replace.</p>
          </div>
        </div>

        <div class="ps-timeline__step">
          <div class="ps-timeline__node">
            <span class="ps-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution ps-timeline__card">
            <h3 class="card__title">Support</h3>
            <p class="card__text">We check in monthly. If something isn't working, we fix it. If you grow, we scale it. One person to call — no helpdesk, no waiting.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Results
       ════════════════════════════════════════ -->
  <section class="section ps-results">
    <div class="container">
      <div class="ps-results__header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="info" />
        <h2>Your life gets easier. Your business <span class="accent-violet glow-medium-violet">grows.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">TIME SAVED</span>
          <p class="card__text">Scheduling, invoicing, follow-ups, review requests — all automated. 10–15 hours per week back. Work your trade or grow the business.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">NO MISSED JOBS</span>
          <p class="card__text">Every lead gets a follow-up. Every appointment gets a reminder. Crew gets routed efficiently. Consistency means predictable revenue.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">CASH FLOW</span>
          <p class="card__text">Invoices go out immediately. Payment reminders happen automatically. Customers pay faster because they can pay online.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">BETTER MARGINS</span>
          <p class="card__text">Route optimization means less gas wasted. Fewer no-shows. Faster invoicing means money in the bank sooner. The waste gets eliminated.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: The Trades Are Adopting AI
       ════════════════════════════════════════ -->
  <section class="section ps-reality">
    <div class="container">
      <div class="ps-reality__header animate-on-scroll">
        <SectionBadge text="THE REALITY" variant="amber" />
        <h2>Your competitors are <span class="accent-amber glow-medium-amber">already</span> automating.</h2>
      </div>

      <div class="ps-reality__grid stagger-children">
        <div class="card card--feature ps-reality__card" style="border-left-color: var(--accent-amber);">
          <span class="card__category accent-amber glow-medium-amber">INDUSTRY ADOPTION</span>
          <p class="card__text">54% of contractors are willing to invest in AI in the next 1–3 years. HVAC, plumbing, and electrical contractors are early adopters. 74% cite efficiency as the biggest benefit.</p>
        </div>
        <div class="card card--feature ps-reality__card" style="border-left-color: var(--accent-amber);">
          <span class="card__category accent-amber glow-medium-amber">WORKFORCE REALITY</span>
          <p class="card__text">41% of the skilled trades workforce retires by 2031. The people left will need to do more with less. That means smarter systems, not more hiring.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 8: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section ps-cta" id="contact-form">
    <div class="ps-cta__glow"></div>
    <div class="container">
      <div class="ps-cta__inner animate-on-scroll">
        <h2 class="ps-cta__headline">Ready to get your <span class="accent-blue glow-medium-blue">life</span> back?</h2>
        <p class="ps-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="professional-services" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Professional Services — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: Stats Strip ── */
  .ps-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-xl) 0;
  }

  .ps-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ps-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ── Section 3: The Problem ── */
  .ps-problem__header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 4: What We Automate ── */
  .ps-automate__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-automate__header h2 {
    margin-top: var(--space-md);
  }

  .ps-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .ps-automate__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .ps-automate__grid .card__title {
    margin-top: var(--space-sm);
  }

  /* Use case links */
  .ps-automate__links {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .ps-automate__links p {
    margin-bottom: var(--space-md);
    font-size: 0.9375rem;
  }

  .ps-automate__link-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
  }

  .ps-automate__link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .ps-automate__link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ── Section 5: How It Works (Timeline) ── */
  .ps-process__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-process__header h2 {
    margin-top: var(--space-md);
  }

  .ps-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 700px;
    margin-inline: auto;
    position: relative;
  }

  /* Vertical connecting line */
  .ps-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-emerald), rgba(74, 222, 128, 0.15));
    border-radius: 1px;
  }

  .ps-timeline__step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
  }

  .ps-timeline__node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    border: 2px solid var(--accent-emerald);
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 12px var(--accent-emerald-glow);
  }

  .ps-timeline__number {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }

  .ps-timeline__card {
    flex-grow: 1;
  }

  /* ── Section 6: Results ── */
  .ps-results__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-results__header h2 {
    margin-top: var(--space-md);
  }

  /* ── Section 7: The Reality ── */
  .ps-reality__header {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .ps-reality__header h2 {
    margin-top: var(--space-md);
  }

  .ps-reality__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    max-width: 800px;
    margin-inline: auto;
  }

  /* ── Section 8: CTA ── */
  .ps-cta {
    position: relative;
    overflow: hidden;
  }

  .ps-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .ps-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .ps-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .ps-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .ps-stats__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ps-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ps-automate__link-grid {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-lg);
    }

    .ps-reality__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .ps-cta__headline {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .ps-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .ps-cta__headline {
      font-size: 2.5rem;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Real Estate IT & AI Services" description="AI automation for real estate firms. Automate lead nurturing, tenant communication, document processing, CRM workflows, and property listings. Close deals faster.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <h1 class="hero__title">You're losing deals because leads get <span class="accent-violet glow-heavy-violet">lost.</span></h1>
        <p class="hero__subtitle">Lead nurturing, tenant communication, document processing, and CRM management — automated. Focus on the people, not the paperwork.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#what-we-automate" class="btn btn--ghost">See Our Solutions &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Stats Strip
       ════════════════════════════════════════ -->
  <section class="section re-stats">
    <div class="container">
      <div class="re-stats__grid animate-on-scroll">
        <div class="re-stats__item">
          <span class="stat-number stat-number--emerald">3x</span>
          <span class="re-stats__label">Faster lead response</span>
        </div>
        <div class="re-stats__item">
          <span class="stat-number stat-number--emerald">80%</span>
          <span class="re-stats__label">Fewer missed follow-ups</span>
        </div>
        <div class="re-stats__item">
          <span class="stat-number stat-number--emerald">50%</span>
          <span class="re-stats__label">Less time on document management</span>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Problem
       ════════════════════════════════════════ -->
  <section class="section re-problem">
    <div class="container">
      <div class="re-problem__header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Great leads are <span class="accent-coral glow-medium-coral">disappearing.</span> Documents bottleneck closings. Your CRM is out of sync.</h2>
        <p class="text-large text-secondary">Real estate workflows were designed for people — and they don't scale.</p>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">LOST LEADS</span>
          <p class="card__text">Follow-up is inconsistent. It takes three emails before a lead hears from you. Hot leads go cold.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DOCUMENT CHAOS</span>
          <p class="card__text">Closing documents emailed back and forth. Tracked in multiple places. Held up by missing signatures.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">STALE CRM</span>
          <p class="card__text">Nobody's entering data in real time. Properties listed on some sites but not others. Contact records outdated.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">TENANT GAPS</span>
          <p class="card__text">Rent collection reminders go out manually, if at all. Maintenance requests sit in email threads.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: What We Automate
       ════════════════════════════════════════ -->
  <section class="section" id="what-we-automate">
    <div class="container">
      <div class="re-automate__header animate-on-scroll">
        <SectionBadge text="WHAT WE AUTOMATE" variant="feature" />
        <h2>Every workflow that's <span class="accent-blue glow-medium-blue">slowing you down.</span></h2>
      </div>

      <div class="re-automate__grid stagger-children">
        <!-- Card 1: Leasing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LEASING</span>
          <h3 class="card__title">24/7 AI Leasing Agents</h3>
          <p class="card__text">AI handles prospect inquiries, answers common questions, schedules tours, and qualifies leads automatically. Your team focuses on closing.</p>
        </div>

        <!-- Card 2: Lead Nurturing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">LEAD NURTURING</span>
          <h3 class="card__title">Intelligent Lead Nurturing</h3>
          <p class="card__text">Leads auto-matched to properties. Personalized email sequences for sellers, buyers, investors, renters. AI prioritizes the most likely to convert.</p>
        </div>

        <!-- Card 3: Documents -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="M10 9H8"/><path d="M16 13H8"/><path d="M16 17H8"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">DOCUMENTS</span>
          <h3 class="card__title">Lease & Document Intelligence</h3>
          <p class="card__text">AI extracts key lease terms, dates, and obligations. Closing docs organized, tracked for signatures, flagged if something's missing.</p>
        </div>

        <!-- Card 4: Pricing -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">PRICING</span>
          <h3 class="card__title">Smart Rent Pricing</h3>
          <p class="card__text">AI analyzes market data, comparable properties, and occupancy rates to recommend optimal rental prices. Dynamic pricing adjusts over time.</p>
        </div>

        <!-- Card 5: Maintenance -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">MAINTENANCE</span>
          <h3 class="card__title">Predictive Maintenance</h3>
          <p class="card__text">IoT sensors + AI predict issues before emergencies. Tenant requests auto-categorized, prioritized, and routed to the right contractor.</p>
        </div>

        <!-- Card 6: Collections -->
        <div class="card card--feature">
          <div class="card__icon icon-glow-blue">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
          </div>
          <span class="card__category accent-blue glow-medium-blue">COLLECTIONS</span>
          <h3 class="card__title">Tenant Communication & Collections</h3>
          <p class="card__text">Rent reminders, maintenance updates, lease renewal notices — all automatic. AI tracks collection status and flags late payments.</p>
        </div>
      </div>

      <!-- Use case links -->
      <div class="re-automate__links animate-on-scroll" style="text-align: center; width: 100%;">
        <p class="text-secondary" style="text-align: center;">Explore specific workflows:</p>
        <div class="re-automate__link-grid" style="display: flex; flex-wrap: wrap; justify-content: center; gap: 16px;">
          <a href="/use-cases/real-estate-deal-sourcing/" class="re-automate__link accent-blue glow-subtle-blue">Deal Sourcing & Market Research &rarr;</a>
          <a href="/use-cases/real-estate-tenant-communication/" class="re-automate__link accent-blue glow-subtle-blue">Tenant Communication Automation &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: How It Works
       ════════════════════════════════════════ -->
  <section class="section re-process">
    <div class="container">
      <div class="re-process__header animate-on-scroll">
        <SectionBadge text="HOW IT WORKS" variant="solution" />
        <h2>We've done this before. For teams like <span class="accent-emerald glow-medium-emerald">yours.</span></h2>
      </div>

      <div class="re-timeline stagger-children">
        <div class="re-timeline__step">
          <div class="re-timeline__node">
            <span class="re-timeline__number accent-emerald glow-medium-emerald">01</span>
          </div>
          <div class="card card--solution re-timeline__card">
            <h3 class="card__title">Audit</h3>
            <p class="card__text">We map where leads come in, how follow-up happens, where documents get stuck, how tenant requests are handled.</p>
          </div>
        </div>

        <div class="re-timeline__step">
          <div class="re-timeline__node">
            <span class="re-timeline__number accent-emerald glow-medium-emerald">02</span>
          </div>
          <div class="card card--solution re-timeline__card">
            <h3 class="card__title">Build</h3>
            <p class="card__text">Automations for email sequences, document routing, CRM syncing, listing updates, tenant communication. Your team closes deals.</p>
          </div>
        </div>

        <div class="re-timeline__step">
          <div class="re-timeline__node">
            <span class="re-timeline__number accent-emerald glow-medium-emerald">03</span>
          </div>
          <div class="card card--solution re-timeline__card">
            <h3 class="card__title">Support</h3>
            <p class="card__text">We monitor, adjust as your business grows, and add new automations when you need them. One contact, consistent support.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 6: Results
       ════════════════════════════════════════ -->
  <section class="section re-results">
    <div class="container">
      <div class="re-results__header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="solution" />
        <h2>What changes in <span class="accent-emerald glow-medium-emerald">practice.</span></h2>
      </div>

      <div class="grid grid--2 stagger-children">
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">DEAL SPEED</span>
          <p class="card__text">Leads get consistent follow-up. Documents flow smoothly. Closings move 1–2 weeks faster.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">LEAD CONVERSION</span>
          <p class="card__text">Every inbound lead gets a prompt response. Nurture sequences keep prospects engaged. More leads convert.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">TENANT RETENTION</span>
          <p class="card__text">Maintenance requests answered faster. Rent reminders professional and on time. Happy tenants renew longer.</p>
        </div>
        <div class="card card--solution">
          <span class="card__category accent-emerald glow-medium-emerald">TEAM CAPACITY</span>
          <p class="card__text">Manual follow-ups, document chasing, CRM entry — all automatic. Your team gets 8–12 hours per week back.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 7: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section re-cta" id="contact-form">
    <div class="re-cta__glow"></div>
    <div class="container">
      <div class="re-cta__inner animate-on-scroll">
        <h2 class="re-cta__headline">Ready to work smarter, not just <span class="accent-blue glow-medium-blue">harder?</span></h2>
        <p class="re-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="real-estate" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Real Estate Vertical — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section 2: Stats Strip ── */
  .re-stats__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-xl) 0;
  }

  .re-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .re-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  /* ── Section 3: The Problem ── */
  .re-problem__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .re-problem__header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  /* ── Section 4: What We Automate ── */
  .re-automate__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .re-automate__header h2 {
    margin-top: var(--space-md);
  }

  .re-automate__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  .re-automate__grid .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .re-automate__grid .card__title {
    margin-top: var(--space-sm);
  }

  /* Use case links */
  .re-automate__links {
    margin-top: var(--space-xl);
    text-align: center;
  }

  .re-automate__links p {
    margin-bottom: var(--space-md);
    font-size: 0.9375rem;
  }

  .re-automate__link-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    align-items: center;
    justify-content: center;
  }

  .re-automate__link {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .re-automate__link:hover {
    opacity: 0.8;
    text-decoration: underline;
  }

  /* ── Section 5: How It Works (Timeline) ── */
  .re-process__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .re-process__header h2 {
    margin-top: var(--space-md);
  }

  .re-timeline {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    max-width: 900px;
    margin-inline: auto;
    position: relative;
  }

  /* Vertical connecting line */
  .re-timeline::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--accent-emerald), rgba(74, 222, 128, 0.15));
    border-radius: 1px;
  }

  .re-timeline__step {
    display: flex;
    gap: var(--space-lg);
    align-items: flex-start;
    position: relative;
  }

  .re-timeline__node {
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-deep);
    border: 2px solid var(--accent-emerald);
    border-radius: 50%;
    z-index: 1;
    box-shadow: 0 0 12px var(--accent-emerald-glow);
  }

  .re-timeline__number {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 400;
  }

  .re-timeline__card {
    flex-grow: 1;
  }

  /* ── Section 6: Results ── */
  .re-results__header {
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .re-results__header h2 {
    margin-top: var(--space-md);
  }

  /* ── Section 7: CTA ── */
  .re-cta {
    position: relative;
    overflow: hidden;
  }

  .re-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .re-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
  }

  .re-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .re-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .re-stats__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .re-automate__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .re-automate__link-grid {
      flex-direction: row;
      justify-content: center;
      gap: var(--space-lg);
    }

    .re-cta__headline {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .re-automate__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .re-cta__headline {
      font-size: 2.5rem;
    }
  }
</style>

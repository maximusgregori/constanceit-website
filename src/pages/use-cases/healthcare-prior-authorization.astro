---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Prior Authorization Management" description="Automate prior authorization workflows for healthcare providers. AI-powered status checks, expiration tracking, and auto-resubmission. 40% faster resolution.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <SectionBadge text="HEALTHCARE USE CASE" variant="feature" />
        <h1 class="hero__title">Prior Authorization <span class="accent-violet glow-heavy-violet">Management</span></h1>
        <p class="hero__subtitle">Stop burning coordinator hours on phone holds, fax machines, and payer portals.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#uc-solution" class="btn btn--ghost">See How It Works &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section uc-problem">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Prior auths are a <span class="accent-coral glow-medium-coral">bottleneck</span> that delays care and drains staff.</h2>
        <p class="text-large text-secondary">Checking status with multiple payers, tracking expirations, resubmitting denials — all manual, across phone, fax, and portals.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">STATUS CHECKS</span>
          <p class="card__text">Staff calls payers, sits on hold, logs into portals one by one. A single auth check can take 20–30 minutes. Multiply that by dozens per day.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">EXPIRATIONS</span>
          <p class="card__text">Authorizations expire silently. Nobody tracks the dates until a claim gets denied. Procedures get delayed. Patients reschedule or leave.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">DENIALS</span>
          <p class="card__text">Auth denials require manual appeal — gather documentation, write the letter, resubmit. Weeks pass. Some never get resubmitted.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Solution
       ════════════════════════════════════════ -->
  <section class="section uc-solution" id="uc-solution">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="THE SOLUTION" variant="solution" />
        <h2>Automated status checks, expiration alerts, and <span class="accent-emerald glow-medium-emerald">instant</span> resubmission.</h2>
        <p class="text-large text-secondary">AI monitors every authorization across every payer — checking status, flagging expirations, and resubmitting denials without staff intervention.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          </div>
          <h3 class="card__title">Automated Status Checks</h3>
          <p class="card__text">AI checks payer portals and phone systems automatically. Status updates flow into your workflow in real time. No more hold music.</p>
        </div>
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
          </div>
          <h3 class="card__title">Expiration Alerts</h3>
          <p class="card__text">Every authorization tracked with expiration dates. Staff gets alerts before auths lapse. Procedures stay on schedule. Zero surprises.</p>
        </div>
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          </div>
          <h3 class="card__title">Auto-Resubmission</h3>
          <p class="card__text">Denied auths get corrected and resubmitted automatically. Documentation gathered, appeal letters generated. Staff notified when auths clear.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: Results
       ════════════════════════════════════════ -->
  <section class="section uc-results">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="info" />
      </div>

      <div class="uc-stats animate-on-scroll">
        <div class="uc-stats__item">
          <span class="stat-number stat-number--emerald">40%</span>
          <span class="uc-stats__label">Faster auth resolution</span>
        </div>
        <div class="uc-stats__item">
          <span class="stat-number stat-number--violet">90%+</span>
          <span class="uc-stats__label">Auto-check rate</span>
        </div>
        <div class="uc-stats__item">
          <span class="stat-number stat-number--blue">8 hrs</span>
          <span class="uc-stats__label">Saved per coordinator per week</span>
        </div>
      </div>

      <p class="uc-results__note animate-on-scroll">Typical results based on industry benchmarks. Individual outcomes vary.</p>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section uc-cta" id="contact-form">
    <div class="uc-cta__glow"></div>
    <div class="container">
      <div class="uc-cta__inner animate-on-scroll">
        <h2 class="uc-cta__headline">Ready to take prior auths off your <span class="accent-blue glow-medium-blue">team's</span> plate?</h2>
        <p class="uc-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="healthcare-prior-authorization" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Use Case Page — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section Headers ── */
  .uc-section-header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .uc-section-header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .uc-section-header p {
    margin-bottom: 0;
  }

  /* Reduce gap between badge and stats in results section */
  .uc-results .uc-section-header {
    margin-bottom: var(--space-md);
  }

  /* ── Solution Cards ── */
  .uc-solution .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .uc-solution .card__title {
    margin-top: var(--space-sm);
  }

  /* ── Stats Strip ── */
  .uc-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-lg) 0;
  }

  .uc-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .uc-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .uc-results__note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: var(--space-lg);
    opacity: 0.7;
  }

  /* ── CTA Section ── */
  .uc-cta {
    position: relative;
    overflow: hidden;
  }

  .uc-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .uc-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .uc-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .uc-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .uc-stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .uc-cta__headline {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .uc-cta__headline {
      font-size: 2.5rem;
    }
  }
</style>

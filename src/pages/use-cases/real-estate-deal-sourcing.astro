---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import ContactForm from '../../components/ContactForm.astro';
---

<BaseLayout title="Deal Sourcing & Lead Nurture" description="Automate deal sourcing and lead nurture for real estate. AI-powered lead capture, instant follow-up, and CRM automation. 3x faster response, 80% fewer lost leads.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero">
    <div class="hero__glow hero__glow--violet"></div>
    <div class="hero__glow hero__glow--blue"></div>
    <div class="container">
      <div class="hero__content hero-animate">
        <SectionBadge text="REAL ESTATE USE CASE" variant="feature" />
        <h1 class="hero__title">Deal Sourcing & Lead <span class="accent-violet glow-heavy-violet">Nurture</span></h1>
        <p class="hero__subtitle">Leads come in from everywhere. Follow-up is inconsistent. Hot leads go cold.</p>
        <div class="hero__actions">
          <a href="#contact-form" class="btn btn--primary">Get a Free Assessment</a>
          <a href="#uc-solution" class="btn btn--ghost">See How It Works &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: The Problem
       ════════════════════════════════════════ -->
  <section class="section uc-problem">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="THE PROBLEM" variant="problem" />
        <h2>Your best leads are going <span class="accent-coral glow-medium-coral">cold</span> because nobody followed up.</h2>
        <p class="text-large text-secondary">Web inquiries, referrals, social, listings — leads from a dozen sources, no consistent follow-up, and a CRM full of stale data.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">SLOW RESPONSE</span>
          <p class="card__text">A lead fills out a form at 8 PM. Your team sees it at 9 AM. By then they've contacted three other firms. Speed-to-lead determines who wins.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">INCONSISTENT FOLLOW-UP</span>
          <p class="card__text">Some leads get called back. Some get an email. Some get nothing. There's no system — just whoever remembers. Leads fall through the cracks.</p>
        </div>
        <div class="card card--problem">
          <span class="card__category accent-coral glow-medium-coral">STALE CRM</span>
          <p class="card__text">Contact info outdated. Notes incomplete. Nobody knows where a deal stands. The CRM is a graveyard of missed opportunities.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: The Solution
       ════════════════════════════════════════ -->
  <section class="section uc-solution" id="uc-solution">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="THE SOLUTION" variant="solution" />
        <h2>AI captures every lead and follows up in <span class="accent-emerald glow-medium-emerald">minutes.</span></h2>
        <p class="text-large text-secondary">Automated lead capture from all sources, instant follow-up sequences, lead scoring, and a CRM that stays current without manual entry.</p>
      </div>

      <div class="grid grid--3 stagger-children">
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
          </div>
          <h3 class="card__title">Instant Capture & Response</h3>
          <p class="card__text">Leads from web, social, referrals, and listings captured automatically. First response goes out within minutes — SMS + email. No lead waits until morning.</p>
        </div>
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
          </div>
          <h3 class="card__title">Score & Route</h3>
          <p class="card__text">AI scores leads based on engagement and intent. Hot leads routed to the right agent immediately. Warm leads get automated nurture sequences.</p>
        </div>
        <div class="card card--solution">
          <div class="card__icon icon-glow-emerald">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/></svg>
          </div>
          <h3 class="card__title">CRM Stays Current</h3>
          <p class="card__text">Every interaction logged automatically. Contact info updated. Deal stages tracked. Your CRM reflects reality, not last month's data.</p>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 4: Results
       ════════════════════════════════════════ -->
  <section class="section uc-results">
    <div class="container">
      <div class="uc-section-header animate-on-scroll">
        <SectionBadge text="RESULTS" variant="info" />
      </div>

      <div class="uc-stats animate-on-scroll">
        <div class="uc-stats__item">
          <span class="stat-number stat-number--emerald">3x</span>
          <span class="uc-stats__label">Faster first response</span>
        </div>
        <div class="uc-stats__item">
          <span class="stat-number stat-number--violet">80%</span>
          <span class="uc-stats__label">Fewer lost leads</span>
        </div>
        <div class="uc-stats__item">
          <span class="stat-number stat-number--blue">2x</span>
          <span class="uc-stats__label">More showings booked</span>
        </div>
      </div>

      <p class="uc-results__note animate-on-scroll">Typical results based on industry benchmarks. Individual outcomes vary.</p>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 5: CTA + Contact Form
       ════════════════════════════════════════ -->
  <section class="section uc-cta" id="contact-form">
    <div class="uc-cta__glow"></div>
    <div class="container">
      <div class="uc-cta__inner animate-on-scroll">
        <h2 class="uc-cta__headline">Ready to stop losing deals to slow <span class="accent-blue glow-medium-blue">follow-up?</span></h2>
        <p class="uc-cta__subtext text-secondary">Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time.</p>
        <ContactForm source="real-estate-deal-sourcing" />
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     Use Case Page — Scoped Styles
     ────────────────────────────────────── */

  /* Hero ambient glows */
  .hero__glow--violet {
    position: absolute;
    width: 500px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(181, 178, 255, 0.06) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    top: 10%;
    right: 5%;
  }

  .hero__glow--blue {
    position: absolute;
    width: 400px;
    height: 350px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(55, 147, 255, 0.04) 0%, transparent 70%);
    filter: blur(60px);
    pointer-events: none;
    bottom: 10%;
    left: 15%;
  }

  /* ── Section Headers ── */
  .uc-section-header {
    text-align: center;
    max-width: 700px;
    margin-inline: auto;
    margin-bottom: var(--space-xl);
  }

  .uc-section-header h2 {
    margin-top: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .uc-section-header p {
    margin-bottom: 0;
  }

  /* ── Solution Cards ── */
  .uc-solution .card__icon {
    width: 32px;
    height: 32px;
    margin-bottom: var(--space-md);
  }

  .uc-solution .card__title {
    margin-top: var(--space-sm);
  }

  /* ── Stats Strip ── */
  .uc-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    text-align: center;
    max-width: 900px;
    margin-inline: auto;
    padding: var(--space-lg) 0;
  }

  .uc-stats__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .uc-stats__label {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--text-secondary);
  }

  .uc-results__note {
    text-align: center;
    font-size: 0.8125rem;
    color: var(--text-secondary);
    margin-top: var(--space-lg);
    opacity: 0.7;
  }

  /* ── CTA Section ── */
  .uc-cta {
    position: relative;
    overflow: hidden;
  }

  .uc-cta__glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 400px;
    background: radial-gradient(
      ellipse at center,
      rgba(55, 147, 255, 0.05) 0%,
      rgba(181, 178, 255, 0.03) 40%,
      transparent 70%
    );
    pointer-events: none;
    z-index: 0;
  }

  .uc-cta__inner {
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
  }

  .uc-cta__headline {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .uc-cta__subtext {
    margin-inline: auto;
    margin-bottom: var(--space-xl);
    line-height: 1.7;
  }

  /* ── Responsive ── */
  @media (min-width: 768px) {
    .uc-stats {
      grid-template-columns: repeat(3, 1fr);
    }

    .uc-cta__headline {
      font-size: 2rem;
    }
  }

  @media (min-width: 1024px) {
    .uc-cta__headline {
      font-size: 2.5rem;
    }
  }
</style>

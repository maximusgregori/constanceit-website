---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionBadge from '../../components/SectionBadge.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import CTASection from '../../components/CTASection.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/**
 * Map blog category to CSS class suffix for colored left-borders.
 * AI & Automation → blue, Managed IT → emerald, Infrastructure → amber, Industry News → violet
 */
function getCategoryClass(category: string): string {
  switch (category) {
    case 'AI & Automation': return 'blog-card--ai';
    case 'Managed IT': return 'blog-card--managed-it';
    case 'Infrastructure': return 'blog-card--infrastructure';
    case 'Industry News': return 'blog-card--industry-news';
    default: return 'blog-card--ai';
  }
}
---

<BaseLayout title="Blog" description="Weekly insights on AI automation, IT best practices, and industry trends for small businesses. Practical advice from Constance IT.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero blog-hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate" style="max-width: 650px;">
        <SectionBadge text="BLOG" variant="feature" />
        <h1 class="hero__title" style="margin-top: var(--space-md);">Insights on <span class="accent-violet glow-heavy-violet">AI, IT,</span> and Automation</h1>
        <p class="hero__subtitle">Practical advice for small and medium businesses looking to work smarter with technology. New insights posted every week.</p>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 2: Blog Post Grid
       ════════════════════════════════════════ -->
  <section class="section blog-listing">
    <div class="container">
      {posts.length > 0 ? (
        <div class="blog-grid stagger-children">
          {posts.map((post) => {
            const formattedDate = post.data.date.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            });
            const categoryClass = getCategoryClass(post.data.category);
            return (
              <a href={`/blog/${post.id}/`} class={`blog-card ${categoryClass}`}>
                <span class="blog-card__category">{post.data.category}</span>
                <h2 class="blog-card__title">{post.data.title}</h2>
                <p class="blog-card__excerpt">{post.data.excerpt}</p>
                <div class="blog-card__footer">
                  <time class="blog-card__meta" datetime={post.data.date.toISOString().split('T')[0]}>
                    {formattedDate}
                  </time>
                  <span class="blog-card__read-more">
                    Read More
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  </span>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <p class="text-secondary" style="text-align: center;">No posts yet. Check back soon.</p>
      )}
    </div>
  </section>

  <SectionDivider />

  <!-- ════════════════════════════════════════
       Section 3: CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Have a question? Need help with automation?"
    source="blog"
  />

</BaseLayout>

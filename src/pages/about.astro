---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTASection from '../components/CTASection.astro';
---

<BaseLayout title="About" description="Meet Constance IT — a dependable AI-first IT partner for small businesses. One point of contact, consistent results, no runaround.">

  <!-- ════════════════════════════════════════
       Section 1: Hero
       ════════════════════════════════════════ -->
  <section class="hero about-hero">
    <div class="hero__glow hero__glow--1"></div>
    <div class="hero__glow hero__glow--2"></div>
    <div class="container">
      <div class="hero__content hero-animate" style="max-width: 650px;">
        <h1 class="hero__title">The story behind Constance IT</h1>
        <p class="hero__subtitle">Most IT firms are built to maximize billable hours. Most AI consultants are built to justify their own existence. Constance IT exists to solve a different problem: SMBs shouldn't have to navigate the gap between their tools, their technology, and their growth.</p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 2: Why "Constance"?
       ════════════════════════════════════════ -->
  <section class="section section--alt about-name">
    <div class="container">
      <div class="about-name__inner animate-on-scroll">
        <span class="section-label">The Name</span>
        <h2>Constance means constant. Reliable. Steady.</h2>
        <div class="about-name__body">
          <p class="text-large">An SMB doesn't need a vendor. Doesn't need a consultant who shows up once and disappears. Doesn't need a helpdesk that shuffles you around.</p>
          <p class="text-large">What you need is constant. Someone who's there. Someone who knows your business, your team, your history. Someone you can call and get a straight answer.</p>
          <p class="text-large">That's what the name means. One point of contact. Consistent support. Reliable results.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 3: Our Philosophy
       ════════════════════════════════════════ -->
  <section class="section about-philosophy">
    <div class="container">
      <div class="about-philosophy__header animate-on-scroll">
        <span class="section-label">How We Think</span>
        <h2>Three principles. One approach.</h2>
      </div>

      <div class="grid grid--3 stagger-children" style="margin-top: var(--space-xl);">
        <!-- Card 1: One Point of Contact -->
        <div class="card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><polyline points="16 11 18 13 22 9"/></svg>
          </div>
          <h3 class="card__title">One Person, Full Responsibility</h3>
          <p class="card__text">One person who knows your business, your team, your history. No queues. No transfers. One person who owns the outcome.</p>
        </div>

        <!-- Card 2: Problem-First -->
        <div class="card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
          </div>
          <h3 class="card__title">Problem-First Approach</h3>
          <p class="card__text">We ask what's broken before selling a solution. Sometimes it's AI automation. Sometimes simpler works better. We tell you the truth.</p>
        </div>

        <!-- Card 3: Three Services -->
        <div class="card">
          <div class="card__icon" style="width:32px;height:32px;">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 17.65-9.17 4.16a2 2 0 0 1-1.66 0L2 17.65"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/></svg>
          </div>
          <h3 class="card__title">AI, IT, and Infrastructure</h3>
          <p class="card__text">Three services working together: AI & Automation (eliminate repetitive work), Managed IT (secure infrastructure), IT Infrastructure (systems that scale). Your complete foundation.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 4: Built for SMBs
       ════════════════════════════════════════ -->
  <section class="section section--alt about-smb bg-dots">
    <div class="container">
      <div class="split about-smb__layout">
        <div class="about-smb__text animate-on-scroll">
          <span class="section-label">Our Focus</span>
          <h2>We work with teams our size. On purpose.</h2>
          <p class="text-large">Enterprise IT firms charge for their overhead. AI consultants sell strategy decks to companies with infinite budgets. We work with businesses of 5 to 200 people. Our pricing, process, and communication are built for that.</p>
        </div>

        <div class="about-smb__points stagger-children">
          <div class="about-point">
            <h3 class="about-point__title">No long contracts</h3>
            <p class="about-point__text">You pay for value, not commitments.</p>
          </div>
          <div class="about-point">
            <h3 class="about-point__title">No jargon</h3>
            <p class="about-point__text">Straight answers, no consultant-speak.</p>
          </div>
          <div class="about-point">
            <h3 class="about-point__title">Tools you already have</h3>
            <p class="about-point__text">We integrate with your stack, not replace it.</p>
          </div>
          <div class="about-point">
            <h3 class="about-point__title">Speed over perfection</h3>
            <p class="about-point__text">We ship fast, you see results, we iterate.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 5: Meet Max Gregori
       ════════════════════════════════════════ -->
  <section class="section about-founder">
    <div class="container">
      <div class="split about-founder__layout">
        <div class="about-founder__text animate-on-scroll">
          <span class="section-label">Founder & Principal</span>
          <h2>Built by someone who's been in the room when things break.</h2>
          <p class="text-large">I was born in Germany, lived in South Africa for six years, and eventually made my way to the US where I studied Management and Entrepreneurship at UT Austin.</p>
          <p class="text-large">I've been in the startup and IT space for over eight years now, mostly on the business development side. I co-founded a digital agency at 18, managed 250+ technology projects across 500+ healthcare facilities, and built AI systems that cut operational overhead by 70%. I'm PMP-certified and bilingual in German and English.</p>
          <p class="text-large">I started Constance IT because I kept seeing the same thing: small businesses had access to great tools but nobody sticking around to make sure they actually worked. That's what we do. I'm based in Austin and you'll work with me directly.</p>
        </div>

        <div class="about-founder__photo animate-on-scroll">
          <div class="about-founder__placeholder" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg>
            <span>Max Gregori</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════
       Section 6: Final CTA
       ════════════════════════════════════════ -->
  <CTASection
    headline="Want to see if we're the right fit?"
    subtext="Whether you have a question, need a quote, or just want to learn more about how we work, we're here. We respond within a day, every time."
    source="about"
  />

</BaseLayout>

<style>
  /* ──────────────────────────────────────
     About page scoped styles
     ────────────────────────────────────── */

  /* Hero — full viewport height */
  .about-hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
  }

  /* Why "Constance"? */
  .about-name__inner {
    max-width: 800px;
    margin-inline: auto;
    text-align: center;
  }

  .about-name__inner h2 {
    margin-bottom: var(--space-lg);
  }

  .about-name__body {
    text-align: left;
    border-left: 3px solid var(--accent-primary);
    padding-left: var(--space-lg);
    max-width: 650px;
    margin-inline: auto;
  }

  .about-name__body p {
    color: var(--text-secondary);
  }

  .about-name__body p + p {
    margin-top: var(--space-md);
  }

  /* Philosophy header */
  .about-philosophy__header {
    text-align: center;
    max-width: 600px;
    margin-inline: auto;
  }

  .about-philosophy__header h2 {
    margin-top: var(--space-sm);
  }

  /* SMB section */
  .about-smb__text {
    max-width: 550px;
  }

  .about-smb__text h2 {
    margin-bottom: var(--space-lg);
  }

  .about-smb__text p {
    color: var(--text-secondary);
  }

  .about-smb__points {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .about-point {
    padding: var(--space-lg);
    background-color: var(--bg-subtle);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    transition: border-color 0.2s ease;
  }

  .about-point:hover {
    border-color: var(--border-accent);
  }

  .about-point__title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 500;
    color: var(--accent-primary-hover);
    margin-bottom: var(--space-xs);
  }

  .about-point__text {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  /* Founder section */
  .about-founder__text h2 {
    margin-bottom: var(--space-lg);
  }

  .about-founder__text p {
    color: var(--text-secondary);
  }

  .about-founder__text p + p {
    margin-top: var(--space-md);
  }

  .about-founder__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    width: 100%;
    max-width: 360px;
    aspect-ratio: 3 / 4;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    color: var(--text-secondary);
    margin-inline: auto;
  }

  .about-founder__placeholder svg {
    opacity: 0.4;
  }

  .about-founder__placeholder span {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-secondary);
    opacity: 0.6;
  }

  /* Responsive */
  @media (min-width: 768px) {
    .about-smb__points {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .about-founder__layout {
      gap: var(--space-3xl);
    }

    .about-founder__photo {
      display: flex;
      align-items: center;
      justify-content: center;
    }
  }
</style>
